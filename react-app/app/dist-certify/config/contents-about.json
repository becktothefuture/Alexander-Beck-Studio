    {
      "id": "complexity",
      "label": "Entering complexity",
      "type": "spatial",
      "layout": "center",
      "extentWU": 2.95,
      "mobileExtentWU": 2.6,
      "text": {
        "cues": [
          {
            "id": "complexity-conditions",
            "text": "It has to be useful, original, technically possible and emotionally right.",
            "enter": 0.17,
            "hold": 0.235,
            "exit": 0.3,
            "preset": "travelling-title-v1",
            "motion": {
              "mode": "spatial"
            }
          },
          {
            "id": "complexity-fragmented",
            "text": "Its shape is still fragmented.",
            "enter": 0.34,
            "hold": 0.405,
            "exit": 0.47,
            "preset": "travelling-title-v1",
            "motion": {
              "mode": "spatial"
            }
          },
          {
            "id": "complexity-curiosity",
            "text": "This stage of an idea has always captivated me.",
            "enter": 0.51,
            "hold": 0.575,
            "exit": 0.64,
            "preset": "travelling-title-v1",
            "motion": {
              "mode": "spatial"
            }
          },
          {
            "id": "complexity-listen",
            "text": "I learn what is there and what matters to the people involved.",
            "enter": 0.68,
            "hold": 0.745,
            "exit": 0.81,
            "preset": "travelling-title-v1",
            "motion": {
              "mode": "spatial"
            }
          },
          {
            "id": "complexity-focus",
            "text": "Then I look for the organising thought that can bring it into focus.",
            "enter": 0.85,
            "hold": 0.925,
            "exit": 1,
            "preset": "travelling-title-v1",
            "motion": {
              "mode": "spatial"
            }
