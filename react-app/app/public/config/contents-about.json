          },
          "presentation": {
            "layout": "center"
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "They may begin in one discipline…"
        },
        {
          "id": "text-life-form",
          "kind": "title",
          "startWU": 15.3,
          "focusWU": 15.65,
          "endWU": 16,
          "publishable": true,
          "flow": {
            "minScreens": 0.7,
            "gapAfter": "tight",
            "focusMode": "middle"
          },
          "presentation": {
            "layout": "center"
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "…but they rarely stay there…"
        },
        {
          "id": "text-life-character",
          "kind": "title",
          "startWU": 16.1,
          "focusWU": 16.45,
          "endWU": 16.8,
          "publishable": true,
          "flow": {
            "minScreens": 0.7,
            "gapAfter": "chapter",
            "focusMode": "middle"
          },
          "presentation": {
            "layout": "center"
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "…and I like not knowing exactly where they’ll lead."
        },
        {
          "id": "text-epilogue-invitation",
          "kind": "title",
          "startWU": 20.1,
          "focusWU": 20.65,
          "endWU": 22,
          "publishable": true,
          "flow": {
            "minScreens": 1.4,
            "gapAfter": "none",
            "focusMode": "middle"
          },
          "presentation": {
            "layout": "text-finale-cta"
          },
          "movement": "spatial",
          "preset": "finale-v1",
          "titleStyle": "display",
          "text": "Let’s begin.",
          "description": "If you’re working on something difficult to define, or following a question you can’t leave alone, I’d be curious to hear about it."
        }
      ]
