          "block": {
            "id": "discipline-labels",
            "kind": "disciplines",
            "label": "Disciplines",
            "items": [
              {
                "id": "experience-design",
                "label": "Design Strategy",
                "description": "Understanding the challenge, identifying worthwhile opportunities and helping a team decide where to focus."
              },
              {
                "id": "art-direction",
                "label": "Creative Direction",
                "description": "Giving the work a clear point of view and guiding the people and decisions that shape it."
              },
              {
                "id": "product-design",
                "label": "Product Design",
                "description": "Connecting user needs with business priorities, then developing products that make sense for both."
              },
              {
                "id": "parametric-systems",
                "label": "Brand Identity",
                "description": "Creating a recognisable identity and defining how it comes through in products, services and communications."
              },
              {
                "id": "creative-engineering",
                "label": "Creative Technology",
                "description": "Exploring what code, AI and generative systems can offer, then building working prototypes to test their value."
              },
              {
                "id": "motion-and-3d",
                "label": "Motion & 3D",
                "description": "Using movement, space and timing to explain ideas and give digital experiences character."
              }
            ]
          },
