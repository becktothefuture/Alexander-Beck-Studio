    {
      "id": "disciplines",
      "label": "Six connected disciplines",
      "type": "editorial",
      "layout": "disciplines",
      "extentWU": 3.2,
      "mobileExtentWU": 4,
      "text": {
        "blocks": [
          {
            "id": "disciplines-title",
            "kind": "highlight",
            "text": "Each brings a different way of thinking to the work."
          },
          {
            "id": "disciplines-list",
            "kind": "disciplines",
            "items": [
              "Product Design",
              "Experience Design",
              "Art Direction",
              "Motion & 3D",
              "Creative Engineering",
              "Parametric Systems"
            ]
          },
          {
            "id": "disciplines-practice",
            "kind": "prose",
            "text": "Product Design and Experience Design help me understand an opportunity and shape how an experience works. Art Direction gives it character and a point of view. Motion & 3D make behaviour, space and feeling tangible. Creative Engineering and Parametric Systems let me explore directly through code, tools and working systems."
          },
          {
            "id": "disciplines-ai",
            "kind": "prose",
            "text": "AI runs through all of this as a creative material and a practical capability, expanding what I can explore, generate and build."
          },
          {
            "id": "disciplines-synthesis",
            "kind": "prose",
            "text": "Moving between disciplines lets one kind of thinking affect another. An insight can reshape a product. A technical experiment can unlock a visual language. Motion can make an interaction easier to understand."
          }
        ]
      },
