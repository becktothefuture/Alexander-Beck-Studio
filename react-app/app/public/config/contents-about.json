            "exit": 0.3,
            "preset": "travelling-title-v1"
          },
          {
            "id": "life-form",
            "text": "What was difficult to picture takes on form, behaviour and character.",
            "enter": 0.25,
            "hold": 0.39,
            "exit": 0.53,
            "preset": "travelling-title-v1"
          },
          {
            "id": "life-feel",
            "text": "It becomes something people can understand, interact with and feel.",
            "enter": 0.48,
            "hold": 0.61,
            "exit": 0.75,
            "preset": "travelling-title-v1"
          },
