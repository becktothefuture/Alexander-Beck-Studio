          "titleStyle": "standard",
          "text": "The more complex the questions became…"
        },
        {
          "id": "text-complexity-listen",
          "kind": "title",
          "startWU": 7.665,
          "focusWU": 8.065,
          "endWU": 8.465,
          "publishable": true,
          "presentation": {
            "layout": "center"
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "…the more often I found myself working across disciplines."
        },
        {
          "id": "text-disciplines-title",
          "kind": "scroll-block",
          "startWU": 11.25,
          "focusWU": 11.65,
          "endWU": 16.87,
          "publishable": true,
          "presentation": {
