    "text": {
      "fields": [
        {
          "id": "text-promise-main",
          "kind": "title",
          "startWU": 0,
          "focusWU": 0.4,
          "endWU": 0.8,
          "publishable": true,
          "flow": {
            "minScreens": 0.85,
