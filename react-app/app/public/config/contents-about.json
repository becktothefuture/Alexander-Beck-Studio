          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "No single discipline resolves complexity on its own."
        },
        {
          "id": "text-complexity-listen",
          "kind": "title",
          "startWU": 6.55,
          "focusWU": 6.95,
          "endWU": 7.35,
          "publishable": true,
          "presentation": {
            "layout": "center",
            "viewportY": 50
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "So I move between several."
        },
        {
          "id": "text-disciplines-title",
          "kind": "scroll-block",
          "startWU": 10.5,
          "focusWU": 10.72,
          "endWU": 11.55,
          "publishable": true,
          "presentation": {
            "layout": "disciplines"
          },
          "reveal": {
            "fadeDelayWU": 0.03,
            "fadeDurationWU": 0.16,
            "blurDelayWU": 0,
            "blurDurationWU": 0.24
          },
          "block": {
            "id": "disciplines-passage",
            "kind": "stack",
            "moduleGapRem": 2.25,
            "modules": [
              {
                "id": "attention",
                "kind": "prose",
                "text": "Close attention comes first. I identify the organising idea, then give it a form the team can examine, question, test and develop. That is where useful disagreement begins."
              },
              {
                "id": "ai-judgement",
                "kind": "prose",
                "text": "AI extends what I can explore and make. Its value depends on human judgement and recognising when the result has become generic.",
                "emphasis": [
                  {
                    "text": "AI",
                    "tone": "blue"
                  },
                  {
                    "text": "judgement",
                    "tone": "blue"
                  }
                ]
              },
              {
                "id": "ambitious-teams",
                "kind": "prose",
                "text": "I work with ambitious teams while the problem is still taking shape—especially where design, technology and AI must inform the direction from the outset.",
                "emphasis": [
                  {
                    "text": "design",
                    "tone": "blue"
                  },
                  {
                    "text": "technology",
                    "tone": "blue"
                  },
                  {
                    "text": "AI",
                    "tone": "blue"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "text-life-momentum",
          "kind": "title",
          "startWU": 11.613636,
          "focusWU": 12.013636,
          "endWU": 12.413636,
          "publishable": true,
          "presentation": {
            "layout": "center"
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "When an idea begins to cohere…"
        },
        {
          "id": "text-life-form",
          "kind": "title",
          "startWU": 12.809091,
          "focusWU": 13.209091,
          "endWU": 13.609091,
