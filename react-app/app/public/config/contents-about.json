          "presentation": {
            "layout": "center"
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "…it finds rhythm, character and use…"
        },
        {
          "id": "text-life-character",
          "kind": "title",
          "startWU": 13.65,
          "focusWU": 14.05,
          "endWU": 14.45,
          "publishable": true,
          "presentation": {
            "layout": "center"
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "…and something new emerges."
        },
        {
          "id": "text-epilogue-invitation",
          "kind": "title",
          "startWU": 16.08,
          "focusWU": 16.65,
          "endWU": 17.15,
