        {
          "id": "text-promise-main",
          "stageId": "about.00",
          "kind": "title",
          "startWU": 0,
          "focusWU": 0.425,
          "endWU": 0.85,
          "publishable": true,
          "flow": {
            "minScreens": 2.4,
