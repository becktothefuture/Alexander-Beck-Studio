          "presentation": {
            "layout": "opener"
          },
          "movement": "spatial",
          "preset": "opener-v1",
          "titleStyle": "display",
          "text": "Hi, I’m Alex.",
          "description": "I’m a creative technologist and design director with a background in communication design, grounded in typography, composition and visual language. Today, I apply that foundation to digital products, services and brand experiences, connecting creative strategy with technology and human-centred design."
        },
        {
          "id": "text-background-unit",
          "stageId": "about.01",
          "kind": "scroll-block",
          "startWU": 11.403143,
          "focusWU": 11.983143,
          "endWU": 13.596857,
          "publishable": true,
          "flow": {
            "minScreens": 1.8,
            "gapAfter": "standard",
            "focusMode": "reading-start"
          },
          "presentation": {
            "layout": "reading"
          },
          "block": {
            "id": "background-unit",
            "kind": "stack",
            "modules": [
              {
                "id": "practice",
                "kind": "prose",
                "text": "I work across product design, art direction and design systems, using code, motion, 3D and AI to explore possibilities and develop distinctive experiences. I care about how they work and how they feel to use, with beauty and character playing a part in both."
              },
              {
                "id": "collaboration",
                "kind": "prose",
                "text": "That range helps me connect creative direction with how an experience actually works. It also gives teams something tangible to discuss and test, bringing different perspectives into the process before committing to a direction."
              },
              {
                "id": "making",
                "kind": "prose",
                "text": "Ideas take shape through making, testing and refining."
              }
            ]
          }
        },
        {
          "id": "text-complexity-curiosity",
          "stageId": "about.01",
          "kind": "title",
          "startWU": 16.133333,
          "focusWU": 16.533333,
          "endWU": 16.933333,
          "publishable": true,
          "flow": {
            "minScreens": 0.8,
            "gapAfter": "tight",
            "focusMode": "middle"
          },
          "presentation": {
            "layout": "center"
          },
          "movement": "spatial",
          "preset": "travelling-title-v1",
          "titleStyle": "standard",
          "text": "I follow ideas…"
        },
        {
          "id": "text-complexity-listen",
          "stageId": "about.03",
          "kind": "title",
          "startWU": 18.066666,
          "focusWU": 18.466666,
          "endWU": 18.866666,
          "publishable": true,
