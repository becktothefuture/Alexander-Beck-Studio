ght: 1.35;\n}\n\n.about-narrative-editorial-list li:last-child {\n  border-bottom: 1px solid color-mix(in srgb, var(--text-primary) 16%, transparent);\n}\n\n.about-narrative-editorial-clients {\n  max-width: 48ch;\n  margin: clamp(2.75rem, 5vw, 4.5rem) 0 0;\n  color: var(--text-muted);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.018em;\n  line-height: 1.5;\n}\n\n.about-narrative-client-logos {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  width: min(100%, 52rem);\n  padding: 0;\n  margin: clamp(3.5rem, 7vw, 6rem) 0 0;\n  border-block: 1px solid color-mix(in srgb, var(--text-primary) 16%, transparent);\n  list-style: none;\n}\n\n.about-narrative-client-logos li {\n  display: grid;\n  place-items: center;\n  min-height: clamp(5.5rem, 9vw, 7.5rem);\n  padding: 1rem;\n  color: color-mix(in srgb, var(--text-primary) 78%, transparent);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.035em;\n  line-height: 1.05;\n  text-align: center;\n  text-wrap: balance;\n}\n\n.about-narrative-client-logos li + li {\n  border-inline-start: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);\n}\n\n.about-narrative-client-logos li:nth-child(n + 4) {\n  border-top: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);\n}\n\n.about-narrative-client-logos li:nth-child(4) {\n  border-inline-start: 0;\n}\n\n.about-narrative-client-logos [data-client-logo='sunexpress'] {\n  font-style: italic;\n}\n\n.about-narrative-client-logos [data-client-logo='mccann'] {\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.about-narrative-client-logos [data-client-logo='bentley'] {\n  letter-spacing: 0.08em;\n}\n\n.about-narrative-discipline-list {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  width: min(100%, 38rem);\n  margin: 0 0 clamp(3.5rem, 7vw, 6rem);\n  border-top: 1px solid color-mix(in srgb, var(--text-primary) 18%, transparent);\n}\n\n.about-narrative-discipline-list li {\n  display: grid;\n  grid-template-columns: auto auto minmax(0, 1fr);\n  align-items: center;\n  gap: 0.7rem;\n  min-height: clamp(4.25rem, 7vw, 5.75rem);\n  padding: 0.8rem 1rem 0.8rem 0;\n  border-bottom: 1px solid color-mix(in srgb, var(--text-primary) 18%, transparent);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.03em;\n  line-height: 1.1;\n}\n\n.about-narrative-discipline-list__marker {\n  width: 0.62rem;\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: var(--discipline-color, var(--about-route-accent));\n  box-shadow: 0 0 0 0.22rem color-mix(in srgb, var(--discipline-color, var(--about-route-accent)) 14%, transparent);\n}\n\n.about-narrative-discipline-list__number {\n  color: var(--text-muted);\n  font-family: var(--abs-font-mono);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: 0.02em;\n}\n\n.about-narrative-discipline-list li:nth-child(1) {\n  --discipline-color: var(--ball-1, #b5b7b6);\n}\n\n.about-narrative-discipline-list li:nth-child(2) {\n  --discipline-color: var(--ball-4, #00695c);\n}\n\n.about-narrative-discipline-list li:nth-child(3) {\n  --discipline-color: var(--ball-3, #ffffff);\n}\n\n.about-narrative-discipline-list li:nth-child(4) {\n  --discipline-color: var(--ball-7, #0d5cb6);\n}\n\n.about-narrative-discipline-list li:nth-child(5) {\n  --discipline-color: var(--ball-8, #ffa000);\n}\n\n.about-narrative-discipline-list li:nth-child(6) {\n  --discipline-color: var(--ball-6, #d7ff2f);\n}\n\n.about-narrative-section--disciplines .about-narrative-editorial-title,\n.about-narrative-section--disciplines .about-narrative-editorial-copy {\n  max-width: 48ch;\n  margin-inline: 0;\n  text-align: left;\n}\n\n.about-narrative-inline-study {\n  width: min(100%, 42rem);\n  margin: clamp(4rem, 8vw, 8rem) 0;\n}\n\n.about-narrative-inline-study__field {\n  position: relative;\n  height: clamp(12rem, 28vw, 19rem);\n  overflow: hidden;\n  border-block: 1px solid color-mix(in srgb, var(--text-primary) 14%, transparent);\n}\n\n.about-narrative-inline-study__field span {\n  position: absolute;\n  left: calc(8% + (var(--study-x) * 84%));\n  top: calc(10% + (var(--study-y) * 78%));\n  width: clamp(5px, 0.7vw, 9px);\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: currentColor;\n  opacity: 0.34;\n  transform: translate3d(-50%, -50%, 0);\n  animation: about-attention-study 3.8s ease-in-out var(--study-delay) infinite alternate;\n}\n\n.about-narrative-inline-study__field span:nth-child(7n),\n.about-narrative-inline-study__field span:nth-child(11n) {\n  opacity: 0.92;\n  animation-duration: 2.7s;\n}\n\n.about-narrative-inline-study figcaption {\n  max-width: 42ch;\n  margin-top: 0.8rem;\n  color: var(--text-muted);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  line-height: 1.4;\n}\n\n.about-narrative-editorial-emphasis {\n  color: var(--about-emphasis-blue);\n  font-weight: 650;\n}\n\n.about-narrative-editorial-emphasis[data-emphasis-tone='green'] {\n  color: var(--about-emphasis-green);\n}\n\n.about-narrative-editorial-emphasis[data-emphasis-tone='orange'] {\n  color: var(--about-emphasis-orange);\n}\n\n@keyframes about-attention-study {\n  0% {\n    translate: 0 0;\n  }\n\n  100% {\n    translate: var(--study-dx) var(--study-dy);\n  }\n}\n\n.about-narrative-finale-stage {\n  padding: 0 clamp(1rem, 5vw, 5rem);\n}\n\n.about-narrative-finale-copy {\n  display: grid;\n  place-items: center;\n  height: 100%;\n}\n\n.about-narrative-finale-copy .about-narrative-spatial-title {\n  width: 100%;\n}\n\n.about-narrative-bust-interaction {\n  position: absolute;\n  z-index: 2;\n  top: 24%;\n  left: 50%;\n  width: min(58vw, 38rem);\n  height: 48%;\n  border: 0;\n  background: transparent;\n  cursor: grab;\n  outline: none;\n  pointer-events: none;\n  touch-action: pan-y;\n  transform: translateX(-50%);\n}\n\n.about-narrative-bust-interaction[data-active='true'] {\n  pointer-events: auto;\n}\n\n.about-narrative-bust-interaction:active {\n  cursor: grabbing;\n}\n\n.about-narrative-bust-interaction:focus-visible {\n  outline: 1px solid color-mix(in srgb, var(--text-primary) 55%, transparent);\n  outline-offset: 0.35rem;\n  border-radius: 50%;\n}\n\n.about-narrative-finale-cta {\n  position: absolute;\n  left: 50%;\n  bottom: clamp(5.75rem, 11cqh, 7rem);\n  display: grid;\n  grid-template-areas:\n    'profile actions'\n    'statement actions';\n  grid-template-columns: minmax(16rem, 24rem) auto;\n  align-items: end;\n  justify-content: space-between;\n  width: min(calc(100% - 6rem), 72rem);\n  opacity: var(--spatial-context-opacity, 0);\n  text-align: left;\n  transform: translate3d(-50%, var(--spatial-context-y, 16px), 0);\n  will-change: opacity, transform;\n}\n\n.about-narrative-finale-profile {\n  grid-area: profile;\n  margin: 0;\n  font-size: clamp(1.1rem, 1.75vw, 1.65rem);\n  font-weight: 550;\n  letter-spacing: -0.035em;\n  line-height: 1.12;\n  text-wrap: balance;\n}\n\n.about-narrative-finale-statement {\n  grid-area: statement;\n  max-width: 34ch;\n  margin: 0.55rem 0 0;\n  color: var(--text-muted);\n  font-size: clamp(0.95rem, 1.2vw, 1.08rem);\n  line-height: 1.4;\n}\n\n.about-narrative-cta {\n  display: flex;\n  justify-content: center;\n  gap: 0.65rem;\n  margin-top: clamp(1.5rem, 3vw, 2.4rem);\n}\n\n.about-narrative-finale-cta .about-narrative-cta {\n  grid-area: actions;\n  justify-content: flex-end;\n  margin: 0;\n}\n\n.about-narrative-finale-cta.is-actions-only {\n  display: flex;\n  justify-content: center;\n  width: min(calc(100% - 2rem), 32rem);\n}\n\n.about-narrative-finale-cta.is-actions-only .about-narrative-cta {\n  justify-content: center;\n}\n\n.about-narrative-cta--editorial {\n  justify-content: flex-start;\n  margin-top: clamp(1.5rem, 3vw, 2.5rem);\n}\n\n.about-narrative-cta a,\n.about-narrative-controls__launcher {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 2.75rem;\n  padding: 0.72rem 1rem;\n  border: 1px solid color-mix(in srgb, var(--text-primary) 22%, transparent);\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--studio-window-bg) 76%, transparent);\n  color: var(--text-primary);\n  font-family: var(--abs-font-mono);\n  font-size: 0.75rem;\n  font-weight: 500;\n  line-height: 1;\n  text-decoration: none;\n  backdrop-filter: blur(14px);\n  transition: background 160ms ease, color 160ms ease, border-color 160ms ease;\n}\n\n.about-narrative-cta a:hover,\n.about-narrative-cta a:focus-visible,\n.about-narrative-controls__launcher:hover,\n.about-narrative-controls__launcher:focus-visible {\n  border-color: color-mix(in srgb, var(--text-primary) 48%, transparent);\n  background: color-mix(in srgb, var(--text-primary) 12%, var(--studio-window-bg));\n  outline: none;\n}\n\n.about-narrative-indicator-layer {\n  position: absolute;\n  z-index: 5;\n  top: var(--safari-tint-inset-y, var(--safari-tint-inset));\n  right: var(--safari-tint-inset-x, var(--safari-tint-inset));\n  bottom: 0;\n  left: var(--safari-tint-inset-x, var(--safari-tint-inset));\n  pointer-events: none;\n}\n\n.about-narrative-indicator {\n  /* Portaled into a studio-window-sized UI layer above the contrast veil. */\n  position: absolute;\n  z-index: 5;\n  top: 50%;\n  left: clamp(10px, 1vw, 14px);\n  display: grid;\n  gap: var(--abs-indicator-line-gap, 9px);\n  pointer-events: none;\n  transform: translateY(calc(-50% + 0.5px));\n}\n\n.about-narrative-indicator__line {\n  display: block;\n  width: var(--abs-indicator-line-width, 8px);\n  height: var(--abs-indicator-line-thickness, 3px);\n  border-radius: 999px;\n  background: var(--abs-indicator-ink, rgb(var(--abs-rgb-black)));\n  opacity: var(--abs-indicator-rest-opacity, 0.22);\n  transition: opacity 140ms ease-out;\n}\n\n.about-narrative-indicator__line.is-active {\n  opacity: 1;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .about-narrative-indicator__line {\n    transition: none;\n  }\n}\n\n.about-narrative-controls {\n  position: fixed;\n  z-index: 204;\n  top: calc(var(--safari-tint-inset-y, var(--safari-tint-inset, 0px)) + clamp(0.75rem, 2vw, 1.25rem));\n  left: calc(var(--safari-tint-inset-x, var(--safari-tint-inset, 0px)) + clamp(0.75rem, 2vw, 1.25rem));\n  pointer-events: auto;\n}\n\n.about-narrative-controls__launcher {\n  gap: 0.45rem;\n  min-height: 2.25rem;\n  padding: 0.52rem 0.72rem;\n  cursor: pointer;\n}\n\n.parameterizer-panel {\n  --parameterizer-width: 288px;\n  --parameterizer-header-height: 32px;\n  --parameterizer-folder-height: 28px;\n  --parameterizer-row-height: 28px;\n  display: flex;\n  flex-direction: column;\n  width: var(--parameterizer-width);\n  max-height: min(72svh, 560px);\n  overflow: hidden;\n  border: 1px solid #2d3036;\n  border-radius: 5px;\n  background: #191a1d;\n  color: #eceff3;\n  box-shadow: 0 14px 38px rgba(0, 0, 0, 0.34);\n  font-family: var(--abs-font-sans);\n  font-size: 11px;\n  line-height: 1;\n}\n\n.parameterizer-header {\n  display: flex;\n  flex: 0 0 var(--parameterizer-header-height);\n  align-items: center;\n  justify-content: space-between;\n  height: var(--parameterizer-header-height);\n  padding-inline: 9px 4px;\n  background: #111215;\n  font-weight: 600;\n}\n\n.parameterizer-header button,\n.parameterizer-actions button {\n  border: 0;\n  border-radius: 2px;\n  background: #2a2d33;\n  color: #eceff3;\n  cursor: pointer;\n}\n\n.parameterizer-header button {\n  display: grid;\n  place-items: center;\n  width: 24px;\n  height: 24px;\n  padding: 0;\n}\n\n.parameterizer-scroll {\n  min-height: 0;\n  overflow-x: hidden;\n  overflow-y: auto;\n  scrollbar-width: thin;\n  scrollbar-color: #3f4652 #191a1d;\n}\n\n.parameterizer-folder {\n  border-top: 1px solid #2d3036;\n}\n\n.parameterizer-folder-title {\n  display: flex;\n  align-items: center;\n  height: var(--parameterizer-folder-height);\n  padding: 0 8px;\n  background: #222429;\n  font-weight: 600;\n  cursor: pointer;\n  list-style: none;\n}\n\n.parameterizer-folder-title::-webkit-details-marker {\n  display: none;\n}\n\n.parameterizer-folder-title::before {\n  content: '›';\n  width: 12px;\n  color: #8d939c;\n  transform: rotate(0deg);\n}\n\n.parameterizer-folder[open] .parameterizer-folder-title::before {\n  transform: rotate(90deg);\n}\n\n.parameterizer-row {\n  display: grid;\n  grid-template-columns: minmax(0, 42%) minmax(0, 58%);\n  align-items: center;\n  height: var(--parameterizer-row-height);\n  padding: 0 7px;\n  background: #191a1d;\n  border-top: 1px solid rgba(45, 48, 54, 0.55);\n}\n\n.parameterizer-row:hover {\n  background: #202228;\n}\n\n.parameterizer-label {\n  overflow: hidden;\n  color: #c9cdd3;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.parameterizer-control {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 48px;\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n}\n\n.parameterizer-control input[type='range'] {\n  width: 100%;\n  min-width: 0;\n  accent-color: #5db7ff;\n}\n\n.parameterizer-value {\n  overflow: hidden;\n  color: #5db7ff;\n  font-family: var(--abs-font-mono);\n  font-variant-numeric: tabular-nums;\n  text-align: right;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.parameterizer-actions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 4px;\n  flex: 0 0 auto;\n  padding: 5px;\n  border-top: 1px solid #2d3036;\n  background: #111215;\n}\n\n.parameterizer-actions button {\n  min-height: 28px;\n  padding: 0 8px;\n  font: inherit;\n}\n\n.parameterizer-header button:hover,\n.parameterizer-header button:focus-visible,\n.parameterizer-actions button:hover,\n.parameterizer-actions button:focus-visible {\n  background: #3f4652;\n  outline: 1px solid #5db7ff;\n  outline-offset: -1px;\n}\n\n@media (max-width: 760px) {\n  .about-narrative-vertical-title,\n  .about-narrative-spatial-title {\n    font-size: clamp(2.25rem, 11vw, 4.5rem);\n    line-height: 0.98;\n  }\n\n}\n\n@media (min-width: 601px) and (max-height: 760px) {\n  .about-narrative-spatial-stage {\n    padding-block: 4.75rem;\n  }\n\n  .about-narrative-spatial-title {\n    font-size: clamp(2.2rem, min(5.5vw, 9vh), 5rem);\n  }\n\n  .about-narrative-vertical-title {\n    font-size: clamp(2.2rem, min(5.5vw, 9vh), 5rem);\n  }\n}\n\n@media (max-width: 600px) {\n  .about-narrative-section--spatial {\n    height: calc(var(--section-duration-mobile-wu, var(--section-duration-wu, 1.75)) * var(--narrative-viewport-height, 100cqh));\n  }\n\n  .about-narrative-section--opening,\n  .about-narrative-section--editorial {\n    min-height: calc(var(--section-duration-mobile-wu, var(--section-duration-wu, 1)) * var(--narrative-viewport-height, 100cqh));\n  }\n\n  .about-narrative-discipline-reveal li {\n    transform: translate3d(min(var(--discipline-label-offset, 18px), 10px), -50%, 0);\n    max-width: min(11rem, calc(100% - var(--discipline-x) - 0.5rem));\n    font-size: clamp(0.76rem, 3.2vw, 0.9rem);\n  }\n\n  .about-narrative-spatial-stage {\n    padding: 5.75rem 1rem;\n  }\n\n  .about-narrative-vertical-title {\n    top: var(--vertical-cue-top-mobile, var(--vertical-cue-top, 50%));\n  }\n\n  .about-narrative-vertical-title.is-opener {\n    top: calc(var(--vertical-cue-top-mobile, var(--vertical-cue-top, 50%)) + 3cqh);\n  }\n\n  .about-narrative-finale-cta {\n    bottom: 5.75rem;\n    grid-template-areas:\n      'profile'\n      'statement'\n      'actions';\n    grid-template-columns: 1fr;\n    justify-items: center;\n    width: calc(100% - 2rem);\n    text-align: center;\n  }\n\n  .about-narrative-finale-profile {\n    max-width: 22ch;\n    font-size: clamp(1rem, 5.2vw, 1.3rem);\n  }\n\n  .about-narrative-finale-statement {\n    max-width: 28ch;\n    margin-inline: auto;\n  }\n\n  .about-narrative-finale-cta .about-narrative-cta {\n    justify-content: center;\n    margin-top: 1rem;\n  }\n\n  .about-narrative-bust-interaction {\n    top: 23%;\n    width: min(82vw, 28rem);\n    height: 49%;\n  }\n\n  .about-narrative-section--editorial {\n    padding: 6.5rem 1rem 7.5rem;\n  }\n\n  .about-narrative-editorial-copy {\n    max-width: 32ch;\n    font-size: var(--about-editorial-type-size);\n    line-height: 1.5;\n  }\n\n  .about-narrative-editorial-title {\n    max-width: 32ch;\n    margin-bottom: 2.75rem;\n    font-size: var(--about-editorial-type-size);\n  }\n\n  .about-narrative-client-logos {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .about-narrative-client-logos li:nth-child(n) {\n    border-top: 0;\n    border-inline-start: 0;\n  }\n\n  .about-narrative-client-logos li:nth-child(even) {\n    border-inline-start: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);\n  }\n\n  .about-narrative-client-logos li:nth-child(n + 3) {\n    border-top: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);\n  }\n\n  .about-narrative-discipline-list {\n    grid-template-columns: 1fr;\n    margin-bottom: 4.5rem;\n  }\n\n  .about-narrative-discipline-list li:nth-child(odd),\n  .about-narrative-discipline-list li:nth-child(even) {\n    padding-inline: 0;\n    border-inline-start: 0;\n  }\n\n  .about-narrative-section--disciplines .about-narrative-editorial-copy {\n    margin-inline-start: 0;\n  }\n\n  .about-narrative-editorial-detail {\n    font-size: var(--about-editorial-type-size);\n  }\n\n  .about-narrative-controls {\n    top: auto;\n    right: calc(var(--safari-tint-inset-x, var(--safari-tint-inset, 0px)) + 0.75rem);\n    bottom: calc(var(--shell-bottom-band-height) + var(--abs-safe-bottom) + 0.75rem);\n    left: calc(var(--safari-tint-inset-x, var(--safari-tint-inset, 0px)) + 0.75rem);\n  }\n\n  .about-narrative-controls__launcher {\n    margin-inline-start: auto;\n  }\n\n  .about-narrative-controls.is-open {\n    display: flex;\n    justify-content: center;\n  }\n\n  .parameterizer-panel {\n    --parameterizer-width: min(100%, 420px);\n    --parameterizer-row-height: 36px;\n    width: var(--parameterizer-width);\n    max-height: min(62svh, 560px);\n    font-size: 13px;\n  }\n\n  .parameterizer-control input,\n  .parameterizer-actions button {\n    font-size: 16px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .about-narrative-world__canvas {\n    opacity: 0.28;\n  }\n\n  .about-narrative-spatial-copy,\n  .about-narrative-spatial-fragment,\n  [data-editorial-line],\n  .about-narrative-cta a,\n  .about-narrative-controls__launcher {\n    transition: none;\n  }\n\n  .about-narrative-section--spatial,\n  .about-narrative-section--opening {\n    height: auto;\n    min-height: 100cqh;\n  }\n\n  .about-narrative-spatial-stage {\n    position: relative;\n    height: auto;\n    min-height: 100cqh;\n    overflow: visible;\n  }\n\n  .about-narrative-spatial-copy,\n  [data-editorial-line] {\n    opacity: 1;\n    filter: none;\n    transform: none;\n  }\n\n  .about-narrative-opening-scroll-cue {\n    animation: none;\n  }\n\n  .about-narrative-spatial-title {\n    display: block;\n  }\n\n  .about-narrative-vertical-sequence {\n    position: relative;\n    inset: auto;\n    display: grid;\n    place-items: center;\n    min-height: 100cqh;\n  }\n\n  .about-narrative-vertical-title,\n  .about-narrative-vertical-title.is-opener {\n    position: relative;\n    top: auto;\n    left: auto;\n    opacity: 1;\n    filter: none;\n    transform: none;\n  }\n\n  .about-narrative-section--spatial:not(.about-narrative-section--finale) .about-narrative-spatial-title {\n    font-size: clamp(1.75rem, 6.5vw, 3.6rem);\n    line-height: 1.05;\n  }\n\n  .about-narrative-spatial-fragment {\n    display: block;\n    max-width: none;\n    opacity: 1;\n    filter: none;\n    transform: none;\n  }\n\n  .about-narrative-spatial-fragment + .about-narrative-spatial-fragment {\n    margin-top: 0.5em;\n  }\n\n  .about-narrative-cta {\n    opacity: 1;\n    transform: none;\n  }\n\n  .about-narrative-inline-study__field span {\n    animation: none;\n  }\n\n  .about-narrative-finale-cta {\n    opacity: 1;\n    transform: translateX(-50%);\n  }\n}\n"],["STYLE",{},".contact-route {\n  isolation: isolate;\n  overflow: hidden;\n}\n\n#simulations .contact-ripple-stage {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  overflow: hidden;\n  pointer-events: none;\n  contain: strict;\n}\n\n#simulations .contact-ripple-canvas {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background: transparent;\n  pointer-events: none;\n}\n\n.contact-route__inner {\n  position: relative;\n  z-index: 1;\n}\n\n.contact-route .route-centered-page__description {\n  max-width: 50.4ch;\n  line-height: 1.485;\n  text-wrap: balance;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  #simulations .contact-ripple-canvas {\n    transform: none;\n  }\n}\n"],["STYLE",{},"html.simulation-dashboard-document {\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: auto;\n  width: 100%;\n  height: auto;\n  min-height: 100%;\n  background: #0c0d0e;\n  cursor: auto;\n}\n\nhtml.simulation-dashboard-document body.body.simulation-dashboard-page,\nhtml.simulation-dashboard-document body.simulation-dashboard-page {\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: auto;\n  width: 100%;\n  height: auto;\n  min-height: 100dvh;\n  margin: 0;\n  padding: 0;\n  background: #0c0d0e;\n  color: #f4f1ea;\n  cursor: auto;\n  user-select: text;\n  touch-action: auto;\n}\n\nhtml.simulation-dashboard-document #root {\n  width: 100%;\n  height: auto;\n  min-height: 100dvh;\n  background: #0c0d0e;\n}\n\n.simulation-dashboard,\n.simulation-dashboard *,\n.simulation-dashboard *::before,\n.simulation-dashboard *::after {\n  box-sizing: border-box;\n}\n\n.simulation-dashboard {\n  --dashboard-bg: #0c0d0e;\n  --dashboard-panel: #151719;\n  --dashboard-panel-strong: #1c2023;\n  --dashboard-panel-soft: #101214;\n  --dashboard-line: rgba(244, 241, 234, 0.12);\n  --dashboard-line-strong: rgba(244, 241, 234, 0.2);\n  --dashboard-text: #f4f1ea;\n  --dashboard-muted: rgba(244, 241, 234, 0.68);\n  --dashboard-faint: rgba(244, 241, 234, 0.44);\n  --dashboard-green: #72ce82;\n  --dashboard-blue: #8cafee;\n  --dashboard-amber: #e3b866;\n  --dashboard-red: #ed7b73;\n  --dashboard-radius: 8px;\n  --dashboard-radius-sm: 6px;\n  --dashboard-font-sans: \"Geist\", ui-sans-serif, system-ui, sans-serif;\n  --dashboard-font-mono: \"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace;\n  display: grid;\n  align-content: start;\n  gap: 14px;\n  width: min(100%, 1480px);\n  min-height: 100dvh;\n  margin: 0 auto;\n  padding: 18px;\n  background: var(--dashboard-bg);\n  color: var(--dashboard-text);\n  font-family: var(--dashboard-font-sans);\n  font-size: 14px;\n  line-height: 1.4;\n  letter-spacing: 0;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: geometricPrecision;\n}\n\n.simulation-dashboard :focus-visible {\n  outline: 2px solid rgba(244, 241, 234, 0.72);\n  outline-offset: 2px;\n}\n\n.simulation-dashboard a {\n  color: inherit;\n  text-decoration: none;\n}\n\n.simulation-dashboard button,\n.simulation-dashboard input,\n.simulation-dashboard textarea,\n.simulation-dashboard select {\n  font: inherit;\n  letter-spacing: 0;\n}\n\n.simulation-dashboard button {\n  cursor: pointer;\n}\n\n.simulation-dashboard svg {\n  flex: 0 0 auto;\n}\n\n.simulation-dashboard [data-tooltip] {\n  position: relative;\n}\n\n.simulation-dashboard [data-tooltip]::after {\n  position: absolute;\n  left: 50%;\n  bottom: calc(100% + 8px);\n  z-index: 100;\n  width: max-content;\n  max-width: min(15rem, calc(100vw - 24px));\n  border: 1px solid var(--dashboard-line-strong);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 7px 9px;\n  background: #f4f1ea;\n  color: #111315;\n  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.32);\n  content: attr(data-tooltip);\n  font-family: var(--dashboard-font-sans);\n  font-size: 0.72rem;\n  font-weight: 700;\n  line-height: 1.18;\n  opacity: 0;\n  pointer-events: none;\n  text-align: center;\n  transform: translateX(-50%) translateY(3px);\n  transition:\n    opacity 120ms ease,\n    transform 120ms ease;\n  white-space: normal;\n  overflow-wrap: anywhere;\n}\n\n.simulation-dashboard [data-tooltip]:hover::after,\n.simulation-dashboard [data-tooltip]:focus-visible::after {\n  opacity: 1;\n  transform: translateX(-50%) translateY(0);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--below::after {\n  top: calc(100% + 8px);\n  bottom: auto;\n  transform: translateX(-50%) translateY(-3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--below:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below:focus-visible::after {\n  transform: translateX(-50%) translateY(0);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--above-start::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-start::after {\n  left: 0;\n  right: auto;\n  text-align: left;\n  transform: translateY(3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--below-start::after {\n  top: calc(100% + 8px);\n  bottom: auto;\n  transform: translateY(-3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--above-end::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-end::after {\n  left: auto;\n  right: 0;\n  text-align: right;\n  transform: translateY(3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--below-end::after {\n  top: calc(100% + 8px);\n  bottom: auto;\n  transform: translateY(-3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--above-start:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--above-start:focus-visible::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-start:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-start:focus-visible::after,\n.simulation-dashboard .simulation-dashboard-tooltip--above-end:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--above-end:focus-visible::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-end:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-end:focus-visible::after {\n  transform: translateY(0);\n}\n\n.simulation-dashboard-header {\n  position: sticky;\n  top: 0;\n  z-index: 30;\n  display: grid;\n  grid-template-columns: minmax(18rem, 1fr) auto auto;\n  align-items: center;\n  gap: 16px;\n  border-bottom: 1px solid var(--dashboard-line);\n  padding: 0 0 14px;\n  background: rgba(12, 13, 14, 0.94);\n  backdrop-filter: blur(18px);\n}\n\n.simulation-dashboard-header__title {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 0;\n}\n\n.simulation-dashboard-header__title h1 {\n  margin: 0;\n  color: var(--dashboard-text);\n  font-size: 1.05rem;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.simulation-dashboard-header__title > span,\n.simulation-dashboard-modal__eyebrow {\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 3px 7px;\n  color: var(--dashboard-muted);\n  background: rgba(244, 241, 234, 0.045);\n  font-size: 0.68rem;\n  font-weight: 700;\n  line-height: 1;\n  text-transform: uppercase;\n}\n\n.simulation-dashboard-modal__eyebrow.is-blocked {\n  border-color: rgba(255, 120, 110, 0.34);\n  color: #ffc9c4;\n  background: rgba(255, 120, 110, 0.12);\n}\n\n.simulation-dashboard-header__title p,\n.simulation-dashboard-header__status,\n.simulation-dashboard-summary__item span,\n.simulation-dashboard-summary__item p,\n.simulation-dashboard-list-panel__bar span,\n.simulation-dashboard-list-row__title span,\n.simulation-dashboard-list-row__meta,\n.simulation-dashboard-detail-row dt,\n.simulation-dashboard-section h3,\n.simulation-dashboard-modal__header p,\n.simulation-dashboard-modal label span,\n.simulation-dashboard-delete-modal__plan span {\n  margin: 0;\n  color: var(--dashboard-muted);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.72rem;\n  line-height: 1.25;\n}\n\n.simulation-dashboard-header__status {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  white-space: nowrap;\n}\n\n.simulation-dashboard-header__status svg {\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-header__actions,\n.simulation-dashboard-expanded__links,\n.simulation-dashboard-modal__actions,\n.simulation-dashboard-modal__actions > div {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.simulation-dashboard-button,\n.simulation-dashboard-icon-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 34px;\n  border: 1px solid var(--dashboard-line-strong);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 8px 12px;\n  background: var(--dashboard-panel-soft);\n  color: var(--dashboard-text);\n  font-size: 0.82rem;\n  font-weight: 700;\n  line-height: 1;\n  transition:\n    border-color 120ms ease,\n    background-color 120ms ease,\n    color 120ms ease,\n    transform 120ms ease;\n}\n\n.simulation-dashboard-button:hover,\n.simulation-dashboard-button:focus-visible,\n.simulation-dashboard-icon-button:hover,\n.simulation-dashboard-icon-button:focus-visible {\n  border-color: rgba(244, 241, 234, 0.36);\n  background: color-mix(in srgb, var(--dashboard-panel-soft) calc(100% - var(--abs-button-hover-darken-mix, 10%)), #000 var(--abs-button-hover-darken-mix, 10%));\n  transform: none;\n}\n\n.simulation-dashboard-button:disabled,\n.simulation-dashboard-icon-button:disabled {\n  cursor: not-allowed;\n  opacity: 0.48;\n  transform: none;\n}\n\n.simulation-dashboard-button.is-active {\n  border-color: rgba(105, 215, 124, 0.48);\n  color: var(--dashboard-green);\n  background: rgba(105, 215, 124, 0.12);\n}\n\n.simulation-dashboard-button--primary {\n  border-color: rgba(121, 170, 247, 0.56);\n  background: rgba(121, 170, 247, 0.18);\n}\n\n.simulation-dashboard-button--promote {\n  border-color: rgba(105, 215, 124, 0.48);\n  background: rgba(105, 215, 124, 0.16);\n}\n\n.simulation-dashboard-button--danger {\n  border-color: rgba(255, 120, 110, 0.44);\n  color: #ffc9c4;\n  background: rgba(255, 120, 110, 0.1);\n}\n\n.simulation-dashboard-icon-button {\n  width: 34px;\n  min-width: 34px;\n  padding: 0;\n}\n\n.simulation-dashboard-summary {\n  display: grid;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  background: var(--dashboard-panel);\n  overflow: hidden;\n}\n\n.simulation-dashboard-summary__item {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 2px 8px;\n  align-items: baseline;\n  min-width: 0;\n  border-right: 1px solid var(--dashboard-line);\n  padding: 8px 11px;\n}\n\n.simulation-dashboard-summary__item:last-child {\n  border-right: 0;\n}\n\n.simulation-dashboard-summary__item strong {\n  grid-column: 1;\n  grid-row: 1 / span 2;\n  color: var(--dashboard-text);\n  font-size: 1rem;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.simulation-dashboard-summary__item p {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.simulation-dashboard-inline-notice svg.is-spinning,\n.simulation-dashboard-header__status svg.is-spinning {\n  animation: simulation-dashboard-spin 900ms linear infinite;\n}\n\n@keyframes simulation-dashboard-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.simulation-dashboard-toolbar {\n  display: grid;\n  grid-template-columns: minmax(18rem, 0.34fr) minmax(0, 1fr);\n  gap: 10px;\n  align-items: start;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  padding: 10px;\n  background: var(--dashboard-panel);\n}\n\n.simulation-dashboard-search {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 36px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 0 10px;\n  background: #0c0d0e;\n}\n\n.simulation-dashboard-search svg {\n  color: var(--dashboard-faint);\n}\n\n.simulation-dashboard-search label {\n  flex: 1;\n  min-width: 0;\n}\n\n.simulation-dashboard-search input {\n  width: 100%;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-search input::placeholder {\n  color: var(--dashboard-faint);\n}\n\n.simulation-dashboard-filter-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.simulation-dashboard-filter-list button {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 34px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 7px 9px;\n  background: transparent;\n  color: var(--dashboard-muted);\n  font-size: 0.78rem;\n  font-weight: 700;\n}\n\n.simulation-dashboard-filter-list button.is-active {\n  border-color: var(--dashboard-line-strong);\n  background: var(--dashboard-panel-strong);\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-filter-list button:hover {\n  border-color: var(--dashboard-line-strong);\n  background: rgba(0, 0, 0, 0.1);\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-filter-list button strong {\n  color: var(--dashboard-faint);\n  font-size: 0.74rem;\n}\n\n.simulation-dashboard-list-panel {\n  min-width: 0;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  background: var(--dashboard-panel);\n}\n\n.simulation-dashboard-list-panel__bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  min-height: 46px;\n  border-bottom: 1px solid var(--dashboard-line);\n  padding: 0 14px;\n}\n\n.simulation-dashboard-list-panel__bar strong {\n  display: block;\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-inline-notice {\n  display: grid;\n  grid-template-columns: 16px minmax(0, 1fr);\n  gap: 8px;\n  align-items: start;\n  min-width: 0;\n  max-width: min(36rem, 54vw);\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 7px 9px;\n  background: rgba(244, 241, 234, 0.035);\n}\n\n.simulation-dashboard-inline-notice svg {\n  margin-top: 1px;\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-inline-notice strong,\n.simulation-dashboard-inline-notice span {\n  display: block;\n  overflow-wrap: anywhere;\n}\n\n.simulation-dashboard-inline-notice strong {\n  color: var(--dashboard-text);\n  font-size: 0.76rem;\n  line-height: 1.2;\n}\n\n.simulation-dashboard-inline-notice span {\n  color: var(--dashboard-muted);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.68rem;\n  line-height: 1.25;\n  white-space: pre-wrap;\n}\n\n.simulation-dashboard-list {\n  display: grid;\n}\n\n.simulation-dashboard-list-item {\n  border-bottom: 1px solid var(--dashboard-line);\n  background: transparent;\n  transition:\n    background-color 120ms ease,\n    box-shadow 120ms ease;\n}\n\n.simulation-dashboard-list-item:last-child {\n  border-bottom: 0;\n}\n\n.simulation-dashboard-list-item.is-expanded {\n  background: rgba(244, 241, 234, 0.028);\n  box-shadow: inset 3px 0 0 rgba(244, 241, 234, 0.32);\n}\n\n.simulation-dashboard-list-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  align-items: center;\n  padding: 11px 12px;\n}\n\n.simulation-dashboard-list-row__main {\n  display: grid;\n  grid-template-columns: 86px minmax(12rem, 1.15fr) minmax(12rem, 0.8fr) minmax(8rem, 0.45fr) minmax(5.25rem, auto);\n  gap: 14px;\n  align-items: center;\n  min-width: 0;\n  border: 1px solid transparent;\n  border-radius: var(--dashboard-radius);\n  padding: 5px 8px 5px 0;\n  background: transparent;\n  color: inherit;\n  text-align: left;\n  transition:\n    border-color 120ms ease,\n    background-color 120ms ease;\n}\n\n.simulation-dashboard-list-row__main:hover,\n.simulation-dashboard-list-row__main:focus-visible {\n  border-color: var(--dashboard-line);\n  background: rgba(0, 0, 0, 0.1);\n}\n\n.simulation-dashboard-list-row__toggle {\n  justify-self: end;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 6px 8px;\n  color: var(--dashboard-faint);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.7rem;\n  line-height: 1;\n  transition:\n    border-color 120ms ease,\n    color 120ms ease,\n    background-color 120ms ease;\n}\n\n.simulation-dashboard-list-row__toggle svg {\n  transition: transform 140ms ease;\n}\n\n.simulation-dashboard-list-row__main:hover .simulation-dashboard-list-row__toggle,\n.simulation-dashboard-list-row__main:focus-visible .simulation-dashboard-list-row__toggle,\n.simulation-dashboard-list-item.is-expanded .simulation-dashboard-list-row__toggle {\n  border-color: var(--dashboard-line-strong);\n  background: rgba(0, 0, 0, 0.1);\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-list-item.is-expanded .simulation-dashboard-list-row__toggle svg {\n  transform: rotate(180deg);\n}\n\n.simulation-dashboard-list-row__title {\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n}\n\n.simulation-dashboard-list-row__title strong {\n  overflow: hidden;\n  color: var(--dashboard-text);\n  font-size: 0.94rem;\n  font-weight: 700;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.simulation-dashboard-list-row__status {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  min-width: 0;\n}\n\n.simulation-dashboard-list-row__meta {\n  display: grid;\n  gap: 3px;\n}\n\n.simulation-dashboard-row-actions {\n  display: inline-flex;\n  gap: 6px;\n}\n\n.simulation-dashboard-thumb {\n  position: relative;\n  display: block;\n  width: 74px;\n  aspect-ratio: 16 / 9;\n  overflow: hidden;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  background: #0b0c0c;\n}\n\n.simulation-dashboard-thumb--large {\n  width: 100%;\n}\n\n.simulation-dashboard-thumb img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.simulation-dashboard-thumb > span {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background:\n    radial-gradient(circle at 32% 42%, rgba(66, 200, 188, 0.7) 0 9%, transparent 9.4%),\n    radial-gradient(circle at 58% 52%, rgba(240, 186, 86, 0.8) 0 7%, transparent 7.4%),\n    #101112;\n}\n\n.simulation-dashboard-thumb em {\n  position: absolute;\n  left: 5px;\n  bottom: 5px;\n  border-radius: 3px;\n  padding: 2px 4px;\n  background: rgba(0, 0, 0, 0.7);\n  color: var(--dashboard-text);\n  font-size: 0.62rem;\n  font-style: normal;\n  line-height: 1;\n}\n\n.simulation-dashboard-pill {\n  display: inline-flex;\n  align-items: center;\n  min-height: 22px;\n  max-width: 100%;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 3px 7px;\n  color: var(--dashboard-muted);\n  background: transparent;\n  font-size: 0.7rem;\n  line-height: 1.1;\n  text-transform: capitalize;\n}\n\n.simulation-dashboard-pill--hidden,\n.simulation-dashboard-pill--disabled,\n.simulation-dashboard-pill--internal,\n.simulation-dashboard-pill--unknown {\n  color: var(--dashboard-faint);\n}\n\n.simulation-dashboard-expanded {\n  display: grid;\n  grid-template-columns: minmax(14rem, 0.82fr) minmax(20rem, 1.3fr) minmax(16rem, 0.78fr);\n  gap: 16px;\n  border-top: 1px solid var(--dashboard-line);\n  padding: 16px;\n}\n\n.simulation-dashboard-expanded__preview,\n.simulation-dashboard-expanded__main,\n.simulation-dashboard-expanded__controls {\n  min-width: 0;\n}\n\n.simulation-dashboard-expanded__links {\n  flex-wrap: wrap;\n  margin-top: 10px;\n}\n\n.simulation-dashboard-section {\n  display: grid;\n  gap: 10px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  padding: 12px;\n  background: rgba(12, 13, 14, 0.36);\n}\n\n.simulation-dashboard-section + .simulation-dashboard-section {\n  margin-top: 12px;\n}\n\n.simulation-dashboard-section h3 {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  color: var(--dashboard-muted);\n  text-transform: uppercase;\n}\n\n.simulation-dashboard-section h3 span {\n  color: var(--dashboard-faint);\n  font-size: 0.68rem;\n  font-weight: 700;\n}\n\n.simulation-dashboard-section p {\n  margin: 0;\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-detail-list {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px 12px;\n  margin: 0;\n}\n\n.simulation-dashboard-detail-row {\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n}\n\n.simulation-dashboard-detail-row dd {\n  min-width: 0;\n  margin: 0;\n  overflow-wrap: anywhere;\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-blockers ul,\n.simulation-dashboard-delete-modal__block ul,\n.simulation-dashboard-delete-modal__plan ul {\n  display: grid;\n  gap: 7px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.simulation-dashboard-blockers li,\n.simulation-dashboard-delete-modal__block li {\n  color: var(--dashboard-amber);\n}\n\n.simulation-dashboard-issues ul,\n.simulation-dashboard-activity ol {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.simulation-dashboard-issues li {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  align-items: center;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 8px;\n  background: var(--dashboard-panel-soft);\n}\n\n.simulation-dashboard-issues strong,\n.simulation-dashboard-issues span,\n.simulation-dashboard-issues small {\n  display: block;\n  overflow-wrap: anywhere;\n}\n\n.simulation-dashboard-issues span,\n.simulation-dashboard-issues small {\n  color: var(--dashboard-muted);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.68rem;\n}\n\n.simulation-dashboard-issues span {\n  text-transform: uppercase;\n}\n\n.simulation-dashboard-issues small {\n  margin-top: 2px;\n}\n\n.simulation-dashboard-activity li {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  color: var(--dashboard-muted);\n  font-size: 0.78rem;\n}\n\n.simulation-dashboard-activity li > div {\n  display: grid;\n  gap: 2px;\n  min-width: 0;\n}\n\n.simulation-dashboard-activity span,\n.simulation-dashboard-activity small {\n  overflow-wrap: anywhere;\n}\n\n.simulation-dashboard-activity span {\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-activity small {\n  color: var(--dashboard-faint);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.68rem;\n}\n\n.simulation-dashboard-activity time {\n  color: var(--dashboard-faint);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.68rem;\n}\n\n.simulation-dashboard-review-actions > div,\n.simulation-dashboard-stage-actions > div,\n.simulation-dashboard-danger-zone > div {\n  display: grid;\n  gap: 8px;\n}\n\n.simulation-dashboard-review-actions > div {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.simulation-dashboard-stage-actions > div,\n.simulation-dashboard-danger-zone > div {\n  grid-template-columns: 1fr;\n}\n\n.simulation-dashboard-review-actions .simulation-dashboard-button,\n.simulation-dashboard-stage-actions .simulation-dashboard-button,\n.simulation-dashboard-danger-zone .simulation-dashboard-button {\n  width: 100%;\n}\n\n.has-issues {\n  color: var(--dashboard-text);\n  font-weight: 700;\n}\n\n.simulation-dashboard-empty {\n  margin: 0;\n  padding: 18px;\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-modal {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: rgba(0, 0, 0, 0.62);\n  backdrop-filter: blur(14px);\n}\n\n.simulation-dashboard-modal__panel {\n  display: grid;\n  gap: 14px;\n  width: min(100%, 620px);\n  max-height: min(760px, calc(100dvh - 48px));\n  overflow-y: auto;\n  border: 1px solid var(--dashboard-line-strong);\n  border-radius: var(--dashboard-radius);\n  padding: 18px;\n  background: var(--dashboard-panel);\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-modal__header,\n.simulation-dashboard-modal__actions {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  align-items: flex-start;\n}\n\n.simulation-dashboard-modal__header h2 {\n  margin: 7px 0 3px;\n  color: var(--dashboard-text);\n  font-size: 1rem;\n  line-height: 1.15;\n}\n\n.simulation-dashboard-modal label {\n  display: grid;\n  gap: 6px;\n}\n\n.simulation-dashboard-modal input,\n.simulation-dashboard-modal select,\n.simulation-dashboard-modal textarea {\n  width: 100%;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 10px;\n  background: #0f1011;\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-modal textarea {\n  resize: vertical;\n}\n\n.simulation-dashboard-delete-modal__block {\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr);\n  gap: 10px;\n  border: 1px solid rgba(255, 120, 110, 0.34);\n  border-radius: var(--dashboard-radius);\n  padding: 12px;\n  background: rgba(255, 120, 110, 0.08);\n}\n\n.simulation-dashboard-delete-modal__block svg {\n  color: var(--dashboard-red);\n}\n\n.simulation-dashboard-delete-modal__block strong {\n  display: block;\n  margin-bottom: 6px;\n}\n\n.simulation-dashboard-delete-modal__plan {\n  display: grid;\n  gap: 8px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  padding: 12px;\n  background: rgba(12, 13, 14, 0.36);\n}\n\n.simulation-dashboard-delete-modal__plan h3 {\n  margin: 0;\n  color: var(--dashboard-muted);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.72rem;\n  text-transform: uppercase;\n}\n\n.simulation-dashboard-delete-modal__plan li {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n\n.simulation-dashboard-delete-modal__plan strong {\n  overflow-wrap: anywhere;\n  font-size: 0.82rem;\n}\n\n.simulation-dashboard-delete-modal__plan p {\n  margin: 0;\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-delete-modal__confirm strong {\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-sr {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n@media (max-width: 92rem) {\n  .simulation-dashboard {\n    padding: 14px;\n  }\n\n  .simulation-dashboard-header,\n  .simulation-dashboard-toolbar {\n    grid-template-columns: 1fr;\n  }\n\n  .simulation-dashboard-header__actions {\n    flex-wrap: wrap;\n  }\n\n  .simulation-dashboard-expanded {\n    grid-template-columns: minmax(14rem, 0.75fr) minmax(0, 1fr);\n  }\n\n  .simulation-dashboard-expanded__controls {\n    display: grid;\n    grid-column: 1 / -1;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .simulation-dashboard-expanded__controls .simulation-dashboard-section {\n    margin-top: 0;\n  }\n}\n\n@media (max-width: 76rem) {\n  .simulation-dashboard-summary {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .simulation-dashboard-summary__item:nth-child(3n) {\n    border-right: 0;\n  }\n\n  .simulation-dashboard-list-row__main {\n    grid-template-columns: 86px minmax(0, 1fr) minmax(9rem, 0.6fr) minmax(5.25rem, auto);\n  }\n\n  .simulation-dashboard-list-row__meta {\n    display: none;\n  }\n\n  .simulation-dashboard-expanded,\n  .simulation-dashboard-expanded__controls {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 52rem) {\n  .simulation-dashboard {\n    padding: 10px;\n  }\n\n  .simulation-dashboard-header {\n    position: static;\n  }\n\n  .simulation-dashboard-header__title {\n    flex-wrap: wrap;\n  }\n\n  .simulation-dashboard-header__actions {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    width: 100%;\n  }\n\n  .simulation-dashboard-summary {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .simulation-dashboard-summary__item,\n  .simulation-dashboard-summary__item:nth-child(3n) {\n    border-right: 1px solid var(--dashboard-line);\n  }\n\n  .simulation-dashboard-summary__item:nth-child(2n) {\n    border-right: 0;\n  }\n\n  .simulation-dashboard-list-row {\n    grid-template-columns: 1fr;\n  }\n\n  .simulation-dashboard-list-row__main {\n    grid-template-columns: 74px minmax(0, 1fr) minmax(5.25rem, auto);\n    gap: 10px;\n  }\n\n  .simulation-dashboard-list-row__status {\n    grid-column: 2 / -1;\n  }\n\n  .simulation-dashboard-list-row__toggle {\n    padding-inline: 7px;\n  }\n\n  .simulation-dashboard-row-actions {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .simulation-dashboard-row-actions .simulation-dashboard-icon-button {\n    width: 100%;\n  }\n\n  .simulation-dashboard-detail-list,\n  .simulation-dashboard-review-actions > div {\n    grid-template-columns: 1fr;\n  }\n\n  .simulation-dashboard-modal {\n    padding: 10px;\n  }\n\n  .simulation-dashboard-modal__actions,\n  .simulation-dashboard-modal__actions > div {\n    flex-wrap: wrap;\n  }\n}\n\n@media (max-width: 36rem) {\n  .simulation-dashboard-list-panel__bar {\n    display: grid;\n    align-items: start;\n  }\n\n  .simulation-dashboard-inline-notice {\n    max-width: 100%;\n  }\n\n  .simulation-dashboard-list-row__main {\n    grid-template-columns: 68px minmax(0, 1fr);\n  }\n\n  .simulation-dashboard-list-row__status,\n  .simulation-dashboard-list-row__toggle {\n    grid-column: 2;\n    justify-self: start;\n  }\n\n  .simulation-dashboard-list-row__title strong {\n    white-space: normal;\n  }\n\n  .simulation-dashboard-activity li {\n    grid-template-columns: 1fr;\n  }\n}\n"],["STYLE",{},"html.loader-playground-document,\nbody.loader-playground-page,\nbody.loader-playground-page #root {\n  width: 100%;\n  height: 100%;\n  min-height: 100dvh;\n  margin: 0;\n  overflow: hidden;\n  background: #141517;\n  color: var(--text-primary, #eceff3);\n}\n\nbody.loader-playground-page {\n  font-family: var(--abs-font-sans);\n}\n\n.loader-playground {\n  --loader-playground-bg: #141517;\n  --loader-playground-cell: #191a1d;\n  --loader-playground-cell-active: #202328;\n  --loader-playground-border: #2d3036;\n  --loader-playground-text: #eceff3;\n  --loader-playground-muted: #8d939c;\n  --loader-playground-accent: #5db7ff;\n\n  display: grid;\n  grid-template-columns: minmax(0, 7fr) minmax(280px, 3fr);\n  width: 100%;\n  height: 100dvh;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--loader-playground-bg);\n  color: var(--loader-playground-text);\n}\n\n.loader-playground__grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  grid-template-rows: repeat(3, minmax(0, 1fr));\n  min-width: 0;\n  min-height: 0;\n  gap: 1px;\n  padding: 1px;\n  background: var(--loader-playground-border);\n}\n\n.loader-playground-card {\n  position: relative;\n  display: grid;\n  place-items: center;\n  min-width: 0;\n  min-height: 0;\n  border: 0;\n  border-radius: 0;\n  background: var(--loader-playground-cell);\n  color: inherit;\n  cursor: pointer;\n  font: inherit;\n  overflow: hidden;\n}\n\n.loader-playground-card:hover,\n.loader-playground-card:focus-visible,\n.loader-playground-card.is-selected {\n  background: var(--loader-playground-cell-active);\n}\n\n.loader-playground-card:focus-visible {\n  outline: 1px solid var(--loader-playground-accent);\n  outline-offset: -1px;\n}\n\n.loader-playground-card.is-selected::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border: 1px solid var(--loader-playground-accent);\n  pointer-events: none;\n}\n\n.loader-playground-card__meta {\n  position: absolute;\n  top: clamp(8px, 1.5vh, 14px);\n  left: clamp(8px, 1.5vw, 14px);\n  right: clamp(8px, 1.5vw, 14px);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  color: var(--loader-playground-muted);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0;\n  line-height: 1;\n  pointer-events: none;\n}\n\n.loader-playground-card__index {\n  flex: 0 0 auto;\n  color: var(--loader-playground-text);\n  font-family: var(--abs-font-mono);\n  font-size: 10px;\n}\n\n.loader-playground-card__label {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.loader-sample {\n  --loader-dot-size: 4.25px;\n\n  position: relative;\n  width: clamp(56px, 7vw, 92px);\n  height: clamp(56px, 7vw, 92px);\n  display: grid;\n  place-items: center;\n  pointer-events: none;\n}\n\n.loader-orbit,\n.loader-ring-plane,\n.loader-radius-plane,\n.loader-ring {\n  position: absolute;\n  inset: 0;\n  transform-origin: 50% 50%;\n}\n\n.loader-radius-plane {\n  transform: scale(1);\n}\n\n.loader-ring {\n  animation: loaderSpinFluidSweep var(--loader-duration) linear infinite;\n}\n\n.loader-dot {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  display: block;\n  width: var(--loader-dot-size);\n  height: var(--loader-dot-size);\n  transform:\n    translate(-50%, -50%)\n    rotate(var(--dot-angle))\n    translateY(var(--dot-radius-negative))\n    rotate(var(--dot-counter-angle));\n  transform-origin: 50% 50%;\n}\n\n.loader-dot-core {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  background: var(--dot-color);\n  opacity: 0.92;\n  animation: loaderColorCycle var(--loader-color-cycle) steps(1, end) infinite;\n  animation-delay: var(--dot-color-delay);\n  transform-origin: 50% 50%;\n}\n\n.loader-sample--color-fixed .loader-dot-core {\n  animation: none;\n  background: var(--dot-color);\n}\n\n.loader-sample--long-ease .loader-ring {\n  animation-name: loaderSpinLongEase;\n}\n\n.loader-sample--rubber-pull .loader-ring {\n  animation-name: loaderSpinRubberPull;\n}\n\n.loader-sample--spring-arc .loader-ring {\n  animation-name: loaderSpinSpringArc;\n}\n\n.loader-sample--rolling-wave .loader-ring {\n  animation-name: loaderSpinRollingWave;\n}\n\n.loader-sample--slipstream .loader-ring {\n  animation-name: loaderSpinSlipstream;\n}\n\n.loader-sample--elastic-loop .loader-ring {\n  animation-name: loaderSpinElasticLoop;\n}\n\n.loader-sample--buoyant-arc .loader-ring {\n  animation-name: loaderSpinBuoyantArc;\n}\n\n.loader-sample--braided-sweep .loader-ring {\n  animation-name: loaderSpinBraidedSweep;\n}\n\n.loader-sample--fixed-flow .loader-ring {\n  animation-name: loaderSpinFixedFlow;\n}\n\n.loader-sample--fixed-rubber .loader-ring {\n  animation-name: loaderSpinFixedRubber;\n}\n\n.loader-sample--fixed-drift .loader-ring {\n  animation-name: loaderSpinFixedDrift;\n}\n\n@keyframes loaderSpinFluidSweep {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.42, 0, 0.28, 1); }\n  18% { transform: rotate(56deg); animation-timing-function: cubic-bezier(0.25, 0, 0.22, 1); }\n  36% { transform: rotate(132deg); animation-timing-function: cubic-bezier(0.42, 0, 0.32, 1); }\n  58% { transform: rotate(210deg); animation-timing-function: cubic-bezier(0.2, 0, 0.2, 1); }\n  78% { transform: rotate(300deg); animation-timing-function: cubic-bezier(0.46, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinLongEase {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.5, 0, 0.32, 1); }\n  16% { transform: rotate(44deg); animation-timing-function: cubic-bezier(0.22, 0, 0.18, 1); }\n  34% { transform: rotate(116deg); animation-timing-function: cubic-bezier(0.45, 0, 0.3, 1); }\n  56% { transform: rotate(190deg); animation-timing-function: cubic-bezier(0.2, 0, 0.22, 1); }\n  76% { transform: rotate(286deg); animation-timing-function: cubic-bezier(0.48, 0, 0.38, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinRubberPull {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.12, 0, 0.18, 1); }\n  12% { transform: rotate(54deg); animation-timing-function: cubic-bezier(0.58, 0, 0.42, 1); }\n  24% { transform: rotate(88deg); animation-timing-function: cubic-bezier(0.16, 0, 0.16, 1); }\n  39% { transform: rotate(162deg); animation-timing-function: cubic-bezier(0.55, 0, 0.38, 1); }\n  55% { transform: rotate(208deg); animation-timing-function: cubic-bezier(0.16, 0, 0.18, 1); }\n  73% { transform: rotate(302deg); animation-timing-function: cubic-bezier(0.5, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinSpringArc {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.14, 0, 0.2, 1); }\n  14% { transform: rotate(66deg); animation-timing-function: cubic-bezier(0.5, 0, 0.42, 1); }\n  28% { transform: rotate(108deg); animation-timing-function: cubic-bezier(0.15, 0, 0.18, 1); }\n  44% { transform: rotate(190deg); animation-timing-function: cubic-bezier(0.52, 0, 0.38, 1); }\n  62% { transform: rotate(246deg); animation-timing-function: cubic-bezier(0.18, 0, 0.2, 1); }\n  81% { transform: rotate(326deg); animation-timing-function: cubic-bezier(0.46, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinRollingWave {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.44, 0, 0.28, 1); }\n  20% { transform: rotate(62deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  38% { transform: rotate(146deg); animation-timing-function: cubic-bezier(0.46, 0, 0.34, 1); }\n  55% { transform: rotate(202deg); animation-timing-function: cubic-bezier(0.18, 0, 0.2, 1); }\n  75% { transform: rotate(294deg); animation-timing-function: cubic-bezier(0.48, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinSlipstream {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.16, 0, 0.16, 1); }\n  10% { transform: rotate(46deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  26% { transform: rotate(122deg); animation-timing-function: cubic-bezier(0.56, 0, 0.38, 1); }\n  48% { transform: rotate(180deg); animation-timing-function: cubic-bezier(0.18, 0, 0.18, 1); }\n  68% { transform: rotate(272deg); animation-timing-function: cubic-bezier(0.48, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinElasticLoop {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.12, 0, 0.18, 1); }\n  11% { transform: rotate(58deg); animation-timing-function: cubic-bezier(0.58, 0, 0.44, 1); }\n  23% { transform: rotate(92deg); animation-timing-function: cubic-bezier(0.14, 0, 0.18, 1); }\n  36% { transform: rotate(160deg); animation-timing-function: cubic-bezier(0.52, 0, 0.38, 1); }\n  52% { transform: rotate(214deg); animation-timing-function: cubic-bezier(0.15, 0, 0.17, 1); }\n  69% { transform: rotate(300deg); animation-timing-function: cubic-bezier(0.52, 0, 0.38, 1); }\n  84% { transform: rotate(334deg); animation-timing-function: cubic-bezier(0.42, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinBuoyantArc {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.5, 0, 0.36, 1); }\n  17% { transform: rotate(48deg); animation-timing-function: cubic-bezier(0.18, 0, 0.18, 1); }\n  35% { transform: rotate(136deg); animation-timing-function: cubic-bezier(0.48, 0, 0.34, 1); }\n  53% { transform: rotate(196deg); animation-timing-function: cubic-bezier(0.22, 0, 0.2, 1); }\n  72% { transform: rotate(276deg); animation-timing-function: cubic-bezier(0.45, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinBraidedSweep {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.36, 0, 0.24, 1); }\n  15% { transform: rotate(52deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  31% { transform: rotate(124deg); animation-timing-function: cubic-bezier(0.44, 0, 0.32, 1); }\n  47% { transform: rotate(174deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  64% { transform: rotate(250deg); animation-timing-function: cubic-bezier(0.46, 0, 0.34, 1); }\n  82% { transform: rotate(314deg); animation-timing-function: cubic-bezier(0.44, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinFixedFlow {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.42, 0, 0.28, 1); }\n  18% { transform: rotate(60deg); animation-timing-function: cubic-bezier(0.24, 0, 0.2, 1); }\n  40% { transform: rotate(142deg); animation-timing-function: cubic-bezier(0.34, 0, 0.28, 1); }\n  60% { transform: rotate(230deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  82% { transform: rotate(310deg); animation-timing-function: cubic-bezier(0.46, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinFixedRubber {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.13, 0, 0.18, 1); }\n  13% { transform: rotate(62deg); animation-timing-function: cubic-bezier(0.56, 0, 0.42, 1); }\n  25% { transform: rotate(100deg); animation-timing-function: cubic-bezier(0.15, 0, 0.17, 1); }\n  42% { transform: rotate(188deg); animation-timing-function: cubic-bezier(0.52, 0, 0.38, 1); }\n  57% { transform: rotate(236deg); animation-timing-function: cubic-bezier(0.16, 0, 0.18, 1); }\n  74% { transform: rotate(322deg); animation-timing-function: cubic-bezier(0.48, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinFixedDrift {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.48, 0, 0.34, 1); }\n  22% { transform: rotate(64deg); animation-timing-function: cubic-bezier(0.22, 0, 0.2, 1); }\n  41% { transform: rotate(138deg); animation-timing-function: cubic-bezier(0.42, 0, 0.3, 1); }\n  61% { transform: rotate(224deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  80% { transform: rotate(298deg); animation-timing-function: cubic-bezier(0.45, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderColorCycle {\n  0%,\n  15.99%,\n  100% {\n    background: var(--ball-1, #b5b7b6);\n  }\n\n  16.66%,\n  32.99% {\n    background: var(--ball-4, #00695c);\n  }\n\n  33.33%,\n  49.99% {\n    background: var(--ball-2, #bbbdbd);\n  }\n\n  50%,\n  66.65% {\n    background: var(--ball-7, #0d5cb6);\n  }\n\n  66.66%,\n  83.32% {\n    background: var(--ball-8, #ffa000);\n  }\n\n  83.33%,\n  99.99% {\n    background: var(--ball-6, #d7ff2f);\n  }\n}\n\n.parameterizer-panel.loader-playground-panel {\n  --parameterizer-header-height: 28px;\n  --parameterizer-folder-height: 24px;\n  --parameterizer-row-height: 26px;\n  --parameterizer-panel-bg: #191a1d;\n  --parameterizer-header-bg: #111215;\n  --parameterizer-folder-bg: #222429;\n  --parameterizer-row-bg: #191a1d;\n  --parameterizer-row-hover: #202228;\n  --parameterizer-separator: #2d3036;\n  --parameterizer-text: #eceff3;\n  --parameterizer-muted: #8d939c;\n  --parameterizer-widget-bg: #2a2d33;\n  --parameterizer-accent: var(--loader-playground-accent);\n\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  height: 100dvh;\n  overflow: hidden;\n  border: 0;\n  border-left: 1px solid var(--parameterizer-separator);\n  border-radius: 0;\n  background: var(--parameterizer-panel-bg);\n  color: var(--parameterizer-text);\n  font-family: var(--abs-font-sans);\n  font-size: 11px;\n  line-height: 1.25;\n}\n\n.loader-playground-panel .parameterizer-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  min-height: var(--parameterizer-header-height);\n  padding-inline: 8px;\n  border-bottom: 1px solid var(--parameterizer-separator);\n  background: var(--parameterizer-header-bg);\n  font-weight: 600;\n}\n\n.loader-playground-panel__status {\n  color: var(--parameterizer-muted);\n  font-family: var(--abs-font-mono);\n  font-size: 10px;\n  font-weight: 500;\n}\n\n.loader-playground-panel__title {\n  display: inline-flex;\n  gap: 3px;\n  min-width: 0;\n  overflow: hidden;\n  white-space: nowrap;\n}\n\n.loader-playground-panel__active {\n  display: grid;\n  gap: 4px;\n  padding: 8px;\n  border-bottom: 1px solid var(--parameterizer-separator);\n  color: var(--parameterizer-text);\n}\n\n.loader-playground-panel__active span:first-child {\n  overflow: hidden;\n  font-weight: 600;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.loader-playground-panel__active span:last-child {\n  color: var(--parameterizer-muted);\n  font-size: 10px;\n  line-height: 1.35;\n}\n\n.loader-playground-panel .parameterizer-scroll {\n  overflow: auto;\n  min-height: 0;\n}\n\n.loader-playground-panel .parameterizer-folder {\n  border-bottom: 1px solid var(--parameterizer-separator);\n}\n\n.loader-playground-panel .parameterizer-folder-title {\n  display: flex;\n  align-items: center;\n  min-height: var(--parameterizer-folder-height);\n  padding-inline: 8px;\n  background: var(--parameterizer-folder-bg);\n  color: var(--parameterizer-text);\n  cursor: default;\n  font-weight: 600;\n  list-style: none;\n}\n\n.loader-playground-panel .parameterizer-folder-title::-webkit-details-marker {\n  display: none;\n}\n\n.loader-playground-panel .parameterizer-folder-title::before {\n  width: 12px;\n  color: var(--parameterizer-muted);\n  content: \"v\";\n  font-family: var(--abs-font-mono);\n  font-size: 9px;\n}\n\n.loader-playground-panel .parameterizer-folder:not([open]) .parameterizer-folder-title::before {\n  content: \">\";\n}\n\n.loader-playground-panel__rows {\n  padding-block: 2px;\n}\n\n.loader-playground-panel .parameterizer-row {\n  display: grid;\n  grid-template-columns: minmax(0, 34%) minmax(0, 1fr) 56px;\n  align-items: center;\n  min-height: var(--parameterizer-row-height);\n  padding-inline: 8px 6px;\n  gap: 6px;\n  background: var(--parameterizer-row-bg);\n}\n\n.loader-playground-panel .parameterizer-row:hover {\n  background: var(--parameterizer-row-hover);\n}\n\n.loader-playground-panel .parameterizer-label {\n  overflow: hidden;\n  color: var(--parameterizer-text);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.loader-playground-panel .parameterizer-control {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n}\n\n.loader-playground-panel .parameterizer-value {\n  overflow: hidden;\n  color: var(--parameterizer-muted);\n  font-family: var(--abs-font-mono);\n  font-size: 10px;\n  font-variant-numeric: tabular-nums;\n  text-align: right;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.loader-playground-panel input,\n.loader-playground-panel select,\n.loader-playground-panel button {\n  font: inherit;\n}\n\n.loader-playground-panel input[type='range'] {\n  width: 100%;\n  accent-color: var(--parameterizer-accent);\n}\n\n.loader-playground-panel select {\n  width: 100%;\n  min-width: 0;\n  height: 18px;\n  border: 1px solid var(--parameterizer-separator);\n  border-radius: 2px;\n  background: var(--parameterizer-widget-bg);\n  color: var(--parameterizer-text);\n}\n\n.loader-playground-panel .parameterizer-actions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 4px;\n  padding: 4px;\n  border-top: 1px solid var(--parameterizer-separator);\n  background: var(--parameterizer-header-bg);\n}\n\n.loader-playground-panel button {\n  min-height: 22px;\n  border: 1px solid var(--parameterizer-separator);\n  border-radius: 2px;\n  background: var(--parameterizer-widget-bg);\n  color: var(--parameterizer-text);\n  cursor: pointer;\n}\n\n.loader-playground-panel button:hover {\n  background: color-mix(in srgb, var(--parameterizer-widget-bg) calc(100% - var(--abs-button-hover-darken-mix, 10%)), #000 var(--abs-button-hover-darken-mix, 10%));\n}\n\n.loader-playground-panel button:focus-visible,\n.loader-playground-panel input:focus-visible,\n.loader-playground-panel select:focus-visible {\n  outline: 1px solid var(--parameterizer-accent);\n  outline-offset: 1px;\n}\n\n@media (color-gamut: p3) {\n  .loader-playground {\n    --loader-playground-accent: color(display-p3 0.36 0.72 1);\n  }\n}\n\n@media (max-width: 860px) {\n  html.loader-playground-document,\n  body.loader-playground-page,\n  body.loader-playground-page #root {\n    overflow: auto;\n  }\n\n  .loader-playground {\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(620px, 1fr) auto;\n    height: auto;\n    min-height: 100dvh;\n    overflow: visible;\n  }\n\n  .loader-playground__grid {\n    min-height: 620px;\n  }\n\n  .parameterizer-panel.loader-playground-panel {\n    height: auto;\n    max-height: 520px;\n    border-left: 0;\n    border-top: 1px solid var(--parameterizer-separator);\n  }\n}\n\n@media (max-width: 560px) {\n  .loader-playground__grid {\n    grid-template-columns: 1fr;\n    grid-template-rows: repeat(12, 148px);\n    min-height: 0;\n  }\n\n  .loader-playground-card__meta {\n    top: 10px;\n    left: 10px;\n    right: 10px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .loader-ring,\n  .loader-dot-core {\n    animation: none;\n  }\n\n  .loader-dot-core {\n    opacity: 0.86;\n    transform: none;\n    background: var(--dot-color);\n  }\n}\n"]],"\n  ",["BODY",{"class":"body about-narrative-lab-page about-narrative-page","data-abs-theme":"light"},"\n    ",["DIV",{"id":"root"},["DIV",{"data-sfid":"sfid:shell/about-narrative-lab"},["DIV",{"id":"abs-scene","class":"app-scene abs-scene"},["DIV",{"id":"simulations","class":"studio-window-layer simulation-wall-layer about-narrative-lab-window route-page-window w-embed"},["DIV",{"id":"scene-effects","class":"scene-effects","aria-hidden":"true"},["DIV",{"class":"noise"}]],["DIV",{"class":"inner-wall-gradient-edge","aria-hidden":"true"}],["DIV",{"id":"shell-wall-slot","class":"studio-window-slot shell-wall-slot shell-transition-surface shell-transition-surface--wall"},["DIV",{"class":"studio-window-route-root shell-wall-route-root route-simulation-layer"},["DIV",{"class":"about-narrative-lab","data-route-content":"about-narrative-lab","data-point-world-state":"ready","data-active-narrative-section":"promise","data-opening-scroll-cue":"visible","data-world-prepare":"loading","data-world-bootstrap-generation-m