a-discipline-tone":"orange","style":"--discipline-label-offset: 10px;"},["SPAN",{"class":"about-narrative-discipline-reveal__label"},"Creative Engineering"]],["LI",{"data-discipline-group":"6","data-discipline-tone":"green","style":"--discipline-label-offset: 10px;"},["SPAN",{"class":"about-narrative-discipline-reveal__label"},"Parametric Systems"]]],["DIV",{"class":"about-narrative-scrollport","data-lenis-prevent-touch":"true","tabindex":"0","aria-label":"About Alexander narrative"},["MAIN",{"class":"about-narrative-content"},["SECTION",{"id":"about-narrative-promise","class":"about-narrative-section about-narrative-section--opening","data-narrative-section":"promise","data-section-index":"0","aria-labelledby":"about-route-title","data-text-movement":"spatial","style":"--section-duration-wu: 1.7; --section-duration-mobile-wu: 1.65;"},["DIV",{"class":"about-narrative-spatial-stage","data-text-movement":"spatial"},["DIV",{"class":"about-narrative-spatial-copy"},["H1",{"id":"about-route-title","class":"about-narrative-spatial-title","aria-label":"I help shape complex ideas into emotionally compelling experiences. At the start, an idea can feel like everything at once.","data-primary-copy":"true"},["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"promise-main","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: 36.00px; --fragment-z: 0.00px; --fragment-scale: 1.0000; --fragment-blur: 0.00px; --fragment-opacity: 1.0000;"},"I help shape complex ideas into emotionally compelling experiences."],["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"complexity-idea","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"At the start, an idea can feel like everything at once."]],["DIV",{"class":"about-narrative-opening-scroll-cue","aria-hid