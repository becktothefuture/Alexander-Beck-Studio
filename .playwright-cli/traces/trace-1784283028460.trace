opacity: 0; --inner-wall-gradient-edge-side-opacity: 0; --inner-wall-gradient-edge-side-shadow-opacity: 0; --inner-wall-gradient-edge-top-shadow-opacity: 0; --quote-button-outer-shadow: 0.09; --puck-edge-width: 3.5px; --puck-edge-light-opacity: 0.16; --puck-edge-shadow-opacity: 0.2; --ui-chrome-rim-light-opacity: 0.4033333333333334; --ui-chrome-rim-dark-opacity: 0.14444444444444446; --abs-frame-inset-desktop: 14px; --abs-frame-inset-mobile: 10px; --abs-frame-inset-value: clamp(10px, calc(6.242661448px + 0.782778865vw), 14px); --abs-frame-inset: var(--abs-frame-inset-value); --abs-content-inset-desktop: 28px; --abs-content-inset-tablet: 22px; --abs-content-inset-mobile: 16px; --abs-frame-radius-desktop: 102px; --abs-frame-radius-mobile: 32px; --abs-frame-radius-value: clamp(32px, calc(-33.753424658px + 13.698630137vw), 102px); --decorative-script-max-width: 452px; --decorative-script-padding-left: 0px; --decorative-script-padding-vertical: 0px; --abs-quote-button-size: 272px; --abs-quote-pad-x: 28px; --abs-quote-pad-y: 27px; --abs-shell-reveal-ms: 180ms; --abs-content-reveal-ms: 420ms; --modal-overlay-opacity: 0; --modal-overlay-blur: 13.2px; --modal-overlay-mobile-blur: 24px; --modal-overlay-transition-duration: 700ms; --modal-overlay-transition-out-duration: 500ms; --modal-content-delay: 200ms; --modal-depth-scale: 0.943; --modal-depth-translate-y: 1px; --abs-home-mobile-nav-bottom-offset: 118px; --abs-home-logo-width-vw: 52; --abs-home-logo-min-px: 340px; --abs-home-logo-max-px: 640px; --abs-home-mobile-logo-width-vw: 64; --abs-home-mobile-logo-min-px: 220px; --abs-home-mobile-logo-max-px: 320px; --abs-safe-top: env(safe-area-inset-top, 0px); --abs-safe-right: env(safe-area-inset-right, 0px); --abs-safe-bottom: env(safe-area-inset-bottom, 0px); --abs-safe-left: env(safe-area-inset-left, 0px); --abs-wall-base: #f5f5f5; --shell-wall-bg: #f5f5f5; --studio-window-bg-light: #e9e9e9; --studio-window-bg-dark: #141414; --studio-window-bg: #e9e9e9; --simulation-contrast-ve