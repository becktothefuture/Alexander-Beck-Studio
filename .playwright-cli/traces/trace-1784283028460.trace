abels span:nth-child(2) { color: var(--editor-camera); }\n.about-editor-lane-labels span:nth-child(3) { color: var(--editor-world); }\n.about-editor-lane-labels span:nth-child(4) { color: var(--editor-text); }\n.about-editor-lane-labels span:nth-child(5) { color: var(--editor-interaction); }\n\n.about-editor-lanes {\n  position: relative;\n  min-width: 0;\n  overflow-x: auto;\n  scrollbar-width: thin;\n}\n\n.about-editor-timeline-canvas {\n  position: relative;\n  width: calc(100% * var(--about-editor-timeline-zoom, 1));\n  min-width: calc(760px * var(--about-editor-timeline-zoom, 1));\n  height: 100%;\n}\n\n.about-editor-marquee {\n  position: absolute;\n  z-index: 9;\n  box-sizing: border-box;\n  border: 1px solid color-mix(in srgb, var(--editor-text) 88%, white 12%);\n  background: color-mix(in srgb, var(--editor-text) 16%, transparent);\n  box-shadow: 0 0 18px color-mix(in srgb, var(--editor-text) 18%, transparent);\n  pointer-events: none;\n}\n\n.about-editor-lane {\n  display: flex;\n  width: 100%;\n  min-width: 0;\n  height: 20%;\n  box-sizing: border-box;\n  border-bottom: 1px solid var(--editor-line);\n  background: color-mix(in srgb, var(--editor-field) 80%, transparent);\n}\n\n.about-editor-lane:nth-child(even) {\n  background: color-mix(in srgb, var(--editor-field) 92%, #000 8%);\n}\n\n.about-editor-lanes[data-solo-track='camera'] .about-editor-lane:not(.about-editor-lane--camera):not(.about-editor-lane--section),\n.about-editor-lanes[data-solo-track='world'] .about-editor-lane:not(.about-editor-lane--world):not(.about-editor-lane--section),\n.about-editor-lanes[data-solo-track='text'] .about-editor-lane:not(.about-editor-lane--text):not(.about-editor-lane--section) {\n  opacity: 0.16;\n}\n\n.about-editor-lane > button,\n.about-editor-section-clip,\n.about-editor-clip {\n  position: relative;\n  flex: 0 0 auto;\n  height: 100%;\n  overflow: hidden;\n  box-sizing: border-box;\n  border: 0;\n  border-right: 1px solid var(--editor-line);\n  border-radius: 0