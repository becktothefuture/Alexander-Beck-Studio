{"type":"frame-snapshot","snapshot":{"callId":"call@442","snapshotName":"after@call@442","pageId":"page@5ac7f9a24a92b9201198305ac0c32469","frameId":"frame@4ec3fbc20d1a4b45eea5215bf8b465f6","frameUrl":"http://localhost:8012/lab/about-narrative.html","doctype":"html","html":["HTML",{"lang":"en","class":"fonts-loading","data-shell-route":"about-narrative-lab"},["HEAD",{},["BASE",{"href":"http://localhost:8012/lab/about-narrative.html"}],"\n    ","\n\n    ","\n\n    ",["STYLE",{},"\n      html, body, #root {\n        width: 100%;\n        height: 100%;\n        margin: 0;\n        background: var(--abs-browser-chrome, #181818);\n        background-color: var(--abs-browser-chrome, #181818);\n      }\n    "],"\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0, viewport-fit=cover"}],"\n    ",["LINK",{"rel":"icon","href":"/images/favicon.ico","sizes":"any"}],"\n    ",["LINK",{"rel":"icon","type":"image/png","sizes":"32x32","href":"/images/favicon-32x32.png"}],"\n    ",["LINK",{"rel":"apple-touch-icon","href":"/images/apple-touch-icon.png"}],"\n    ",["TITLE",{},"About Narrative Lab - Alexander Beck Studio"],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.googleapis.com"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}],"\n    ",["LINK",{"href":"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap","rel":"stylesheet"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/css/tokens.css"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/css/normalize.css"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/css/main.css"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/css/portfolio.css"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/src/styles/base.css"}],"\n  ",["STYLE",{},"/* Dominant Tab utility material ------------------------------------------------\n   This opt-in layer is shared by the focused validation lab and study 11.\n   Production bars do not carry the data attribute and remain unchanged. */\n\n.button-bar[data-button-bar-material='dominant-tab'] {\n  /* Utility controls are deliberately subordinate to route controls: their\n     visible body is three quarters of the primary height, centred in the same\n     row so both groups share one optical axis. */\n  --dominant-primary-control-height: var(--shell-tab-height, 48px);\n  --dominant-secondary-control-height: calc(var(--dominant-primary-control-height) * 0.75);\n  --dominant-secondary-icon-size: calc(var(--dominant-secondary-control-height) * 0.5);\n  --dominant-utility-wall: var(\n    --playground-stage,\n    var(--dominant-wall, var(--button-bar-gasket-ground))\n  );\n  --dominant-utility-page: var(\n    --playground-page,\n    var(--dominant-page-bg, var(--dominant-utility-wall))\n  );\n  --dominant-utility-ink: var(\n    --playground-ink,\n    var(--dominant-page-ink, var(--button-bar-outer-ink))\n  );\n  --dominant-utility-muted: var(\n    --playground-key-ink,\n    var(--dominant-wall-ink, var(--button-bar-outer-ink-muted))\n  );\n  --button-bar-secondary-control-ink: var(--text-primary, var(--dominant-utility-ink));\n  --dominant-utility-control-bg: var(\n    --studio-window-bg,\n    var(--frame-inner-surface, var(--dominant-utility-wall))\n  );\n  --dominant-utility-control-bg-hover: var(--dominant-utility-control-bg);\n  --dominant-utility-control-ink: var(--button-bar-secondary-control-ink);\n  --dominant-utility-shadow: var(--dominant-press-shadow, rgba(var(--abs-rgb-black), 0.52));\n  --dominant-utility-light: var(--dominant-press-light, rgba(var(--abs-rgb-white), 0.42));\n  --dominant-sound-active: var(--dominant-utility-control-bg);\n  --dominant-sound-active-ink: var(--button-bar-sound-active-ink, var(--button-bar-secondary-control-ink));\n  --dominant-utility-pressed-rim: none;\n  --dominant-tab-pressed-rim: none;\n  --shell-tab-motion-ease: cubic-bezier(0.2, 0, 0, 1);\n  --button-bar-pill-motion-ease: cubic-bezier(0.2, 1.18, 0.24, 1);\n}\n\n:root[data-abs-theme='dark'] .button-bar[data-button-bar-material='dominant-tab'],\nbody.dark-mode .button-bar[data-button-bar-material='dominant-tab'] {\n  --dominant-utility-light: rgba(var(--abs-rgb-white), 0.22);\n}\n\n.button-bar[data-button-bar-material='dominant-tab'] .shell-tab {\n  transition:\n    background 160ms var(--shell-tab-motion-ease),\n    color 160ms var(--shell-tab-motion-ease),\n    transform 160ms var(--shell-tab-motion-ease);\n}\n\n.button-bar[data-button-bar-material='dominant-tab'] .button-bar__primary-buttons {\n  --button-bar-moving-pill-gap: var(--button-bar-primary-inner-gap, var(--shell-tab-gap, 16px));\n  --button-bar-moving-pill-home-width: var(--ui-icon-frame-size, var(--shell-tab-height, 48px));\n  --button-bar-moving-pill-label-width: calc(\n    (\n      100%\n      - var(--button-bar-moving-pill-home-width)\n      - var(--button-bar-moving-pill-gap)\n      - var(--button-bar-moving-pill-gap)\n      - var(--button-bar-moving-pill-gap)\n    )\n    / 3\n  );\n  --button-bar-moving-pill-portfolio-x: calc(\n    var(--button-bar-moving-pill-home-width)\n    + var(--button-bar-moving-pill-gap)\n  );\n  --button-bar-moving-pill-about-x: calc(\n    var(--button-bar-moving-pill-portfolio-x)\n    + var(--button-bar-moving-pill-label-width)\n    + var(--button-bar-moving-pill-gap)\n  );\n  --button-bar-moving-pill-contact-x: calc(\n    var(--button-bar-moving-pill-about-x)\n    + var(--button-bar-moving-pill-label-width)\n    + var(--button-bar-moving-pill-gap)\n  );\n  --button-bar-active-pill-x: 0px;\n  --button-bar-active-pill-width: var(--button-bar-moving-pill-home-width);\n  --button-bar-active-pill-height: 100%;\n  --button-bar-active-pill-y: 0px;\n  --button-bar-active-pill-bg: var(--button-bar-accent-home, var(--ball-4, #00695c));\n\n  position: relative;\n  isolation: isolate;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons[data-active-route='home'] {\n  --button-bar-active-pill-x: 0px;\n  --button-bar-active-pill-width: var(--button-bar-moving-pill-home-width);\n  --button-bar-active-pill-bg: var(--button-bar-accent-home, var(--ball-4, #00695c));\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons[data-active-route='portfolio'] {\n  --button-bar-active-pill-x: var(--button-bar-moving-pill-portfolio-x);\n  --button-bar-active-pill-width: var(--button-bar-moving-pill-label-width);\n  --button-bar-active-pill-bg: var(--button-bar-accent-portfolio, var(--ball-6, #d7ff2f));\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons[data-active-route='about'] {\n  --button-bar-active-pill-x: var(--button-bar-moving-pill-about-x);\n  --button-bar-active-pill-width: var(--button-bar-moving-pill-label-width);\n  --button-bar-active-pill-bg: var(--button-bar-accent-about, var(--ball-7, #0d5cb6));\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons[data-active-route='contact'] {\n  --button-bar-active-pill-x: var(--button-bar-moving-pill-contact-x);\n  --button-bar-active-pill-width: var(--button-bar-moving-pill-label-width);\n  --button-bar-active-pill-bg: var(--button-bar-accent-contact, var(--ball-8, #ffa000));\n}\n\n.button-bar[data-button-bar-material='dominant-tab'] .button-bar__active-pill {\n  position: absolute;\n  inset-block-start: var(--button-bar-active-pill-y);\n  inset-inline-start: var(--button-bar-active-pill-x);\n  z-index: 0;\n  display: block;\n  inline-size: var(--button-bar-active-pill-width);\n  block-size: var(--button-bar-active-pill-height);\n  border-radius: var(--abs-radius-pill);\n  background: var(--button-bar-active-pill-bg);\n  box-shadow: none;\n  pointer-events: none;\n  transition:\n    inset-inline-start 320ms var(--button-bar-pill-motion-ease),\n    inline-size 320ms var(--button-bar-pill-motion-ease),\n    background 180ms var(--shell-tab-motion-ease);\n  will-change: inset-inline-start, inline-size;\n  contain: layout paint style;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons:not([data-active-route])\n  .button-bar__active-pill {\n  display: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[data-route-tab='home'] {\n  --dominant-active-color: var(--button-bar-accent-home, var(--ball-4, #00695c));\n  --dominant-active-ink: var(--button-bar-accent-home-ink, #ffffff);\n  --shell-tab-route-accent: var(--dominant-active-color);\n  --shell-tab-text-active: var(--dominant-active-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[data-route-tab='portfolio'] {\n  --dominant-active-color: var(--button-bar-accent-portfolio, var(--ball-6, #d7ff2f));\n  --dominant-active-ink: var(--button-bar-accent-portfolio-ink, #101113);\n  --shell-tab-route-accent: var(--dominant-active-color);\n  --shell-tab-text-active: var(--dominant-active-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[data-route-tab='about'] {\n  --dominant-active-color: var(--button-bar-accent-about, var(--ball-7, #0d5cb6));\n  --dominant-active-ink: var(--button-bar-accent-about-ink, #ffffff);\n  --shell-tab-route-accent: var(--dominant-active-color);\n  --shell-tab-text-active: var(--dominant-active-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[data-route-tab='contact'] {\n  --dominant-active-color: var(--button-bar-accent-contact, var(--ball-8, #ffa000));\n  --dominant-active-ink: var(--button-bar-accent-contact-ink, #101113);\n  --shell-tab-route-accent: var(--dominant-active-color);\n  --shell-tab-text-active: var(--dominant-active-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:is(:hover, :focus-visible, :active),\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page'],\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page']:is(:hover, :focus-visible, :active) {\n  --shell-tab-motion-y: 0px;\n  --shell-tab-motion-scale: 1;\n  border-width: 0;\n  border-radius: var(--abs-radius-pill);\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab {\n  color: var(--dominant-utility-muted);\n  font-weight: 560;\n  letter-spacing: normal;\n  background: transparent;\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):is(:hover, :focus-visible):not(:active) {\n  color: var(--dominant-utility-muted);\n  outline: none;\n  background: transparent;\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):active {\n  color: var(--dominant-utility-ink);\n  outline: none;\n  background: transparent;\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page'],\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page']:is(:hover, :focus-visible, :active) {\n  color: var(--dominant-active-ink);\n  cursor: default;\n  background: transparent;\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page']::before {\n  content: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab\n  :is(.shell-tab__icon, .shell-tab__label),\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:is(:hover, :focus-visible, :active)\n  :is(.shell-tab__icon, .shell-tab__label),\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page']\n  :is(.shell-tab__icon, .shell-tab__label) {\n  color: currentColor;\n  font-weight: 560;\n  letter-spacing: normal;\n  filter: none;\n  text-shadow: none;\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:is(:active, [aria-current='page'])\n  :is(.shell-tab__icon, .shell-tab__label) {\n  transform: translate3d(0, calc(0px - var(--shell-tab-motion-y, 0px)), 0);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__secondary-buttons {\n  --shell-control-icon-size: var(--dominant-secondary-icon-size);\n  align-self: center;\n  align-items: center;\n  block-size: var(--dominant-primary-control-height);\n  min-height: var(--dominant-primary-control-height);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__secondary-button.shell-tab,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__secondary-button.shell-tab:is(:hover, :focus-visible, :active) {\n  --shell-tab-motion-y: 0px;\n  --shell-tab-motion-scale: 1;\n  border-width: 0;\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 0 var(--dominant-secondary-control-height);\n  inline-size: var(--dominant-secondary-control-height);\n  block-size: var(--dominant-secondary-control-height);\n  min-width: var(--dominant-secondary-control-height);\n  min-height: var(--dominant-secondary-control-height);\n  aspect-ratio: 1 / 1;\n  padding: 0;\n}\n\n/* Sound keeps the same window-interior body in both states. */\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab:not([data-enabled='true']),\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab:not([data-enabled='true']):not(:hover):not(:focus-visible):not(:active) {\n  color: var(--button-bar-secondary-control-ink);\n  background: var(--dominant-utility-control-bg);\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab:not([data-enabled='true']):is(:hover, :focus-visible, :active) {\n  color: var(--button-bar-secondary-control-ink);\n  outline: none;\n  background: var(--dominant-utility-control-bg-hover);\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab[data-enabled='true'],\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab[data-enabled='true']:is(:hover, :focus-visible, :active) {\n  --shell-tab-text-active: var(--dominant-sound-active-ink);\n  color: var(--dominant-sound-active-ink);\n  outline: none;\n  background: var(--dominant-sound-active);\n  box-shadow: none;\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab\n  .button-bar__secondary-icon.shell-tab__icon,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab:is(:hover, :focus-visible, :active)\n  .button-bar__secondary-icon.shell-tab__icon {\n  display: inline-grid;\n  place-items: center;\n  inline-size: var(--dominant-secondary-icon-size);\n  block-size: var(--dominant-secondary-icon-size);\n  margin: 0;\n  color: currentColor;\n  font-size: var(--dominant-secondary-icon-size);\n  line-height: 1;\n  filter: none;\n  text-shadow: none;\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle\n  .button-bar__secondary-icon::before {\n  display: block;\n  line-height: 1;\n}\n\n/* The switch is one fixed track with two mathematically symmetric endpoints. */\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle.shell-tab,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle.shell-tab:is(:hover, :focus-visible, :active) {\n  --button-bar-switch-height: var(--dominant-secondary-control-height);\n  --button-bar-switch-padding: 4px;\n  box-sizing: border-box;\n  flex: 0 0 calc(var(--dominant-secondary-control-height) * 10 / 7);\n  inline-size: calc(var(--dominant-secondary-control-height) * 10 / 7);\n  block-size: var(--dominant-secondary-control-height);\n  min-width: calc(var(--dominant-secondary-control-height) * 10 / 7);\n  min-height: var(--dominant-secondary-control-height);\n  color: var(--button-bar-secondary-control-ink);\n  border-width: 0;\n  border-radius: var(--button-bar-switch-radius);\n  outline: none;\n  outline-offset: 0;\n  background: var(--dominant-utility-control-bg);\n  box-shadow: none;\n  transform: none;\n}\n\n/* Hover and keyboard focus can reveal material, but idle label ink does not\n   change until the button is physically pressed. */\n.button-bar.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):is(:hover, :focus-visible):not(:active),\n.button-bar.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):is(:hover, :focus-visible):not(:active)\n  :is(.shell-tab__icon, .shell-tab__label) {\n  color: var(--dominant-utility-muted);\n}\n\n.button-bar.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):active,\n.button-bar.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):active\n  :is(.shell-tab__icon, .shell-tab__label) {\n  color: var(--dominant-utility-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle.shell-tab:is(:hover, :focus-visible, :active) {\n  background: var(--dominant-utility-control-bg-hover);\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle[data-state='light']\n  .button-bar__theme-thumb {\n  inset-inline-start: var(--button-bar-switch-padding);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle[data-state='dark']\n  .button-bar__theme-thumb {\n  inset-inline-start: calc(\n    100% - var(--button-bar-switch-padding) - var(--button-bar-switch-thumb-size)\n  );\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle\n  .button-bar__theme-thumb,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle:is(:hover, :focus-visible, :active)\n  .button-bar__theme-thumb {\n  position: absolute;\n  color: var(--button-bar-secondary-control-ink);\n  border-radius: var(--button-bar-switch-thumb-radius);\n  background: var(--dominant-utility-control-bg);\n  box-shadow: none;\n  filter: none;\n  text-shadow: none;\n  transform: translate3d(0, -50%, 0);\n  transition:\n    inset-inline-start 160ms var(--shell-tab-motion-ease),\n    background 160ms var(--shell-tab-motion-ease),\n    color 160ms var(--shell-tab-motion-ease);\n}\n\n@media (max-width: 767px), (hover: none) and (pointer: coarse) {\n  .button-bar[data-button-bar-material='dominant-tab'] .button-bar__primary-buttons {\n    --button-bar-moving-pill-home-width: var(--shell-tab-height, 48px);\n  }\n}\n\n@media (max-width: 340px) {\n  .button-bar[data-button-bar-material='dominant-tab'] .button-bar__primary-buttons {\n    --button-bar-moving-pill-home-width: 46px;\n  }\n}\n\n@media (min-width: 601px) and (max-width: 680px) {\n  .button-bar[data-button-bar-material='dominant-tab']\n    .button-bar__primary-buttons[data-active-route='home'] {\n    --button-bar-active-pill-height: var(--shell