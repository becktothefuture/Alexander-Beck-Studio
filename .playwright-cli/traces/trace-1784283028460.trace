t-editor-shape-catalog strong,\n.about-editor-shape-catalog small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.about-editor-shape-catalog small { color: var(--editor-muted); font-size: 9px; }\n\n.about-editor-try {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  display: grid;\n  grid-template-columns: 1fr auto auto;\n  align-items: center;\n  gap: 5px;\n  padding: 7px;\n  border: 1px solid color-mix(in srgb, var(--editor-accent) 55%, var(--editor-line));\n  border-radius: 6px;\n  background: var(--editor-bg);\n}\n\n.about-editor-try button { min-height: 26px; padding: 3px 7px; }\n.about-editor-try .is-primary { color: #111; background: var(--editor-accent); }\n\n.about-editor-diagnostics {\n  display: grid;\n  gap: 5px;\n  margin-top: 15px;\n  padding-top: 12px;\n  border-top: 1px solid var(--editor-line);\n}\n\n.about-editor-diagnostics > div,\n.about-editor-diagnostics.is-clear {\n  display: flex;\n  align-items: flex-start;\n  gap: 6px;\n  padding: 7px;\n  border: 1px solid var(--editor-line);\n  border-radius: 5px;\n  color: var(--editor-muted);\n}\n\n.about-editor-diagnostics strong,\n.about-editor-diagnostics small { display: block; }\n.about-editor-diagnostics svg { flex: 0 0 auto; width: 13px; height: 13px; margin-top: 1px; }\n.about-editor-diagnostics strong { color: var(--editor-ink); font-weight: 520; }\n.about-editor-diagnostics small { margin-top: 2px; font-family: var(--abs-font-mono); }\n.about-editor-diagnostics .is-error { border-color: color-mix(in srgb, #e05d5d 50%, var(--editor-line)); }\n\n.about-editor-bottom {\n  position: absolute;\n  z-index: 8;\n  top: auto;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  height: var(--about-editor-timeline);\n  border-top: 1px solid var(--editor-line-strong);\n  background: var(--editor-panel);\n  box-shadow: 0 -18px 44px rgb(0 0 0 / 36%);\n  transform: translateY(0);\n  transform-origin: bottom;\n  opacity: 1;\n  visibility: visible;\n  transition:\n    transform 180m