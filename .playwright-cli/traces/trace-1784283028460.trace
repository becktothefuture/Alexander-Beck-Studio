00px; --fragment-opacity: 0.0000;"},"This stage of an idea has always captivated me."],["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"complexity-listen","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"I learn what is there and what matters to the people involved."],["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"complexity-focus","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"Then I look for the organising thought that can bring it into focus."]]]]],["SECTION",{"id":"about-narrative-background","class":"about-narrative-section about-narrative-section--editorial about-narrative-section--reading","data-narrative-section":"background","data-section-index":"2","aria-labelledby":"about-narrative-background-title","data-text-movement":"vertical","style":"--section-duration-wu: 2.9; --section-duration-mobile-wu: 3.6;"},["DIV",{"class":"about-narrative-editorial-inner"},["H2",{"id":"about-narrative-background-title","class":"about-narrative-editorial-title","data-editorial-line":"true","data-editorial-block":"background-title","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"Perhaps that is why I have always been drawn to the space between ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"blue"},"aesthetics and technology"],"."],["P",{"class":"about-narrative-editorial-copy","data-editorial-line":"true","data-editorial-block":"background-practice","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"I studied ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"blue"},"Communication Design"],", then built my work across digital products, web design, identity, interfaces, motion, and creative uses of ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"orange"},"AI and technology"],"."],["P",{"class":"about-narrative-editorial-copy","data-editorial-line":"true","data-editorial-block":"background-curiosity","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"At the centre of it is ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"green"},"curiosity"],": ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"blue"},"how things work"],", how they feel and how those qualities can strengthen one another."],["P",{"class":"about-narrative-editorial-copy","data-editorial-line":"true","data-editorial-block":"background-technology","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"This is what draws me to ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"orange"},"emerging technology"],". I see the opportunity for it to play a useful role in people’s lives once it has been deconstructed, ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"blue"},"made tangible"],", made visual and ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"green"},"made interactive"]," enough to resonate."],["P",{"class":"about-narrative-editorial-copy","data-editorial-line":"true","data-editorial-block":"background-context","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"That curiosity has shaped my work with ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"orange"},"technology start-ups"]," and ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"blue"},"creative agencies"],", on ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"green"},"ambitious projects"]," across identity, finance, mobility, healthcare and digital products."],["UL",{"class":"about-narrative-client-logos","aria-label":"Selected clients","data-editorial-line":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},["LI",{"data-client-logo":"yoti"},"Yoti"],["LI",{"data-client-logo":"s-p-global"},"S&P Global"],["LI",{"data-client-logo":"bentley"},"Bentley"],["LI",{"data-client-logo":"sunexpress"},"SunExpress"],["LI",{"data-client-logo":"mccann"},"McCann"],["LI",{"data-client-logo":"american-heart-association"},"American Heart Association"]]]],["SECTION",{"id":"about-narrative-practice-reveal","class":"about-narrative-section about-narrative-section--spatial about-narrative-section--constellation","data-narrative-section":"practice-reveal","data-section-index":"3","aria-label":"The practice comes into view","data-text-movement":"spatial","style":"--section-duration-wu: 1.8; --section-duration-mobile-wu: 1.75;"}],["SECTION",{"id":"about-narrative-disciplines","class":"about-narrative-section about-narrative-section--editorial about-narrative-section--disciplines","data-narrative-section":"disciplines","data-section-index":"4","aria-labelledby":"about-narrative-disciplines-title","data-text-movement":"vertical","style":"--section-duration-wu: 3.2; --section-duration-mobile-wu: 4;"},["DIV",{"class":"about-narrative-editorial-inner"},["H2",{"id":"about-narrative-disciplines-title","class":"about-narrative-editorial-title","data-editorial-line":"true","data-editorial-block":"disciplines-title","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"Each brings a ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"green"},"different way of thinking"]," to the work."],["P",{"class":"about-narrative-editorial-copy","data-editorial-line":"true","data-editorial-block":"disciplines-practice","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"Their different perspectives help me understand an opportunity, shape how an experience works, give it character, make behaviour and feeling tangible, and explore directly through code, tools and working systems."],["P",{"class":"about-narrative-editorial-copy","data-editorial-line":"true","data-editorial-block":"disciplines-ai","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"AI runs through all of this as a creative material and a practical capability, expanding what I can explore, generate and build."],["P",{"class":"about-narrative-editorial-copy","data-editorial-line":"true","data-editorial-block":"disciplines-synthesis","data-world-influence":"true","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"Moving between disciplines lets one kind of thinking affect another. An insight can reshape a product. A technical experiment can unlock a visual language. Motion can make an interaction easier to understand."]]],["SECTION",{"id":"about-narrative-bringing-life","class":"about-narrative-section about-narrative-section--spatial about-narrative-section--living-field","data-narrative-section":"bringing-life","data-section-index":"5","aria-labelledby":"about-narrative-bringing-life-title","data-text-movement":"spatial","style":"--section-duration-wu: 3.1; --section-duration-mobile-wu: 2.85;"},["DIV",{"class":"about-narrative-spatial-stage","data-text-movement":"spatial"},["DIV",{"class":"about-narrative-spatial-copy"},["H2",{"id":"about-narrative-bringing-life-title","class":"about-narrative-spatial-title","aria-label":"As those ways of thinking begin to influence one another, complexity starts to cohere. It takes on clear form and intuitive behaviour. It gains a character people can trust. It becomes something they can relate to, interact with and feel. That is what excites me about bringing an idea to life.","data-primary-copy":"true"},["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"life-momentum","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"As those ways of thinking begin to influence one another, complexity starts to cohere."],["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"life-form","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"It takes on clear form and intuitive behaviour."],["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"life-character","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"It gains a character people can trust."],["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"life-feel","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"It becomes something they can relate to, interact with and feel."],["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"life-meaning","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"That is what excites me about bringing an idea to life."]]]]],["SECTION",{"id":"about-narrative-role","class":"about-narrative-section about-narrative-section--editorial about-narrative-section--exit","data-narrative-section":"role","data-section-index":"6","aria-labelledby":"about-narrative-role-title","data-text-movement":"vertical","style":"--section-duration-wu: 1.35; --section-duration-mobile-wu: 1.5;"},["DIV",{"class":"about-narrative-editorial-inner"},["H2",{"id":"about-narrative-role-title","class":"about-narrative-editorial-title","data-editorial-line":"true","data-editorial-block":"role-highlight","data-primary-copy":"true","style":"--editorial-reveal: 0.0000; --editorial-blur: 3.00px; --editorial-y: 12.00px;"},"That is the work I do with ambitious teams: bringing ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"blue"},"design"],", ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"green"},"creative technology"]," and ",["STRONG",{"class":"about-narrative-editorial-emphasis","data-emphasis-tone":"orange"},"AI"]," together to give early ideas a form people can understand, trust and want to engage with."]]],["SECTION",{"id":"about-narrative-epilogue","class":"about-narrative-section about-narrative-section--spatial about-narrative-section--closing about-narrative-section--finale","data-narrative-section":"epilogue","data-section-index":"7","aria-labelledby":"about-narrative-epilogue-title","data-text-movement":"spatial","style":"--section-duration-wu: 2.5; --section-duration-mobile-wu: 2.35; --spatial-context-opacity: 0.0000; --spatial-context-y: 16.00px;"},["DIV",{"class":"about-narrative-spatial-stage about-narrative-finale-stage"},["DIV",{"class":"about-narrative-spatial-copy about-narrative-finale-copy"},["H2",{"id":"about-narrative-epilogue-title","class":"about-narrative-spatial-title","aria-label":"If you are building something new, let’s talk.","data-primary-copy":"true"},["SPAN",{"class":"about-narrative-spatial-fragment","data-text-cue":"epilogue-invitation","data-text-movement":"spatial","aria-hidden":"true","style":"--fragment-x: 0.00px; --fragment-y: -110.00px; --fragment-z: -360.00px; --fragment-scale: 0.7800; --fragment-blur: 22.00px; --fragment-opacity: 0.0000;"},"If you are building something new, let’s talk."]],["DIV",{"class":"about-narrative-bust-interaction","data-active":"false","role":"group","aria-label":"Rotate the point-cloud bust horizontally","tabindex":"-1"}],["DIV",{"class":"about-narrative-finale-cta is-actions-only"},["NAV",{"class":"about-narrative-cta","aria-label":"Contact Alexander"},["A",{"href":"mailto:alexander@beck.fyi"},"Email"],["A",{"href":"https://www.linkedin.com/in/thisisbeck/","target":"_blank","rel":"noreferrer"},"LinkedIn"]]]]]]]]]]],["DIV",{"id":"shell-hero-slot","class":"shell-hero-slot shell-transition-surface shell-transition-surface--hero"},["DIV",{"class":"shell-hero-surface"}]],["DIV",{"id":"custom-cursor","aria-hidden":"true","style":"display: none; opacity: 1; margin-left: 0px; margin-top: 0px; border-radius: 50%; width: 24px; height: 24px; transform: translate(-50%, -50%) scale(0);"},["SPAN",{"class":"abs-cursor-label","aria-hidden":"true"}]]],["DIV",{"class":"frame-vignette","aria-hidden":"true"}],["DIV",{"class":"simulation-contrast-veil","aria-hidden":"true"}],["DIV",{"class":"fade-content page-content ui-layer"},["DIV",{"id":"app-frame","class":"ui-layer-wrapper","style":"opacity: 1; visibility: visible; transform: translateZ(0px);"},["DIV",{"id":"shell-route-slot","class":"shell-route-slot"},["DIV",{"class":"shell-route-content-root route-ui-layer"},["DIV",{"class":"shell-transition-surface shell-transition-surface--chrome"}],["DIV",{"class":"shell-transition-surface shell-transition-surface--secondary"}]]],["DIV",{"class":"shell-transition-surface shell-transition-surface--footer"},["FOOTER",{"class":"ui-bottom portfolio-footer","data-portfolio-ui":"true"},["DIV",{"class":"ui-meta-row"}