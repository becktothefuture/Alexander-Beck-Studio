ming-warning {\n  margin: 7px 0 0;\n  padding: 7px 8px;\n  color: color-mix(in srgb, var(--editor-accent) 82%, white 18%);\n  border: 1px solid color-mix(in srgb, var(--editor-accent) 38%, var(--editor-line));\n  border-radius: 4px;\n  background: color-mix(in srgb, var(--editor-accent) 7%, var(--editor-field));\n  line-height: 1.45;\n}\n\n.about-editor-lock {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 6px;\n  margin-bottom: 9px;\n  padding: 8px;\n  color: var(--editor-muted);\n  border: 1px solid color-mix(in srgb, var(--editor-accent) 45%, var(--editor-line));\n  border-radius: 6px;\n}\n.about-editor-lock button { grid-column: 1 / -1; min-height: 26px; }\n.about-editor-lock > svg { width: 14px; height: 14px; color: var(--editor-accent); }\n.about-editor-timing-note { margin: 2px 0 7px; }\n.about-editor-timing-note strong { color: var(--editor-ink); font-weight: 600; }\n\n.about-editor-camera-recipes {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 3px;\n  margin: 7px 0 10px;\n}\n\n.about-editor-camera-recipes button { min-height: 27px; padding: 3px; font-size: 9px; }\n\n.about-editor-block,\n.about-editor-modifier {\n  margin: 8px 0;\n  padding: 8px;\n  border: 1px solid var(--editor-line);\n  border-radius: 6px;\n}\n\n.about-editor-block > div:first-child,\n.about-editor-modifier > div:first-child {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 5px;\n  color: var(--editor-muted);\n}\n\n.about-editor-emphasis-controls {\n  display: grid;\n  gap: 5px;\n  padding: 7px 0;\n  border-top: 1px solid var(--editor-line);\n}\n\n.about-editor-emphasis-controls > span {\n  color: var(--editor-muted);\n}\n\n.about-editor-emphasis-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 72px 26px;\n  gap: 4px;\n}\n\n.about-editor-emphasis-row input,\n.about-editor-emphasis-row select {\n  min-width: 0;\n}\n\n.about-editor-emphasis-row button,\n.about-editor-emphasis-co