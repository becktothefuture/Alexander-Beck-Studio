-top: clamp(34rem, 92cqh, 52rem);\n  padding-bottom: clamp(8rem, 18cqh, 13rem);\n}\n\n.about-narrative-section--editorial {\n  display: flex;\n  align-items: center;\n  min-height: calc(var(--section-duration-wu, 1.2) * var(--narrative-viewport-height, 100cqh));\n  padding: clamp(6rem, 12vw, 11rem) clamp(1.25rem, 9vw, 9rem);\n}\n\n.about-narrative-section--opening-continuation {\n  min-height: calc(1.1 * var(--narrative-viewport-height, 100cqh));\n}\n\n.about-narrative-section--opening-continuation .about-narrative-editorial-copy {\n  max-width: 48ch;\n  margin: 0 auto;\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.02em;\n  line-height: 1.48;\n  text-align: center;\n  text-wrap: balance;\n}\n\n.about-narrative-section--exit {\n  align-items: center;\n}\n\n.about-narrative-section--exit .about-narrative-editorial-title {\n  max-width: 48ch;\n  margin-bottom: 0;\n}\n\n.about-narrative-editorial-inner {\n  width: min(100%, var(--about-reading-width));\n  margin-inline: auto;\n}\n\n.about-narrative-editorial-title {\n  max-width: 48ch;\n  margin: 0 0 clamp(2.75rem, 5vw, 4.5rem);\n  color: var(--text-primary);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.02em;\n  line-height: 1.48;\n  text-wrap: balance;\n}\n\n[data-editorial-line] {\n  --editorial-reveal: 0;\n  --editorial-blur: 3px;\n  --editorial-y: 12px;\n  opacity: var(--editorial-reveal);\n  filter: blur(var(--editorial-blur));\n  transform: translate3d(0, var(--editorial-y), 0);\n  will-change: opacity, filter, transform;\n}\n\n.about-narrative-vertical-title[data-editorial-line] {\n  transform: translate3d(-50%, calc(-50% + var(--editorial-y, 12px)), 0);\n}\n\n.about-narrative-visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.about-narrative-editorial-copy {\n  max-width: 48ch;\n  margin: 0 0 clamp(1.6rem, 3vw, 2.4rem);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.018em;\n  line-height: 1.52;\n  text-wrap: pretty;\n}\n\n.about-narrative-editorial-copy.is-highlighted {\n  max-width: 48ch;\n  margin-block: clamp(2.75rem, 5vw, 4.5rem);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  line-height: 1.48;\n}\n\n.about-narrative-editorial-detail {\n  max-width: 48ch;\n  margin: clamp(2rem, 4vw, 3.5rem) 0 0;\n  color: var(--text-muted);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.015em;\n  line-height: 1.55;\n}\n\n.about-narrative-editorial-list {\n  width: min(100%, 42rem);\n  margin: clamp(2.75rem, 5vw, 4.5rem) 0;\n}\n\n.about-narrative-editorial-list__label {\n  margin: 0 0 1rem;\n  color: var(--text-muted);\n  font-family: var(--abs-font-mono);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: 0.035em;\n  line-height: 1.35;\n  text-transform: uppercase;\n}\n\n.about-narrative-editorial-list ul,\n.about-narrative-discipline-list {\n  padding: 0;\n  margin: 0;\n  list-style: none;\n}\n\n.about-narrative-editorial-list li {\n  padding: 0.9rem 0;\n  border-top: 1px solid color-mix(in srgb, var(--text-primary) 16%, transparent);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.025em;\n  line-height: 1.35;\n}\n\n.about-narrative-editorial-list li:last-child {\n  border-bottom: 1px solid color-mix(in srgb, var(--text-primary) 16%, transparent);\n}\n\n.about-narrative-editorial-clients {\n  max-width: 48ch;\n  margin: clamp(2.75rem, 5vw, 4.5rem) 0 0;\n  color: var(--text-muted);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--ab