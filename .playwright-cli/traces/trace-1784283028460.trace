nter]\n            - button \"continue\" [ref=f9e314] [cursor=pointer]\n            - generic [ref=f9e315]:\n              - button \"bust\" [ref=f9e316] [cursor=pointer]\n              - button \"Invitation World transition start\" [ref=f9e317] [cursor=pointer]\n              - button \"Invitation World transition end\" [ref=f9e318] [cursor=pointer]\n          - generic [ref=f9e319]:\n            - generic [ref=f9e320]:\n              - button \"Spatial text at 23% · travels 0–46% · I help shape complex ideas into emotionally compelling experiences.\" [ref=f9e321] [cursor=pointer]\n              - button \"Spatial text at 77% · travels 50–100% · At the start, an idea can feel like everything at once.\" [ref=f9e322] [cursor=pointer]\n            - generic [ref=f9e323]:\n              - button \"Spatial text at 24% · travels 12–35% · It has to be useful, original, technically possible and emotionally right.\" [ref=f9e324] [cursor=pointer]\n              - button \"Spatial text at 41% · travels 29–52% · Its shape is still fragmented.\" [ref=f9e325] [cursor=pointer]\n              - button \"Spatial text at 57% · travels 46–69% · This stage of an idea has always captivated me.\" [ref=f9e326] [cursor=pointer]\n              - button \"Spatial text at 75% · travels 63–86% · I learn what is there and what matters to the people involved.\" [ref=f9e327] [cursor=pointer]\n              - button \"Spatial text at 93% · travels 80–100% · Then I look for the organising thought that can bring it into focus.\" [ref=f9e328] [cursor=pointer]\n            - button \"Vertical · 6 blocks\" [ref=f9e330] [cursor=pointer]\n            - button \"Discipline reveal from 32% to 290%\" [ref=f9e332] [cursor=pointer]: Discipline reveal\n            - button \"Vertical · 4 blocks\" [ref=f9e334] [cursor=pointer]\n            - generic [ref=f9e335]:\n              - button \"Spatial text at 8% · travels 0–22% · As those ways of thinking begin to influence one another, complexity starts to cohere.\" [ref=f9e336] [cursor=pointer]\n              - button \"Spatial text at 28% · travels 14–42% · It takes on clear form and intuitive behaviour.\" [ref=f9e337] [cursor=pointer]\n              - button \"Spatial text at 48% · travels 34–62% · It gains a character people can trust.\" [ref=f9e338] [cursor=pointer]\n              - button \"Spatial text at 68% · travels 54–82% · It becomes something they can relate to, interact with and feel.\" [ref=f9e339] [cursor=pointer]\n              - button \"Spatial text at 91% · travels 76–100% · That is what excites me about bringing an idea to life.\" [ref=f9e340] [cursor=pointer]\n            - button \"Vertical · 1 blocks\" [ref=f9e342] [cursor=pointer]\n            - button \"Spatial text at 34% · travels 7–100% · If you are building something new, let’s talk.\" [ref=f9e344] [cursor=pointer]\n          - generic [ref=f9e345]:\n            - button [ref=f9e347] [cursor=pointer]\n            - button [ref=f9e349] [cursor=pointer]\n            - button [ref=f9e351] [cursor=pointer]\n            - button [ref=f9e353] [cursor=pointer]\n            - button [ref=f9e355] [cursor=pointer]\n            - button [ref=f9e357] [cursor=pointer]\n            - button [ref=f9e359] [cursor=pointer]\n            - generic [ref=f9e360]:\n              - button \"horizontal-spin\" [ref=f9e361] [cursor=pointer]\n              - button \"Invitation interaction activation keyframe\" [ref=f9e362] [cursor=pointer]"}}
