\n  font-style: normal;\n}\n\n.about-editor-range-values > i { padding-bottom: 7px; }\n.about-editor-range-property > small { color: var(--editor-muted); line-height: 1.45; }\n.about-editor-depth-help strong { color: var(--editor-ink); font-weight: 600; }\n\n.about-editor-inline-actions {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  margin-bottom: 8px;\n}\n\n.about-editor-inline-actions button,\n.about-editor-wide-action,\n.about-editor-danger {\n  min-height: 28px;\n  padding: 5px 8px;\n}\n\n.about-editor-wide-action { width: 100%; margin-top: 8px; }\n.about-editor-danger { width: 100%; margin-top: 12px; color: #e05d5d !important; }\n.about-editor-help { color: var(--editor-muted); line-height: 1.5; }\n.about-editor-timing-warning {\n  margin: 7px 0 0;\n  padding: 7px 8px;\n  color: color-mix(in srgb, var(--editor-accent) 82%, white 18%);\n  border: 1px solid color-mix(in srgb, var(--editor-accent) 38%, var(--editor-line));\n  border-radius: 4px;\n  background: color-mix(in srgb, var(--editor-accent) 7%, var(--editor-field));\n  line-height: 1.45;\n}\n\n.about-editor-lock {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 6px;\n  margin-bottom: 9px;\n  padding: 8px;\n  color: var(--editor-muted);\n  border: 1px solid color-mix(in srgb, var(--editor-accent) 45%, var(--editor-line));\n  border-radius: 6px;\n}\n.about-editor-lock button { grid-column: 1 / -1; min-height: 26px; }\n.about-editor-lock > svg { width: 14px; height: 14px; color: var(--editor-accent); }\n.about-editor-timing-note { margin: 2px 0 7px; }\n.about-editor-timing-note strong { color: var(--editor-ink); font-weight: 600; }\n\n.about-editor-camera-recipes {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 3px;\n  margin: 7px 0 10px;\n}\n\n.about-editor-camera-recipes button { min-height: 27px; padding: 3px; font-size: 9px; }\n\n.about-editor-block,\n.about-editor-modifier {\n  margin: 8px 0;\n  padding: 8px;\n  border: 1px solid var(--editor-line);\n  border-radius: 6px;\n}\n\n.about-editor-block > div:first-child,\n.about-editor-modifier > div:first-child {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 5px;\n  color: var(--editor-muted);\n}\n\n.about-editor-emphasis-controls {\n  display: grid;\n  gap: 5px;\n  padding: 7px 0;\n  border-top: 1px solid var(--editor-line);\n}\n\n.about-editor-emphasis-controls > span {\n  color: var(--editor-muted);\n}\n\n.about-editor-emphasis-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 72px 26px;\n  gap: 4px;\n}\n\n.about-editor-emphasis-row input,\n.about-editor-emphasis-row select {\n  min-width: 0;\n}\n\n.about-editor-emphasis-row button,\n.about-editor-emphasis-controls > button {\n  min-height: 26px;\n}\n\n.about-editor-discipline-items {\n  display: grid;\n  gap: 5px;\n  padding-block: 6px;\n}\n\n.about-editor-discipline-item {\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr) 68px 46px;\n  align-items: center;\n  gap: 4px;\n}\n\n.about-editor-discipline-item code {\n  color: var(--editor-muted);\n  font-size: 8px;\n}\n\n.about-editor-discipline-item input,\n.about-editor-discipline-item select {\n  min-width: 0;\n}\n\n.about-editor-discipline-palette {\n  display: flex;\n  min-width: 0;\n  align-items: center;\n  gap: 4px;\n}\n\n.about-editor-discipline-palette i {\n  flex: 0 0 auto;\n  width: 8px;\n  height: 8px;\n  border: 1px solid color-mix(in srgb, var(--editor-ink) 28%, transparent);\n  border-radius: 50%;\n}\n\n.about-editor-discipline-palette code {\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.about-editor-discipline-item > span {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 2px;\n}\n\n.about-editor-discipline-item button {\n  min-height: 24px;\n  padding: 0;\n}\n\n.about-editor-modifier > div:first-child span { display: flex; align-items: center; gap: 3px; }\n.about-editor-modifier > div:first-child button { width: 20px; height: 20px; padding: 0; }\n\n.about-editor-block code,\n.about-editor-inline-actions code { font-family: var(--abs-font-mono); }\n\n.about-editor-shape-catalog {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 5px;\n  margin-bottom: 9px;\n}\n\n.about-editor-shape-catalog button {\n  display: grid;\n  grid-template-columns: 23px 1fr;\n  align-items: center;\n  gap: 6px;\n  min-height: 46px;\n  padding: 6px;\n  text-align: left;\n}\n\n.about-editor-shape-catalog button > i {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: radial-gradient(circle at 35% 35%, var(--editor-world), transparent 72%);\n  box-shadow: inset 0 0 0 1px var(--editor-line-strong);\n}\n\n.about-editor-shape-catalog span { min-width: 0; }\n.about-editor-shape-catalog strong,\n.about-editor-shape-catalog small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.about-editor-shape-catalog small { color: var(--editor-muted); font-size: 9px; }\n\n.about-editor-try {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  display: grid;\n  grid-template-columns: 1fr auto auto;\n  align-items: center;\n  gap: 5px;\n  padding: 7px;\n  border: 1px solid color-mix(in srgb, var(--editor-accent) 55%, var(--editor-line));\n  border-radius: 6px;\n  background: var(--editor-bg);\n}\n\n.about-editor-try button { min-height: 26px; padding: 3px 7px; }\n.about-editor-try .is-primary { color: #111; background: var(--editor-accent); }\n\n.about-editor-diagnostics {\n  display: grid;\n  gap: 5px;\n  margin-top: 15px;\n  padding-top: 12px;\n  border-top: 1px solid var(--editor-line);\n}\n\n.about-editor-diagnostics > div,\n.about-editor-diagnostics.is-clear {\n  display: flex;\n  align-items: flex-start;\n  gap: 6px;\n  padding: 7px;\n  border: 1px solid var(--editor-line);\n  border-radius: 5px;\n  color: var(--editor-muted);\n}\n\n.about-editor-diagnostics strong,\n.about-editor-diagnostics small { display: block; }\n.about-editor-diagnostics svg { flex: 0 0 auto; width: 13px; height: 13px; margin-top: 1px; }\n.about-editor-diagnostics strong { color: var(--editor-ink); font-weight: 520; }\n.about-editor-diagnostics small { margin-top: 2px; font-family: var(--abs-font-mono); }\n.about-editor-diagnostics .is-error { border-color: color-mix(in srgb, #e05d5d 50%, var(--editor-line)); }\n\n.about-editor-bottom {\n  position: absolute;\n  z-index: 8;\n  top: auto;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  height: var(--about-editor-timeline);\n  border-top: 1px solid var(--editor-line-strong);\n  background: var(--editor-panel);\n  box-shadow: 0 -18px 44px rgb(0 0 0 / 36%);\n  transform: translateY(0);\n  transform-origin: bottom;\n  opacity: 1;\n  visibility: visible;\n  transition:\n    transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),\n    opacity 120ms ease,\n    visibility 0s linear;\n}\n\n.about-editor[data-timeline-open='false'] .about-editor-bottom {\n  transform: translateY(10px) scaleY(0.96);\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  transition:\n    transform 150ms cubic-bezier(0.4, 0, 1, 1),\n    opacity 100ms ease,\n    visibility 0s linear 150ms;\n}\n\n.about-editor-contextbar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  height: 27px;\n  padding: 0 7px;\n  border-bottom: 1px solid var(--editor-line);\n  white-space: nowrap;\n}\n\n.about-editor-contextbar > span:first-child { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }\n.about-editor-contextbar strong { color: var(--editor-ink); font-family: var(--abs-font-sans); font-size: 11px; letter-spacing: 0; text-transform: none; }\n.about-editor-contextbar button { height: 21px; padding: 1px 6px; }\n.about-editor-contextbar .about-editor-delete-key { display: flex; align-items: center; gap: 4px; color: #ff8f8f; }\n.about-editor-contextbar .about-editor-delete-key > svg { width: 11px; height: 11px; }\n.about-editor-contextbar select { min-height: 22px; height: 22px; padding-block: 2px; }\n.about-editor-hud { color: var(--editor-camera) !important; }\n\n.about-editor-timeline {\n  display: grid;\n  grid-template-columns: 104px minmax(0, 1fr);\n  height: calc(100% - 28px);\n  overflow: hidden;\n}\n\n.about-editor-lane-labels {\n  display: grid;\n  grid-template-rows: repeat(5, 1fr);\n  border-right: 1px solid var(--editor-line-strong);\n}\n\n.about-editor-lane-labels > * {\n  display: flex;\n  align-items: center;\n  padding-left: 9px;\n  border-bottom: 1px solid var(--editor-line);\n}\n\n.about-editor-lane-labels > *::before {\n  width: 5px;\n  height: 5px;\n  margin-right: 7px;\n  border-radius: 50%;\n  background: currentColor;\n  content: '';\n}\n\n.about-editor-lane-labels > button {\n  width: 100%;\n  border: 0 !important;\n  border-radius: 0;\n  color: inherit;\n  text-align: left;\n}\n\n.about-editor-lane-labels > button:hover,\n.about-editor-lane-labels > button:focus-visible,\n.about-editor-lane-labels > button.is-active {\n  background: color-mix(in srgb, currentcolor 12%, var(--editor-panel)) !important;\n  box-shadow: inset 3px 0 currentcolor;\n}\n\n.about-editor-lane-labels > :nth-child(1) { color: var(--editor-section); }\n.about-editor-lane-labels > :nth-child(2) { color: var(--editor-camera); }\n.about-editor-lane-labels > :nth-child(3) { color: var(--editor-world); }\n.about-editor-lane-labels > :nth-child(4) { color: var(--editor-text); }\n.about-editor-lane-labels > :nth-child(5) { color: var(--editor-interaction); }\n\n.about-editor-lanes {\n  position: relative;\n  min-width: 0;\n  overflow-x: auto;\n  scrollbar-width: thin;\n}\n\n.about-editor-timeline-canvas {\n  position: relative;\n  width: calc(100% * var(--about-editor-timeline-zoom, 1));\n  min-width: calc(760px * var(--about-editor-timeline-zoom, 1));\n  height: 100%;\n}\n\n.about-editor-marquee {\n  position: absolute;\n  z-index: 9;\n  box-sizing: border-box;\n  border: 1px solid color-mix(in srgb, var(--editor-text) 88%, white 12%);\n  background: color-mix(in srgb, var(--editor-text) 16%, transparent);\n  box-shadow: 0 0 18px color-mix(in srgb, var(--editor-text) 18%, transparent);\n  pointer-events: none;\n}\n\n.about-editor-lane {\n  display: flex;\n  width: 100%;\n  min-width: 0;\n  height: 20%;\n  box-sizing: border-box;\n  border-bottom: 1px solid var(--editor-line);\n  background: color-mix(in srgb, var(--editor-field) 80%, transparent);\n}\n\n.about-editor-lane:nth-child(even) {\n  background: color-mix(in srgb, var(--editor-field) 92%, #000 8%);\n}\n\n.about-editor-lanes[data-solo-track='camera'] .about-editor-lane:not(.about-editor-lane--camera):not(.about-editor-lane--section),\n.about-editor-lanes[data-solo-track='world'] .about-editor-lane:not(.about-editor-lane--world):not(.about-editor-lane--section),\n.about-editor-lanes[data-solo-track='text'] .about-editor-lane:not(.about-editor-lane--text):not(.about-editor-lane--section) {\n  opacity: 0.16;\n}\n\n.about-editor-lane > button,\n.about-editor-section-clip,\n.about-editor-clip {\n  position: relative;\n  flex: 0 0 auto;\n  height: 100%;\n  overflow: hidden;\n  box-sizing: border-box;\n  border: 0;\n  border-right: 1px solid var(--editor-line);\n  border-radius: 0;\n  color: var(--editor-muted);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.about-editor-lane--section > button {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  padding: 0 7px;\n  text-align: left;\n}\n\n.about-editor-section-clip {\n  position: relative;\n  overflow: visible;\n}\n\n.about-editor-section-clip > button:first-child {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  width: 100%;\n  height: 100%;\n  padding: 0 12px 0 7px;\n  overflow: hidden;\n  border: 0;\n  border-radius: 0;\n  color: var(--editor-muted);\n  text-align: left;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.about-editor-section-clip > button:first-child span { font-family: var(--abs-font-mono); font-size: 9px; }\n.about-editor-section-clip.is-context > button:first-child { color: var(--editor-ink); box-shadow: inset 0 2px color-mix(in srgb, var(--editor-section) 58%, transparent); }\n.about-editor-section-clip.is-selected > button:first-child { background: color-mix(in srgb, var(--editor-section) 18%, var(--editor-field)); box-shadow: inset 0 3px var(--editor-section); }\n\n.about-editor-section-resize {\n  position: absolute;\n  z-index: 5;\n  top: 0;\n  right: -5px;\n  width: 11px;\n  height: 100%;\n  padding: 0;\n  border: 0 !important;\n  border-radius: 0 !important;\n  background: transparent !important;\n  cursor: ew-resize !important;\n  touch-action: none;\n}\n\n.about-editor-section-resize::after {\n  position: absolute;\n  top: 20%;\n  right: 4px;\n  bottom: 20%;\n  width: 2px;\n  border-radius: 99px;\n  background: color-mix(in srgb, var(--editor-section) 72%, transparent);\n  content: '';\n}\n\n.about-editor-section-resize:hover::after,\n.about-editor-section-resize:focus-visible::after {\n  background: var(--editor-section);\n  box-shadow: 0 0 8px color-mix(in srgb, var(--editor-section) 58%, transparent);\n}\n\n.about-editor-section-clip > output {\n  position: absolute;\n  z-index: 8;\n  top: 3px;\n  right: 9px;\n  width: max-content;\n  padding: 3px 6px;\n  color: var(--editor-ink);\n  border: 1px solid color-mix(in srgb, var(--editor-section) 58%, var(--editor-line));\n  border-radius: 3px;\n  background: var(--editor-panel);\n  box-shadow: 0 6px 18px rgb(0 0 0 / 34%);\n  font-family: var(--abs-font-mono);\n  font-size: 8px;\n}\n\n.about-editor-lane--section > button span { font-family: var(--abs-font-mono); font-size: 9px; }\n.about-editor-lane--section > button.is-context { color: var(--editor-ink); box-shadow: inset 0 2px color-mix(in srgb, var(--editor-section) 58%, transparent); }\n.about-editor-lane--section > button.is-selected { background: color-mix(in srgb, var(--editor-section) 18%, var(--editor-field)); box-shadow: inset 0 3px var(--editor-section); }\n\n.about-editor-world-clip,\n.about-editor-interaction-clip {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  padding: 0 7px;\n  overflow: hidden;\n  border: 0 !important;\n  border-radius: 0 !important;\n  color: var(--editor-muted) !important;\n  text-align: center;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.about-editor-world-clip.has-world { color: var(--editor-ink) !important; background: color-mix(in srgb, var(--editor-world) 15%, transparent) !important; }\n.about-editor-interaction-clip.has-interaction { color: var(--editor-ink) !important; background: color-mix(in srgb, var(--editor-interaction) 13%, transparent) !important; }\n.about-editor-lane--world .about-editor-clip.is-selected { box-shadow: inset 0 0 0 2px var(--editor-world); }\n.about-editor-lane--world .about-editor-clip { overflow: visible; }\n.about-editor-lane--camera .about-editor-clip { overflow: visible; }\n.about-editor-lane--text .about-editor-clip.has-extended-discipline {\n  z-index: 2;\n  overflow: visible;\n}\n.about-editor-lane--interaction .about-editor-clip.is-selected { box-shadow: inset 0 0 0 2px var(--editor-interaction); }\n\n.about-editor-camera-rail {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n\n.about-editor-camera-rail span {\n  position: absolute;\n  top: 50%;\n  min-width: 1px;\n  height: 1px;\n  transform: translateY(-50%);\n  background: color-mix(in srgb, var(--editor-camera) 26%, transparent);\n}\n\n.about-editor-camera-rail span.is-base-dolly {\n  background: repeating-linear-gradient(\n    90deg,\n    color-mix(in srgb, var(--editor-camera) 32%, transparent) 0 3px,\n    transparent 3px 6px\n  );\n}\n\n.about-editor-camera-rail span.is-authored-motion {\n  height: 3px;\n  border-radius: 999px;\n  background: linear-gradient(\n    90deg,\n    color-mix(in srgb, var(--editor-camera) 44%, transparent),\n    color-mix(in srgb, var(--editor-camera) 92%, white 8%)\n  );\n  box-shadow: 0 0 7px color-mix(in srgb, var(--editor-camera) 36%, transparent);\n}\n\n.about-editor-key {\n  position: absolute;\n  top: 50%;\n  width: 9px;\n  height: 9px;\n  padding: 0;\n  transform: translate(-50%, -50%) rotate(45deg);\n  border-radius: 1px !important;\n  border: 1px solid color-mix(in srgb, var(--editor-camera) 82%, white) !important;\n  background: var(--editor-camera) !important;\n  box-shadow: 0 0 0 2px var(--editor-panel), 0 0 8px color-mix(in srgb, var(--editor-camera) 36%, transparent);\n}\n\n.about-editor button.about-editor-key:hover,\n.about-editor button.about-editor-key:focus,\n.about-editor button.about-editor-key:focus-visible,\n.about-editor button.about-editor-key:active {\n  transform: translate(-50%, -50%) rotate(45deg);\n  transition: none;\n}\n\n.about-editor-key.is-selected {\n  z-index: 4;\n  width: 12px;\n  height: 12px;\n  background: #fff !important;\n  box-shadow: 0 0 0 2px var(--editor-camera), 0 0 12px var(--editor-camera);\n}\n\n.about-editor-key.is-drag-source {\n  opacity: 0.22;\n}\n\n.about-editor-camera-drag-ghost {\n  position: absolute;\n  z-index: 8;\n  top: 30%;\n  transform: translate(-50%, -50%);\n  pointer-events: none;\n  color: var(--editor-camera);\n}\n\n.about-editor-camera-drag-ghost i {\n  display: block;\n  width: 11px;\n  height: 11px;\n  transform: rotate(45deg);\n  border: 1px solid white;\n  border-radius: 1px;\n  background: currentColor;\n  box-shadow: 0 0 0 2px var(--editor-panel), 0 0 12px currentColor;\n}\n\n.about-editor-camera-drag-ghost span {\n  position: absolute;\n  top: -25px;\n  left: 9px;\n  width: max-content;\n  max-width: 180px;\n  overflow: hidden;\n  padding: 3px 6px;\n  border: 1px solid color-mix(in srgb, currentColor 48%, var(--editor-line));\n  border-radius: 3px;\n  color: var(--editor-ink);\n  background: var(--editor-panel);\n  font-family: var(--abs-font-mono);\n  font-size: 8px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.about-editor-camera-drag-ghost.is-invalid {\n  color: var(--editor-danger);\n}\n\n.about-editor-key.is-draggable,\n.about-editor-timing-key.is-draggable,\n.about-editor