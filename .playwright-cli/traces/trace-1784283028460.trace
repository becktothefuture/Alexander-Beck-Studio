rative-page .shell-wall-slot,\nbody.about-narrative-page .shell-wall-route-root,\nbody.about-narrative-page .route-simulation-layer {\n  width: 100%;\n  height: 100%;\n}\n\n.about-narrative-lab {\n  --about-reading-width: 58rem;\n  --about-editorial-type-size: clamp(1.25rem, calc(1.125rem + 0.67vw), 1.5rem);\n  --about-editorial-type-weight: 300;\n  --about-emphasis-blue: color-mix(in srgb, var(--ball-7, #0d5cb6) 72%, var(--text-primary) 28%);\n  --about-emphasis-green: color-mix(in srgb, var(--ball-4, #00695c) 72%, var(--text-primary) 28%);\n  --about-emphasis-orange: color-mix(in srgb, var(--ball-8, #ffa000) 50%, var(--text-primary) 50%);\n  --about-route-accent: var(--button-bar-accent-about, var(--ball-7, #0d5cb6));\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  color: var(--text-primary);\n  background: var(--studio-window-bg);\n  pointer-events: auto;\n  isolation: isolate;\n  container-type: size;\n}\n\n.about-narrative-world {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  pointer-events: none;\n}\n\n.about-narrative-world__canvas {\n  position: absolute;\n  inset: 0;\n  display: block;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n}\n\n.about-narrative-discipline-reveal {\n  position: absolute;\n  z-index: 3;\n  inset: 0;\n  overflow: hidden;\n  padding: 0;\n  margin: 0;\n  pointer-events: none;\n  list-style: none;\n}\n\n.about-narrative-discipline-reveal li {\n  --discipline-color: var(--ball-1, #b5b7b6);\n  --discipline-reveal: 0;\n  --discipline-x: -20vw;\n  --discipline-y: -20vh;\n  position: absolute;\n  top: var(--discipline-y);\n  left: var(--discipline-x);\n  display: block;\n  max-width: min(30rem, calc(100% - var(--discipline-x) - 1rem));\n  opacity: var(--discipline-reveal);\n  color: var(--text-primary);\n  font-family: var(--abs-font-sans);\n  font-size: clamp(0.84rem, 1.2vw, 1.12rem);\n  font-weight: 540;\n  letter-spacing: -0.035em;\n  line-height: 1.05;\n  text-wrap: balance;\n  transform: translate3d(var(--discipline-label-offset, 18px), -50%, 0);\n  transform-origin: left center;\n  will-change: opacity, transform;\n}\n\n.about-narrative-discipline-reveal li[data-discipline-group='1'] {\n  --discipline-color: var(--ball-1, #b5b7b6);\n}\n\n.about-narrative-discipline-reveal li[data-discipline-group='2'] {\n  --discipline-color: var(--ball-4, #00695c);\n}\n\n.about-narrative-discipline-reveal li[data-discipline-group='3'] {\n  --discipline-color: var(--ball-3, #ffffff);\n}\n\n.about-narrative-discipline-reveal li[data-discipline-group='4'] {\n  --discipline-color: var(--ball-7, #0d5cb6);\n}\n\n.about-narrative-discipline-reveal li[data-discipline-group='5'] {\n  --discipline-color: var(--ball-8, #ffa000);\n}\n\n.about-narrative-discipline-reveal li[data-discipline-group='6'] {\n  --discipline-color: var(--ball-6, #d7ff2f);\n}\n\n.about-narrative-discipline-reveal__label {\n  display: block;\n  filter: blur(var(--discipline-blur, 7px));\n  transform: translate3d(var(--discipline-shift, 12px), 0, 0);\n  will-change: filter, transform;\n}\n\n.about-narrative-scrollport {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  -webkit-overflow-scrolling: touch;\n  touch-action: pan-y pinch-zoom;\n  scrollbar-width: thin;\n  scrollbar-color: color-mix(in srgb, var(--text-primary) 32%, transparent) transparent;\n}\n\n.about-narrative-content {\n  position: relative;\n  width: 100%;\n  min-height: 100%;\n  user-select: text;\n}\n\n.about-narrative-section {\n  position: relative;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.about-narrative-section--spatial {\n  height: calc(var(--section-duration-wu, 2) * var(--narrative-viewport-height, 100cqh));\n}\n\n.about-narrative-section--opening {\n  min-height: calc(var(--section-duration-wu, 1) * var(--narrative-viewport-height, 100cqh));\n}\n\n.about-narrative-vertical-sequence {\n  position: absolute;\n  z-index: 2;\n  inset: 0;\n  pointer-events: none;\n}\n\n.about-narrative-vertical-title {\n  position: absolute;\n  top: var(--vertical-cue-top, 50%);\n  left: 50%;\n  width: min(calc(100% - clamp(2.5rem, 14vw, 14rem)), 70rem);\n  max-width: 22ch;\n  margin: 0;\n  opacity: var(--editorial-reveal, 0);\n  color: var(--text-primary);\n  filter: blur(var(--editorial-blur, 3px));\n  font-family: var(--abs-font-headline);\n  font-size: clamp(2.4rem, 6.7vw, 7.8rem);\n  font-weight: 400;\n  letter-spacing: var(--abs-font-headline-letter-spacing);\n  line-height: calc(0.96 * var(--abs-font-headline-line-height-scale, 1));\n  text-align: center;\n  text-shadow: 0 1px 24px color-mix(in srgb, var(--studio-window-bg) 52%, transparent);\n  text-wrap: balance;\n  pointer-events: auto;\n  transform: translate3d(-50%, calc(-50% + var(--editorial-y, 12px)), 0);\n  will-change: opacity, filter, transform;\n}\n\n.about-narrative-vertical-title.is-opener {\n  top: calc(var(--vertical-cue-top, 50%) + 3cqh);\n}\n\n.about-narrative-spatial-stage {\n  position: sticky;\n  top: 0;\n  display: grid;\n  place-items: center;\n  width: 100%;\n  height: var(--narrative-viewport-height, 100cqh);\n  box-sizing: border-box;\n  padding: clamp(4.5rem, 9vw, 8.5rem) clamp(1.25rem, 7vw, 7rem);\n  overflow: hidden;\n  perspective: var(--about-text-perspective, 1600px);\n  perspective-origin: 50% 46%;\n  transform-style: preserve-3d;\n}\n\n.about-narrative-spatial-copy {\n  position: relative;\n  width: min(100%, 70rem);\n  text-align: center;\n  transform-style: preserve-3d;\n}\n\n.about-narrative-spatial-title {\n  display: grid;\n  place-items: center;\n  width: 100%;\n  margin: 0;\n  font-family: var(--abs-font-headline);\n  font-size: clamp(2.4rem, 6.7vw, 7.8rem);\n  font-weight: 400;\n  letter-spacing: var(--abs-font-headline-letter-spacing);\n  line-height: calc(0.96 * var(--abs-font-headline-line-height-scale, 1));\n  text-wrap: balance;\n  text-shadow: 0 1px 24px color-mix(in srgb, var(--studio-window-bg) 52%, transparent);\n  transform-style: preserve-3d;\n}\n\n.about-narrative-spatial-fragment {\n  grid-area: 1 / 1;\n  display: block;\n  max-width: 22ch;\n  opacity: var(--fragment-opacity, 0);\n  filter: blur(var(--fragment-blur, 22px));\n  transform:\n    translate3d(\n      var(--fragment-x, 0px),\n      var(--fragment-y, -110px),\n      var(--fragment-z, -360px)\n    );\n  transform-origin: center;\n  backface-visibility: hidden;\n  will-change: opacity, filter, transform;\n}\n\n.about-narrative-opening-scroll-cue {\n  position: absolute;\n  top: calc(100% + clamp(1.25rem, 3cqh, 2rem));\n  left: 50%;\n  z-index: 2;\n  display: grid;\n  place-items: center;\n  width: calc(0.79 * clamp(40px, 3.2vw, 52px));\n  height: calc(0.79 * clamp(48px, 6cqh, 64px));\n  color: var(--text-primary);\n  opacity: var(--opening-scroll-cue-opacity, 1);\n  transform: translate3d(-50%, var(--opening-scroll-cue-start-y, 36px), 0);\n  transition:\n    opacity 180ms linear,\n    visibility 0s linear 180ms;\n  animation: aboutNarrativeScrollCueGesture 1.7s ease-in-out infinite;\n  pointer-events: none;\n  visibility: visible;\n}\n\n.about-narrative-lab[data-opening-scroll-cue='hidden'] .about-narrative-opening-scroll-cue {\n  visibility: hidden;\n  animation: none;\n}\n\n.about-narrative-opening-scroll-cue__icon {\n  font-size: calc(0.62 * clamp(36px, 3.2vw, 48px));\n  line-height: 1;\n  transform: rotate(-90deg) scale(1.15);\n  filter: drop-shadow(\n    0 calc(0.62 * 6px) calc(0.62 * 20px) color-mix(in srgb, currentColor 22%, transparent)\n  );\n}\n\n@keyframes aboutNarrativeScrollCueGesture {\n  0%,\n  100% {\n    transform: translate3d(-50%, calc(var(--opening-scroll-cue-start-y, 36px) - 3.16px), 0);\n  }\n\n  48% {\n    transform: translate3d(-50%, calc(var(--opening-scroll-cue-start-y, 36px) + 4.74px), 0);\n  }\n\n  72% {\n    transform: translate3d(-50%, calc(var(--opening-scroll-cue-start-y, 36px) + 7.9px), 0);\n  }\n}\n\n.about-narrative-section--editorial.about-narrative-section--disciplines {\n  align-items: flex-start;\n  padding-top: clamp(34rem, 92cqh, 52rem);\n  padding-bottom: clamp(8rem, 18cqh, 13rem);\n}\n\n.about-narrative-section--editorial {\n  display: flex;\n  align-items: center;\n  min-height: calc(var(--section-duration-wu, 1.2) * var(--narrative-viewport-height, 100cqh));\n  padding: clamp(6rem, 12vw, 11rem) clamp(1.25rem, 9vw, 9rem);\n}\n\n.about-narrative-section--opening-continuation {\n  min-height: calc(1.1 * var(--narrative-viewport-height, 100cqh));\n}\n\n.about-narrative-section--opening-continuation .about-narrative-editorial-copy {\n  max-width: 48ch;\n  margin: 0 auto;\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.02em;\n  line-height: 1.48;\n  text-align: center;\n  text-wrap: balance;\n}\n\n.about-narrative-section--exit {\n  align-items: center;\n}\n\n.about-narrative-section--exit .about-narrative-editorial-title {\n  max-width: 48ch;\n  margin-bottom: 0;\n}\n\n.about-narrative-editorial-inner {\n  width: min(100%, var(--about-reading-width));\n  margin-inline: auto;\n}\n\n.about-narrative-editorial-title {\n  max-width: 48ch;\n  margin: 0 0 clamp(2.75rem, 5vw, 4.5rem);\n  color: var(--text-primary);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.02em;\n  line-height: 1.48;\n  text-wrap: balance;\n}\n\n[data-editorial-line] {\n  --editorial-reveal: 0;\n  --editorial-blur: 3px;\n  --editorial-y: 12px;\n  opacity: var(--editorial-reveal);\n  filter: blur(var(--editorial-blur));\n  transform: translate3d(0, var(--editorial-y), 0);\n  will-change: opacity, filter, transform;\n}\n\n.about-narrative-vertical-title[data-editorial-line] {\n  transform: translate3d(-50%, calc(-50% + var(--editorial-y, 12px)), 0);\n}\n\n.about-narrative-visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.about-narrative-editorial-copy {\n  max-width: 48ch;\n  margin: 0 0 clamp(1.6rem, 3vw, 2.4rem);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.018em;\n  line-height: 1.52;\n  text-wrap: pretty;\n}\n\n.about-narrative-editorial-copy.is-highlighted {\n  max-width: 48ch;\n  margin-block: clamp(2.75rem, 5vw, 4.5rem);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  line-height: 1.48;\n}\n\n.about-narrative-editorial-detail {\n  max-width: 48ch;\n  margin: clamp(2rem, 4vw, 3.5rem) 0 0;\n  color: var(--text-muted);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.015em;\n  line-height: 1.55;\n}\n\n.about-narrative-editorial-list {\n  width: min(100%, 42rem);\n  margin: clamp(2.75rem, 5vw, 4.5rem) 0;\n}\n\n.about-narrative-editorial-list__label {\n  margin: 0 0 1rem;\n  color: var(--text-muted);\n  font-family: var(--abs-font-mono);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: 0.035em;\n  line-height: 1.35;\n  text-transform: uppercase;\n}\n\n.about-narrative-editorial-list ul,\n.about-narrative-discipline-list {\n  padding: 0;\n  margin: 0;\n  list-style: none;\n}\n\n.about-narrative-editorial-list li {\n  padding: 0.9rem 0;\n  border-top: 1px solid color-mix(in srgb, var(--text-primary) 16%, transparent);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.025em;\n  line-height: 1.35;\n}\n\n.about-narrative-editorial-list li:last-child {\n  border-bottom: 1px solid color-mix(in srgb, var(--text-primary) 16%, transparent);\n}\n\n.about-narrative-editorial-clients {\n  max-width: 48ch;\n  margin: clamp(2.75rem, 5vw, 4.5rem) 0 0;\n  color: var(--text-muted);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.018em;\n  line-height: 1.5;\n}\n\n.about-narrative-client-logos {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  width: min(100%, 52rem);\n  padding: 0;\n  margin: clamp(3.5rem, 7vw, 6rem) 0 0;\n  border-block: 1px solid color-mix(in srgb, var(--text-primary) 16%, transparent);\n  list-style: none;\n}\n\n.about-narrative-client-logos li {\n  display: grid;\n  place-items: center;\n  min-height: clamp(5.5rem, 9vw, 7.5rem);\n  padding: 1rem;\n  color: color-mix(in srgb, var(--text-primary) 78%, transparent);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.035em;\n  line-height: 1.05;\n  text-align: center;\n  text-wrap: balance;\n}\n\n.about-narrative-client-logos li + li {\n  border-inline-start: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);\n}\n\n.about-narrative-client-logos li:nth-child(n + 4) {\n  border-top: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);\n}\n\n.about-narrative-client-logos li:nth-child(4) {\n  border-inline-start: 0;\n}\n\n.about-narrative-client-logos [data-client-logo='sunexpress'] {\n  font-style: italic;\n}\n\n.about-narrative-client-logos [data-client-logo='mccann'] {\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.about-narrative-client-logos [data-client-logo='bentley'] {\n  letter-spacing: 0.08em;\n}\n\n.about-narrative-discipline-list {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  width: min(100%, 38rem);\n  margin: 0 0 clamp(3.5rem, 7vw, 6rem);\n  border-top: 1px solid color-mix(in srgb, var(--text-primary) 18%, transparent);\n}\n\n.about-narrative-discipline-list li {\n  display: grid;\n  grid-template-columns: auto auto minmax(0, 1fr);\n  align-items: center;\n  gap: 0.7rem;\n  min-height: clamp(4.25rem, 7vw, 5.75rem);\n  padding: 0.8rem 1rem 0.8rem 0;\n  border-bottom: 1px solid color-mix(in srgb, var(--text-primary) 18%, transparent);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: -0.03em;\n  line-height: 1.1;\n}\n\n.about-narrative-discipline-list__marker {\n  width: 0.62rem;\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: var(--discipline-color, var(--about-route-accent));\n  box-shadow: 0 0 0 0.22rem color-mix(in srgb, var(--discipline-color, var(--about-route-accent)) 14%, transparent);\n}\n\n.about-narrative-discipline-list__number {\n  color: var(--text-muted);\n  font-family: var(--abs-font-mono);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  letter-spacing: 0.02em;\n}\n\n.about-narrative-discipline-list li:nth-child(1) {\n  --discipline-color: var(--ball-1, #b5b7b6);\n}\n\n.about-narrative-discipline-list li:nth-child(2) {\n  --discipline-color: var(--ball-4, #00695c);\n}\n\n.about-narrative-discipline-list li:nth-child(3) {\n  --discipline-color: var(--ball-3, #ffffff);\n}\n\n.about-narrative-discipline-list li:nth-child(4) {\n  --discipline-color: var(--ball-7, #0d5cb6);\n}\n\n.about-narrative-discipline-list li:nth-child(5) {\n  --discipline-color: var(--ball-8, #ffa000);\n}\n\n.about-narrative-discipline-list li:nth-child(6) {\n  --discipline-color: var(--ball-6, #d7ff2f);\n}\n\n.about-narrative-section--disciplines .about-narrative-editorial-title,\n.about-narrative-section--disciplines .about-narrative-editorial-copy {\n  max-width: 48ch;\n  margin-inline: 0;\n  text-align: left;\n}\n\n.about-narrative-inline-study {\n  width: min(100%, 42rem);\n  margin: clamp(4rem, 8vw, 8rem) 0;\n}\n\n.about-narrative-inline-study__field {\n  position: relative;\n  height: clamp(12rem, 28vw, 19rem);\n  overflow: hidden;\n  border-block: 1px solid color-mix(in srgb, var(--text-primary) 14%, transparent);\n}\n\n.about-narrative-inline-study__field span {\n  position: absolute;\n  left: calc(8% + (var(--study-x) * 84%));\n  top: calc(10% + (var(--study-y) * 78%));\n  width: clamp(5px, 0.7vw, 9px);\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: currentColor;\n  opacity: 0.34;\n  transform: translate3d(-50%, -50%, 0);\n  animation: about-attention-study 3.8s ease-in-out var(--study-delay) infinite alternate;\n}\n\n.about-narrative-inline-study__field span:nth-child(7n),\n.about-narrative-inline-study__field span:nth-child(11n) {\n  opacity: 0.92;\n  animation-duration: 2.7s;\n}\n\n.about-narrative-inline-study figcaption {\n  max-width: 42ch;\n  margin-top: 0.8rem;\n  color: var(--text-muted);\n  font-size: var(--about-editorial-type-size);\n  font-weight: var(--about-editorial-type-weight);\n  line-height: 1.4;\n}\n\n.about-narrative-editorial-emphasis {\n  color: var(--about-emphasis-blue);\n  font-weight: 650;\n}\n\n.about-narrative-editorial-emphasis[data-emphasis-tone='green'] {\n  color: var(--about-emphasis-green);\n}\n\n.about-narrative-editorial-emphasis[data-emphasis-tone='orange'] {\n  color: var(--about-emphasis-orange);\n}\n\n@keyframes about-attention-study {\n  0% {\n    translate: 0 0;\n  }\n\n  100% {\n    translate: var(--study-dx) var(--study-dy);\n  }\n}\n\n.about-narrative-finale-stage {\n  padding: 0 clamp(1rem, 5vw, 5rem);\n}\n\n.about-narrative-finale-copy {\n  display: grid;\n  place-items: center;\n  height: 100%;\n}\n\n.about-narrative-finale-copy .about-narrative-spatial-title {\n  width: 100%;\n}\n\n.about-narrative-bust-interaction {\n  position: absolute;\n  z-index: 2;\n  top: 24%;\n  left: 50%;\n  width: min(58vw, 38rem);\n  height: 48%;\n  border: 0;\n  background: transparent;\n  cursor: grab;\n  outline: none;\n  pointer-events: none;\n  touch-action: pan-y;\n  transform: translateX(-50%);\n}\n\n.about-narrative-bust-interaction[data-active='true'] {\n  pointer-events: auto;\n}\n\n.about-narrative-bust-interaction:active {\n  cursor: grabbing;\n}\n\n.about-narrative-bust-interaction:focus-visible {\n  outline: 1px solid color-mix(in srgb, var(--text-primary) 55%, transparent);\n  outline-offset: 0.35rem;\n  border-radius: 50%;\n}\n\n.about-narrative-finale-cta {\n  position: absolute;\n  left: 50%;\n  bottom: clamp(5.75rem, 11cqh, 7rem);\n  display: grid;\n  grid-template-areas:\n    'profile actions'\n    'statement actions';\n  grid-template-columns: minmax(16rem, 24rem) auto;\n  align-items: end;\n  justify-content: space-between;\n  width: min(calc(100% - 6rem), 72rem);\n  opacity: var(--spatial-context-opacity, 0);\n  text-align: left;\n  transform: translate3d(-50%, var(--spatial-context-y, 16px), 0);\n  will-change: opacity, transform;\n}\n\n.about-narrative-finale-profile {\n  grid-area: profile;\n  margin: 0;\n  font-size: clamp(1.1rem, 1.75vw, 1.65rem);\n  font-weight: 550;\n  letter-spacing: -0.035em;\n  line-height: 1.12;\n  text-wrap: balance;\n}\n\n.about-narrative-finale-statement {\n  grid-area: statement;\n  max-width: 34ch;\n  margin: 0.55rem 0 0;\n  color: var(--text-muted);\n  font-size: clamp(0.95rem, 1.2vw, 1.08rem);\n  line-height: 1.4;\n}\n\n.about-narrative-cta {\n  display: flex;\n  justify-content: center;\n  gap: 0.65rem;\n  margin-top: clamp(1.5rem, 3vw, 2.4rem);\n}\n\n.about-narrative-finale-cta .about-narrative-cta {\n  grid-area: actions;\n  justify-content: flex-end;\n  margin: 0;\n}\n\n.about-narrative-finale-cta.is-actions-only {\n  display: flex;\n  justify-content: center;\n  width: min(calc(100% - 2rem), 32rem);\n}\n\n.about-narrative-finale-cta.is-actions-only .about-narrative-cta {\n  justify-content: center;\n}\n\n.about-narrative-cta--editorial {\n  justify-content: flex-start;\n  margin-top: clamp(1.5rem, 3vw, 2.5rem);\n}\n\n.about-narrative-cta a,\n.about-narrative-controls__launcher {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 2.75rem;\n  padding: 0.72rem 1rem;\n  border: 1px solid color-mix(in srgb, var(--text-primary) 22%, transparent);\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--studio-window-bg) 76%, transparent);\n  color: var(--text-primary);\n  font-family: var(--abs-font-mono);\n  font-size: 0.75rem;\n  font-weight: 500;\n  line-height: 1;\n  text-decoration: none;\n  backdrop-filter: blur(14px);\n  transition: background 160ms ease, color 160ms ease, border-color 160ms ease;\n}\n\n.about-narrative-cta a:hover,\n.about-narrative-cta a:focus-visible,\n.about-narrative-controls__launcher:hover,\n.about-narrative-controls__launcher:focus-visible {\n  border-color: color-mix(in srgb, var(--text-primary) 48%, transparent);\n  background: color-mix(in srgb, var(--text-primary) 12%, var(--studio-window-bg));\n  outline: none;\n}\n\n.about-narrative-indicator-layer {\n  position: absolute;\n  z-index: 5;\n  top: var(--safari-tint-inset-y, var(--safari-tint-inset));\n  right: var(--safari-tint-inset-x, var(--safari-tint-inset));\n  bottom: 0;\n  left: var(--safari-tint-inset-x, var(--safari-tint-inset));\n  pointer-events: none;\n}\n\n.about-narrative-indicator {\n  /* Portaled into a studio-window-sized UI layer above the contrast veil. */\n  position: absolute;\n  z-index: 5;\n  top: 50%;\n  left: clamp(10px, 1vw, 14px);\n  display: grid;\n  gap: var(--abs-indicator-line-gap, 9px);\n  pointer-events: none;\n  transform: translateY(calc(-50% + 0.5px));\n}\n\n.about-narrative-indicator__line {\n  display: block;\n  width: var(--abs-indicator-line-width, 8px);\n  height: var(--abs-indicator-line-thickness, 3px);\n  border-radius: 999px;\n  background: var(--abs-indicator-ink, rgb(var(--abs-rgb-black)));\n  opacity: var(--abs-indicator-rest-opacity, 0.22);\n  transition: opacity 140ms ease-out;\n}\n\n.about-narrative-indicator__line.is-active {\n  opacity: 1;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .about-narrative-indicator__line {\n    transition: none;\n  }\n}\n\n.about-narrative-controls {\n  position: fixed;\n  z-index: 204;\n  top: calc(var(--safari-tint-inset-y, var(--safari-tint-inset, 0px)) + clamp(0.75rem, 2vw, 1.25rem));\n  left: calc(var(--safari-tint-inset-x, var(--safari-tint-inset, 0px)) + clamp(0.75rem, 2vw, 1.25rem));\n  pointer-events: auto;\n}\n\n.about-narrative-controls__launcher {\n  gap: 0.45rem;\n  min-height: 2.25rem;\n  padding: 0.52rem 0.72rem;\n  cursor: pointer;\n}\n\n.parameterizer-panel {\n  --parameterizer-width: 288px;\n  --parameterizer-header-height: 32px;\n  --parameterizer-folder-height: 28px;\n  --parameterizer-row-height: 28px;\n  display: flex;\n  flex-direction: column;\n  width: var(--parameterizer-width);\n  max-height: min(72svh, 560px);\n  overflow: hidden;\n  border: 1px solid #2d3036;\n  border-radius: 5px;\n  background: #191a1d;\n  color: #eceff3;\n  box-shadow: 0 14px 38px rgba(0, 0, 0, 0.34);\n  font-family: var(--abs-font-sans);\n  font-size: 11px;\n  line-height: 1;\n}\n\n.parameterizer-header {\n  display: flex;\n  flex: 0 0 var(--parameterizer-header-height);\n  align-items: center;\n  justify-content: space-between;\n  height: var(--parameterizer-header-height);\n  padding-inline: 9px 4px;\n  background: #111215;\n  font-weight: 600;\n}\n\n.parameterizer-header button,\n.parameterizer-actions button {\n  border: 0;\n  border-radius: 2px;\n  background: #2a2d33;\n  color: #eceff3;\n  cursor: pointer;\n}\n\n.parameterizer-header button {\n  display: grid;\n  place-items: center;\n  width: 24px;\n  height: 24px;\n  padding: 0;\n}\n\n.parameterizer-scroll {\n  min-height: 0;\n  overflow-x: hidden;\n  overflow-y: auto;\n  scrollbar-width: thin;\n  scrollbar-color: #3f4652 #191a1d;\n}\n\n.parameterizer-folder {\n  border-top: 1px solid #2d3036;\n}\n\n.parameterizer-folder-title {\n  display: flex;\n  align-items: center;\n  height: var(--parameterizer-folder-height);\n  padding: 0 8px;\n  background: #222429;\n  font-weight: 600;\n  cursor: pointer;\n  list-style: none;\n}\n\n.parameterizer-folder-title::-webkit-details-marker {\n  display: none;\n}\n\n.parameterizer-folder-title::before {\n  content: '›';\n  width: 12px;\n  color: #8d939c;\n  transform: rotate(0deg);\n}\n\n.parameterizer-folder[open] .parameterizer-folder-title::before {\n  transform: rotate(90deg);\n}\n\n.parameterizer-row {\n  display: grid;\n  grid-template-columns: minmax(0, 42%) minmax(0, 58%);\n  align-items: center;\n  height: var(--parameterizer-row-height);\n  padding: 0 7px;\n  background: #191a1d;\n  border-top: 1px solid rgba(45, 48, 54, 0.55);\n}\n\n.parameterizer-row:hover {\n  background: #202228;\n}\n\n.parameterizer-label {\n  overflow: hidden;\n  color: #c9cdd3;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.parameterizer-control {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 48px;\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n}\n\n.parameterizer-control input[type='range'] {\n  width: 100%;\n  min-width: 0;\n  accent-color: #5db7ff;\n}\n\n.parameterizer-value {\n  overflow: hidden;\n  color: #5db7ff;\n  font-family: var(--abs-font-mono);\n  font-variant-numeric: tabular-nums;\n  text-align: right;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.parameterizer-actions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 4px;\n  flex: 0 0 auto;\n  padding: 5px;\n  border-top: 1px solid #2d3036;\n  background: #111215;\n}\n\n.parameterizer-actions button {\n  min-height: 28px;\n  padding: 0 8px;\n  font: inherit;\n}\n\n.parameterizer-header button:hover,\n.parameterizer-header button:focus-visible,\n.parameterizer-actions button:hover,\n.parameterizer-actions button:focus-visible {\n  background: #3f4652;\n  outline: 1px solid #5db7ff;\n  outline-offset: -1px;\n}\n\n@media (max-width: 760px) {\n  .about-narrative-vertical-title,\n  .about-narrative-spatial-title {\n    font-size: clamp(2.25rem, 11vw, 4.5rem);\n    line-height: 0.98;\n  }\n\n}\n\n@media (min-width: 601px) and (max-height: 760px) {\n  .about-narrative-spatial-stage {\n    padding-block: 4.75rem;\n  }\n\n  .about-narrative-spatial-title {\n    font-size: clamp(2.2rem, min(5.5vw, 9vh), 5rem);\n  }\n\n  .about-nar