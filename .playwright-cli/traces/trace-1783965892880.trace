n        --abs-boot-dot-3: #bbbdbd;\n        --abs-boot-dot-4: #0d5cb6;\n        --abs-boot-dot-5: #ffa000;\n        --abs-boot-dot-6: #d7ff2f;\n        width: 100%;\n        min-height: 100%;\n        margin: 0;\n        background: var(--abs-browser-chrome, #202020);\n        background-color: var(--abs-browser-chrome, #202020);\n      }\n\n      html[data-abs-boot-state=\"booting\"]::before,\n      html[data-abs-boot-state=\"booting\"]::after {\n        content: \"\";\n        position: fixed;\n        pointer-events: none;\n      }\n\n      html:not([data-abs-boot-state=\"booting\"])::before,\n      html:not([data-abs-boot-state=\"booting\"])::after {\n        content: none;\n        animation: none;\n      }\n\n      html[data-abs-boot-state=\"booting\"]::before {\n        inset: 0;\n        z-index: 2147482998;\n        background: var(--abs-browser-chrome, #202020);\n      }\n\n      html[data-abs-boot-state=\"booting\"]::after {\n        top: 50%;\n        left: 50%;\n        z-index: 2147482999;\n        width: 4.8px;\n        height: 4.8px;\n        margin: -2.4px 0 0 -2.4px;\n        border-radius: 50%;\n        background: transparent;\n        box-shadow:\n          0 -14.25px var(--abs-boot-dot-1, #b5b7b6),\n          12.34px -7.125px var(--abs-boot-dot-2, #00695c),\n          12.34px 7.125px var(--abs-boot-dot-3, #bbbdbd),\n          0 14.25px var(--abs-boot-dot-4, #0d5cb6),\n          -12.34px 7.125px var(--abs-boot-dot-5, #ffa000),\n          -12.34px -7.125px var(--abs-boot-dot-6, #d7ff2f);\n        animation:\n          absCriticalBootOrbit var(--abs-boot-orbit-ms) linear infinite,\n          absCriticalBootColorShift var(--abs-boot-color-cycle-ms) steps(1, end) infinite;\n        animation-delay: 0ms, var(--abs-boot-color-sync-ms);\n      }\n\n      #root[aria-hidden=\"true\"],\n      html[data-abs-boot-state=\"booting\"] #root {\n        opacity: 0;\n        visibility: hidden;\n        pointer-events: none;\n      }\n\n      html[data-abs-boot-state=\"revealing\"] #root,\n      html[data-abs-boot-state=\"ready\"] #root,\n      html[data-abs-boot-state=\"failed\"] #root {\n        opacity: 1;\n        visibility: visible;\n      }\n\n      #abs-boot-overlay {\n        position: fixed;\n        inset: 0;\n        z-index: 2147483000;\n        display: grid;\n        place-items: center;\n        background: var(--abs-browser-chrome, #202020);\n        color: var(--abs-boot-spinner-color, rgba(255, 255, 255, 0.82));\n        opacity: 1;\n        pointer-events: auto;\n        transition: opacity var(--abs-boot-overlay-out-ms, 300ms) cubic-bezier(0.16, 1, 0.3, 1);\n      }\n\n      #abs-boot-overlay.is-exiting {\n        opacity: 0;\n        pointer-events: none;\n      }\n\n      #abs-boot-overlay.is-exiting #abs-boot-spinner {\n        opacity: 0;\n        visibility: hidden;\n        animation: none;\n        transition: none;\n      }\n\n      #abs-boot-overlay.is-exiting .abs-boot-dot::before {\n        animation: none;\n      }\n\n      #abs-boot-spinner {\n        width: 36px;\n        height: 36px;\n        position: relative;\n        box-sizing: border-box;\n        animation: absBootOrbit var(--abs-boot-orbit-ms) linear infinite;\n      }\n\n      .abs-boot-dot {\n        position: absolute;\n        top: 50%;\n        left: 50%;\n        width: 4.8px;\n        height: 4.8px;\n        margin: -2.4px 0 0 -2.4px;\n        border-radius: 50%;\n        transform: rotate(var(--abs-dot-angle)) translateY(-14.25px);\n      }\n\n      .abs-boot-dot:nth-child(1) { --abs-dot-color-delay: -80ms; }\n      .abs-boot-dot:nth-child(2) { --abs-dot-color-delay: -240ms; }\n      .abs-boot-dot:nth-child(3) { --abs-dot-color-delay: -400ms; }\n      .abs-boot-dot:nth-child(4) { --abs-dot-color-delay: -560ms; }\n      .abs-boot-dot:nth-child(5) { --abs-dot-color-delay: -720ms; }\n      .abs-boot-dot:nth-child(6) { --abs-dot-color-delay: -880ms; }\n\n      .abs-boot-dot::before {\n        content: \"\";\n        display: block;\n        width: 100%;\n        height: 100%;\n        border-radius: inherit;\n        background: var(--abs-dot-color);\n        animation:\n          absBootDotPulse var(--abs-boot-orbit-ms) ease-in-out infinite,\n          absBootDotColorShift var(--abs-boot-color-cycle-ms) steps(1, end) infinite;\n        animation-delay: 0ms, var(--abs-dot-color-delay, var(--abs-boot-color-sync-ms));\n      }\n\n      @keyframes absBootOrbit {\n        0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.42, 0, 0.28, 1); }\n        18% { transform: rotate(56deg); animation-timing-function: cubic-bezier(0.25, 0, 0.22, 1); }\n        36% { transform: rotate(132deg); animation-timing-function: cubic-bezier(0.42, 0, 0.32, 1); }\n        58% { transform: rotate(210deg); animation-timing-function: cubic-bezier(0.2, 0, 0.2, 1); }\n        78% { transform: rotate(300deg); animation-timing-function: cubic-bezier(0.46, 0, 0.36, 1); }\n        100% { transform: rotate(360deg); }\n      }\n\n      @keyframes absCriticalBootOrbit {\n        0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.42, 0, 0.28, 1); }\n        18% { transform: rotate(56deg); animation-timing-function: cubic-bezier(0.25, 0, 0.22, 1); }\n        36% { transform: rotate(132deg); animation-timing-function: cubic-bezier(0.42, 0, 0.32, 1); }\n        58% { transform: rotate(210deg); animation-timing-function: cubic-bezier(0.2, 0, 0.2, 1); }\n        78% { transform: rotate(300deg); animation-timing-function: cubic-bezier(0.46, 0, 0.36, 1); }\n        100% { transform: rotate(360deg); }\n      }\n\n      @keyframes absCriticalBootColorShift {\n        0%, 63.99%, 82%, 100% {\n          box-shadow:\n            0 -14.25px var(--abs-boot-dot-1, #b5b7b6),\n            12.34px -7.125px var(--abs-boot-dot-2, #00695c),\n            12.34px 7.125px var(--abs-boot-dot-3, #bbbdbd),\n            0 14.25px var(--abs-boot-dot-4, #0d5cb6),\n            -12.34px 7.125px var(--abs-boot-dot-5, #ffa000),\n            -12.34px -7.125px var(--abs-boot-dot-6, #d7ff2f);\n        }\n        67% {\n          box-shadow:\n            0 -14.25px var(--abs-boot-dot-2, #00695c),\n            12.34px -7.125px var(--abs-boot-dot-3, #bbbdbd),\n            12.34px 7.125px var(--abs-boot-dot-4, #0d5cb6),\n            0 14.25px var(--abs-boot-dot-5, #ffa000),\n            -12.34px 7.125px var(--abs-boot-dot-6, #d7ff2f),\n            -12.34px -7.125px var(--abs-boot-dot-1, #b5b7b6);\n        }\n        70% {\n          box-shadow:\n            0 -14.25px var(--abs-boot-dot-3, #bbbdbd),\n            12.34px -7.125px var(--abs-boot-dot-4, #0d5cb6),\n            12.34px 7.125px var(--abs-boot-dot-5, #ffa000),\n            0 14.25px var(--abs-boot-dot-6, #d7ff2f),\n            -12.34px 7.125px var(--abs-boot-dot-1, #b5b7b6),\n            -12.34px -7.125px var(--abs-boot-dot-2, #00695c);\n        }\n        73% {\n          box-shadow:\n            0 -14.25px var(--abs-boot-dot-4, #0d5cb6),\n            12.34px -7.125px var(--abs-boot-dot-5, #ffa000),\n            12.34px 7.125px var(--abs-boot-dot-6, #d7ff2f),\n            0 14.25px var(--abs-boot-dot-1, #b5b7b6),\n            -12.34px 7.125px var(--abs-boot-dot-2, #00695c),\n            -12.34px -7.125px var(--abs-boot-dot-3, #bbbdbd);\n        }\n        76% {\n          box-shadow:\n            0 -14.25px var(--abs-boot-dot-5, #ffa000),\n            12.34px -7.125px var(--abs-boot-dot-6, #d7ff2f),\n            12.34px 7.125px var(--abs-boot-dot-1, #b5b7b6),\n            0 14.25px var(--abs-boot-dot-2, #00695c),\n            -12.34px 7.125px var(--abs-boot-dot-3, #bbbdbd),\n            -12.34px -7.125px var(--abs-boot-dot-4, #0d5cb6);\n        }\n        79% {\n          box-shadow:\n            0 -14.25px var(--abs-boot-dot-6, #d7ff2f),\n            12.34px -7.125px var(--abs-boot-dot-1, #b5b7b6),\n            12.34px 7.125px var(--abs-boot-dot-2, #00695c),\n            0 14.25px var(--abs-boot-dot-3, #bbbdbd),\n            -12.34px 7.125px var(--abs-boot-dot-4, #0d5cb6),\n            -12.34px -7.125px var(--abs-boot-dot-5, #ffa000);\n        }\n      }\n\n      @keyframes absBootDotColorShift {\n        0%, 63.99%, 82%, 100% { background: var(--abs-dot-color); }\n        67% { background: var(--abs-boot-dot-2, #00695c); }\n        70% { background: var(--abs-boot-dot-3, #bbbdbd); }\n        73% { background: var(--abs-boot-dot-4, #0d5cb6); }\n        76% { background: var(--abs-boot-dot-5, #ffa000); }\n        79% { background: var(--abs-boot-dot-6, #d7ff2f); }\n      }\n\n      @keyframes absBootDotPulse {\n        0%, 100% { transform: scale(0.82); opacity: 0.68; }\n        42% { transform: scale(1.08); opacity: 1; }\n        68% { transform: scale(0.94); opacity: 0.86; }\n      }\n\n      @media (prefers-reduced-motion: reduce) {\n        #abs-boot-overlay {\n          --abs-boot-overlay-out-ms: 150ms;\n        }\n\n        #abs-boot-spinner {\n          animation: none;\n        }\n\n        html[data-abs-boot-state=\"booting\"]::after {\n          animation: none;\n        }\n\n        .abs-boot-dot::before {\n          animation: none;\n          opacity: 0.9;\n          transform: none;\n          background: var(--abs-dot-color);\n        }\n      }\n    "],"\n    ",["META",{"name":"theme-color","media":"(prefers-color-scheme: light)","content":"#f1f3f4"}],["META",{"name":"theme-color","media":"(prefers-color-scheme: dark)","content":"#f1f3f4"}],["META",{"name":"theme-color","content":"#f1f3f4"}],["META",{"name":"apple-mobile-web-app-status-bar-style","content":"black-translucent"}],"\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0, viewport-fit=cover"}],"\n    ",["LINK",{"rel":"icon","href":"/images/favicon.ico","sizes":"any"}],"\n    ",["LINK",{"rel":"icon","type":"image/png","sizes":"32x32","href":"/images/favicon-32x32.png"}],"\n    ",["LINK",{"rel":"apple-touch-icon","href":"/images/apple-touch-icon.png"}],"\n    ",["TITLE",{},"Portfolio - Alexander Beck"],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.googleapis.com"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}],"\n    ",["LINK",{"href":"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap","rel":"stylesheet"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/css/tokens.css"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/css/normalize.css"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/css/main.css?v=surface-scroll-20260711"}],"\n    ","\n    ",["LINK",{"rel":"stylesheet","href":"/css/portfolio.css?v=portfolio-gate-20260712"}],"\n    ",["LINK",{"rel":"stylesheet","href":"/src/styles/base.css"}],"\n  ",["STYLE",{},"/* Dominant Tab utility material ------------------------------------------------\n   This opt-in layer is shared by the focused validation lab and study 11.\n   Production bars do not carry the data attribute and remain unchanged. */\n\n.button-bar[data-button-bar-material='dominant-tab'] {\n  /* Utility controls are deliberately subordinate to route controls: their\n     visible body is three quarters of the primary height, centred in the same\n     row so both groups share one optical axis. */\n  --dominant-primary-control-height: var(--shell-tab-height, 48px);\n  --dominant-secondary-control-height: calc(var(--dominant-primary-control-height) * 0.75);\n  --dominant-secondary-icon-size: calc(var(--dominant-secondary-control-height) * 0.5);\n  --dominant-utility-wall: var(\n    --playground-stage,\n    var(--dominant-wall, var(--button-bar-gasket-ground))\n  );\n  --dominant-utility-page: var(\n    --playground-page,\n    var(--dominant-page-bg, var(--dominant-utility-wall))\n  );\n  --dominant-utility-ink: var(\n    --playground-ink,\n    var(--dominant-page-ink, var(--button-bar-outer-ink))\n  );\n  --dominant-utility-muted: var(\n    --playground-key-ink,\n    var(--dominant-wall-ink, var(--button-bar-outer-ink-muted))\n  );\n  --dominant-utility-shadow: var(--dominant-press-shadow, rgba(var(--abs-rgb-black), 0.52));\n  --dominant-utility-light: var(--dominant-press-light, rgba(var(--abs-rgb-white), 0.42));\n  --dominant-sound-active: var(\n    --button-bar-accent-sound,\n    var(--button-bar-accent-home)\n  );\n  --dominant-sound-active-ink: var(\n    --button-bar-accent-sound-ink,\n    var(--button-bar-accent-home-ink, rgba(var(--abs-rgb-white), 1))\n  );\n  --dominant-utility-pressed-rim:\n    inset 0 2.5px 4.5px -1px var(--dominant-utility-shadow),\n    inset 0 -2.5px 2.5px -1px var(--dominant-utility-light);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[data-route-tab='home'] {\n  --dominant-active-color: var(--button-bar-accent-home, var(--ball-4, #00695c));\n  --dominant-active-ink: var(--button-bar-accent-home-ink, #ffffff);\n  --shell-tab-route-accent: var(--dominant-active-color);\n  --shell-tab-text-active: var(--dominant-active-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[data-route-tab='portfolio'] {\n  --dominant-active-color: var(--button-bar-accent-portfolio, var(--ball-6, #d7ff2f));\n  --dominant-active-ink: var(--button-bar-accent-portfolio-ink, #101113);\n  --shell-tab-route-accent: var(--dominant-active-color);\n  --shell-tab-text-active: var(--dominant-active-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[data-route-tab='about'] {\n  --dominant-active-color: var(--button-bar-accent-about, var(--ball-7, #0d5cb6));\n  --dominant-active-ink: var(--button-bar-accent-about-ink, #ffffff);\n  --shell-tab-route-accent: var(--dominant-active-color);\n  --shell-tab-text-active: var(--dominant-active-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[data-route-tab='contact'] {\n  --dominant-active-color: var(--button-bar-accent-contact, var(--ball-8, #ffa000));\n  --dominant-active-ink: var(--button-bar-accent-contact-ink, #101113);\n  --shell-tab-route-accent: var(--dominant-active-color);\n  --shell-tab-text-active: var(--dominant-active-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:is(:hover, :focus-visible, :active),\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page'],\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page']:is(:hover, :focus-visible, :active) {\n  --shell-tab-motion-y: 0px;\n  --shell-tab-motion-scale: 1;\n  border-width: 0;\n  border-radius: 16px;\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab {\n  color: var(--dominant-utility-muted);\n  font-weight: 560;\n  letter-spacing: normal;\n  background: transparent;\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):is(:hover, :focus-visible):not(:active) {\n  color: var(--dominant-utility-muted);\n  outline: none;\n  background: color-mix(in srgb, var(--dominant-utility-ink) 7%, transparent);\n  box-shadow: var(\n    --dominant-tab-pressed-rim,\n    var(--dominant-utility-pressed-rim)\n  );\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):active {\n  color: var(--dominant-utility-ink);\n  outline: none;\n  background: color-mix(in srgb, var(--dominant-utility-ink) 10%, transparent);\n  box-shadow: var(\n    --dominant-tab-pressed-rim,\n    var(--dominant-utility-pressed-rim)\n  );\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page'],\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page']:is(:hover, :focus-visible, :active) {\n  color: var(--dominant-active-ink);\n  cursor: default;\n  background: var(--dominant-active-color);\n  box-shadow: var(\n    --dominant-tab-pressed-rim,\n    var(--dominant-utility-pressed-rim)\n  );\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page']::before {\n  content: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab\n  :is(.shell-tab__icon, .shell-tab__label),\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:is(:hover, :focus-visible, :active)\n  :is(.shell-tab__icon, .shell-tab__label),\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab[aria-current='page']\n  :is(.shell-tab__icon, .shell-tab__label) {\n  color: currentColor;\n  font-weight: 560;\n  letter-spacing: normal;\n  filter: none;\n  text-shadow: none;\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:is(:active, [aria-current='page'])\n  :is(.shell-tab__icon, .shell-tab__label) {\n  transform: translate3d(0, calc(0px - var(--shell-tab-motion-y, 0px)), 0);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__secondary-buttons {\n  --shell-control-icon-size: var(--dominant-secondary-icon-size);\n  align-self: center;\n  align-items: center;\n  block-size: var(--dominant-primary-control-height);\n  min-height: var(--dominant-primary-control-height);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__secondary-button.shell-tab,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__secondary-button.shell-tab:is(:hover, :focus-visible, :active) {\n  --shell-tab-motion-y: 0px;\n  --shell-tab-motion-scale: 1;\n  border-width: 0;\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 0 var(--dominant-secondary-control-height);\n  inline-size: var(--dominant-secondary-control-height);\n  block-size: var(--dominant-secondary-control-height);\n  min-width: var(--dominant-secondary-control-height);\n  min-height: var(--dominant-secondary-control-height);\n  aspect-ratio: 1 / 1;\n  padding: 0;\n}\n\n/* Sound is quiet at rest and becomes a persistent palette signal when on. */\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab:not([data-enabled='true']),\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab:not([data-enabled='true']):not(:hover):not(:focus-visible):not(:active) {\n  color: var(--dominant-utility-muted);\n  background: transparent;\n  box-shadow: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab:not([data-enabled='true']):is(:hover, :focus-visible, :active) {\n  color: var(--dominant-utility-ink);\n  outline: none;\n  background: color-mix(in srgb, var(--dominant-utility-ink) 7%, transparent);\n  box-shadow: var(\n    --dominant-tab-pressed-rim,\n    var(--dominant-utility-pressed-rim)\n  );\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab[data-enabled='true'],\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab[data-enabled='true']:is(:hover, :focus-visible, :active) {\n  --shell-tab-text-active: var(--dominant-sound-active-ink);\n  color: var(--dominant-sound-active-ink);\n  outline: none;\n  background: var(--dominant-sound-active);\n  box-shadow: var(\n    --dominant-tab-pressed-rim,\n    var(--dominant-utility-pressed-rim)\n  );\n  transform: none;\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab\n  .button-bar__secondary-icon.shell-tab__icon,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle.shell-tab:is(:hover, :focus-visible, :active)\n  .button-bar__secondary-icon.shell-tab__icon {\n  display: inline-grid;\n  place-items: center;\n  inline-size: var(--dominant-secondary-icon-size);\n  block-size: var(--dominant-secondary-icon-size);\n  margin: 0;\n  color: currentColor;\n  font-size: var(--dominant-secondary-icon-size);\n  line-height: 1;\n  filter: none;\n  text-shadow: none;\n  transform: translate3d(0.08em, 0, 0);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__sound-toggle\n  .button-bar__secondary-icon::before {\n  display: block;\n  line-height: 1;\n}\n\n/* The switch is one fixed track with two mathematically symmetric endpoints. */\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle.shell-tab,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle.shell-tab:is(:hover, :focus-visible, :active) {\n  --button-bar-switch-height: var(--dominant-secondary-control-height);\n  --button-bar-switch-padding: 4px;\n  box-sizing: border-box;\n  flex: 0 0 calc(var(--dominant-secondary-control-height) * 10 / 7);\n  inline-size: calc(var(--dominant-secondary-control-height) * 10 / 7);\n  block-size: var(--dominant-secondary-control-height);\n  min-width: calc(var(--dominant-secondary-control-height) * 10 / 7);\n  min-height: var(--dominant-secondary-control-height);\n  color: var(--dominant-utility-muted);\n  border-width: 0;\n  border-radius: var(--button-bar-switch-radius);\n  outline: none;\n  outline-offset: 0;\n  background: color-mix(\n    in srgb,\n    var(--dominant-utility-ink) 8%,\n    var(--dominant-utility-wall) 92%\n  );\n  box-shadow: var(\n    --dominant-tab-pressed-rim,\n    var(--dominant-utility-pressed-rim)\n  );\n  transform: none;\n}\n\n/* Hover and keyboard focus can reveal material, but idle label ink does not\n   change until the button is physically pressed. */\n.button-bar.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):is(:hover, :focus-visible):not(:active),\n.button-bar.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):is(:hover, :focus-visible):not(:active)\n  :is(.shell-tab__icon, .shell-tab__label) {\n  color: var(--dominant-utility-muted);\n}\n\n.button-bar.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):active,\n.button-bar.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__primary-buttons\n  .shell-tab:not([aria-current='page']):active\n  :is(.shell-tab__icon, .shell-tab__label) {\n  color: var(--dominant-utility-ink);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle.shell-tab:is(:hover, :focus-visible, :active) {\n  background: color-mix(\n    in srgb,\n    var(--dominant-utility-ink) 10%,\n    var(--dominant-utility-wall) 90%\n  );\n  box-shadow: var(\n    --dominant-tab-pressed-rim,\n    var(--dominant-utility-pressed-rim)\n  );\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle[data-state='light']\n  .button-bar__theme-thumb {\n  inset-inline-start: var(--button-bar-switch-padding);\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle[data-state='dark']\n  .button-bar__theme-thumb {\n  inset-inline-start: calc(\n    100% - var(--button-bar-switch-padding) - var(--button-bar-switch-thumb-size)\n  );\n}\n\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle\n  .button-bar__theme-thumb,\n.button-bar[data-button-bar-material='dominant-tab']\n  .button-bar__theme-toggle:is(:hover, :focus-visible, :active)\n  .button-bar__theme-thumb {\n  position: absolute;\n  color: var(--dominant-utility-page);\n  border-radius: var(--button-bar-switch-thumb-radius);\n  background: var(--dominant-utility-ink);\n  box-shadow: none;\n  filter: none;\n  text-shadow: none;\n  transform: translate3d(0, -50%, 0);\n  transition:\n    inset-inline-start 160ms var(--shell-tab-motion-ease),\n    background 160ms var(--shell-tab-motion-ease),\n    color 160ms var(--shell-tab-motion-ease);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .button-bar[data-button-bar-material='dominant-tab']\n    .button-bar__theme-toggle\n    .button-bar__theme-thumb {\n    transition: none;\n  }\n}\n"],["STYLE",{},".contact-route {\n  isolation: isolate;\n  overflow: hidden;\n}\n\n#simulations .contact-ripple-stage {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  overflow: hidden;\n  pointer-events: none;\n  contain: strict;\n}\n\n#simulations .contact-ripple-canvas {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background: transparent;\n  pointer-events: none;\n}\n\n.contact-route__inner {\n  position: relative;\n  z-index: 1;\n}\n\n.contact-route .route-centered-page__description {\n  max-width: 50.4ch;\n  line-height: 1.485;\n  text-wrap: balance;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  #simulations .contact-ripple-canvas {\n    transform: none;\n  }\n}\n"],["STYLE",{},"html.simulation-dashboard-document {\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: auto;\n  width: 100%;\n  height: auto;\n  min-height: 100%;\n  background: #0c0d0e;\n  cursor: auto;\n}\n\nhtml.simulation-dashboard-document body.body.simulation-dashboard-page,\nhtml.simulation-dashboard-document body.simulation-dashboard-page {\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: auto;\n  width: 100%;\n  height: auto;\n  min-height: 100dvh;\n  margin: 0;\n  padding: 0;\n  background: #0c0d0e;\n  color: #f4f1ea;\n  cursor: auto;\n  user-select: text;\n  touch-action: auto;\n}\n\nhtml.simulation-dashboard-document #root {\n  width: 100%;\n  height: auto;\n  min-height: 100dvh;\n  background: #0c0d0e;\n}\n\n.simulation-dashboard,\n.simulation-dashboard *,\n.simulation-dashboard *::before,\n.simulation-dashboard *::after {\n  box-sizing: border-box;\n}\n\n.simulation-dashboard {\n  --dashboard-bg: #0c0d0e;\n  --dashboard-panel: #151719;\n  --dashboard-panel-strong: #1c2023;\n  --dashboard-panel-soft: #101214;\n  --dashboard-line: rgba(244, 241, 234, 0.12);\n  --dashboard-line-strong: rgba(244, 241, 234, 0.2);\n  --dashboard-text: #f4f1ea;\n  --dashboard-muted: rgba(244, 241, 234, 0.68);\n  --dashboard-faint: rgba(244, 241, 234, 0.44);\n  --dashboard-green: #72ce82;\n  --dashboard-blue: #8cafee;\n  --dashboard-amber: #e3b866;\n  --dashboard-red: #ed7b73;\n  --dashboard-radius: 8px;\n  --dashboard-radius-sm: 6px;\n  --dashboard-font-sans: \"Geist\", ui-sans-serif, system-ui, sans-serif;\n  --dashboard-font-mono: \"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace;\n  display: grid;\n  align-content: start;\n  gap: 14px;\n  width: min(100%, 1480px);\n  min-height: 100dvh;\n  margin: 0 auto;\n  padding: 18px;\n  background: var(--dashboard-bg);\n  color: var(--dashboard-text);\n  font-family: var(--dashboard-font-sans);\n  font-size: 14px;\n  line-height: 1.4;\n  letter-spacing: 0;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: geometricPrecision;\n}\n\n.simulation-dashboard :focus-visible {\n  outline: 2px solid rgba(244, 241, 234, 0.72);\n  outline-offset: 2px;\n}\n\n.simulation-dashboard a {\n  color: inherit;\n  text-decoration: none;\n}\n\n.simulation-dashboard button,\n.simulation-dashboard input,\n.simulation-dashboard textarea,\n.simulation-dashboard select {\n  font: inherit;\n  letter-spacing: 0;\n}\n\n.simulation-dashboard button {\n  cursor: pointer;\n}\n\n.simulation-dashboard svg {\n  flex: 0 0 auto;\n}\n\n.simulation-dashboard [data-tooltip] {\n  position: relative;\n}\n\n.simulation-dashboard [data-tooltip]::after {\n  position: absolute;\n  left: 50%;\n  bottom: calc(100% + 8px);\n  z-index: 100;\n  width: max-content;\n  max-width: min(15rem, calc(100vw - 24px));\n  border: 1px solid var(--dashboard-line-strong);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 7px 9px;\n  background: #f4f1ea;\n  color: #111315;\n  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.32);\n  content: attr(data-tooltip);\n  font-family: var(--dashboard-font-sans);\n  font-size: 0.72rem;\n  font-weight: 700;\n  line-height: 1.18;\n  opacity: 0;\n  pointer-events: none;\n  text-align: center;\n  transform: translateX(-50%) translateY(3px);\n  transition:\n    opacity 120ms ease,\n    transform 120ms ease;\n  white-space: normal;\n  overflow-wrap: anywhere;\n}\n\n.simulation-dashboard [data-tooltip]:hover::after,\n.simulation-dashboard [data-tooltip]:focus-visible::after {\n  opacity: 1;\n  transform: translateX(-50%) translateY(0);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--below::after {\n  top: calc(100% + 8px);\n  bottom: auto;\n  transform: translateX(-50%) translateY(-3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--below:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below:focus-visible::after {\n  transform: translateX(-50%) translateY(0);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--above-start::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-start::after {\n  left: 0;\n  right: auto;\n  text-align: left;\n  transform: translateY(3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--below-start::after {\n  top: calc(100% + 8px);\n  bottom: auto;\n  transform: translateY(-3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--above-end::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-end::after {\n  left: auto;\n  right: 0;\n  text-align: right;\n  transform: translateY(3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--below-end::after {\n  top: calc(100% + 8px);\n  bottom: auto;\n  transform: translateY(-3px);\n}\n\n.simulation-dashboard .simulation-dashboard-tooltip--above-start:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--above-start:focus-visible::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-start:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-start:focus-visible::after,\n.simulation-dashboard .simulation-dashboard-tooltip--above-end:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--above-end:focus-visible::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-end:hover::after,\n.simulation-dashboard .simulation-dashboard-tooltip--below-end:focus-visible::after {\n  transform: translateY(0);\n}\n\n.simulation-dashboard-header {\n  position: sticky;\n  top: 0;\n  z-index: 30;\n  display: grid;\n  grid-template-columns: minmax(18rem, 1fr) auto auto;\n  align-items: center;\n  gap: 16px;\n  border-bottom: 1px solid var(--dashboard-line);\n  padding: 0 0 14px;\n  background: rgba(12, 13, 14, 0.94);\n  backdrop-filter: blur(18px);\n}\n\n.simulation-dashboard-header__title {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 0;\n}\n\n.simulation-dashboard-header__title h1 {\n  margin: 0;\n  color: var(--dashboard-text);\n  font-size: 1.05rem;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.simulation-dashboard-header__title > span,\n.simulation-dashboard-modal__eyebrow {\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 3px 7px;\n  color: var(--dashboard-muted);\n  background: rgba(244, 241, 234, 0.045);\n  font-size: 0.68rem;\n  font-weight: 700;\n  line-height: 1;\n  text-transform: uppercase;\n}\n\n.simulation-dashboard-modal__eyebrow.is-blocked {\n  border-color: rgba(255, 120, 110, 0.34);\n  color: #ffc9c4;\n  background: rgba(255, 120, 110, 0.12);\n}\n\n.simulation-dashboard-header__title p,\n.simulation-dashboard-header__status,\n.simulation-dashboard-summary__item span,\n.simulation-dashboard-summary__item p,\n.simulation-dashboard-list-panel__bar span,\n.simulation-dashboard-list-row__title span,\n.simulation-dashboard-list-row__meta,\n.simulation-dashboard-detail-row dt,\n.simulation-dashboard-section h3,\n.simulation-dashboard-modal__header p,\n.simulation-dashboard-modal label span,\n.simulation-dashboard-delete-modal__plan span {\n  margin: 0;\n  color: var(--dashboard-muted);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.72rem;\n  line-height: 1.25;\n}\n\n.simulation-dashboard-header__status {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  white-space: nowrap;\n}\n\n.simulation-dashboard-header__status svg {\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-header__actions,\n.simulation-dashboard-expanded__links,\n.simulation-dashboard-modal__actions,\n.simulation-dashboard-modal__actions > div {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.simulation-dashboard-button,\n.simulation-dashboard-icon-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 34px;\n  border: 1px solid var(--dashboard-line-strong);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 8px 12px;\n  background: var(--dashboard-panel-soft);\n  color: var(--dashboard-text);\n  font-size: 0.82rem;\n  font-weight: 700;\n  line-height: 1;\n  transition:\n    border-color 120ms ease,\n    background-color 120ms ease,\n    color 120ms ease,\n    transform 120ms ease;\n}\n\n.simulation-dashboard-button:hover,\n.simulation-dashboard-button:focus-visible,\n.simulation-dashboard-icon-button:hover,\n.simulation-dashboard-icon-button:focus-visible {\n  border-color: rgba(244, 241, 234, 0.36);\n  background: color-mix(in srgb, var(--dashboard-panel-soft) calc(100% - var(--abs-button-hover-darken-mix, 10%)), #000 var(--abs-button-hover-darken-mix, 10%));\n  transform: none;\n}\n\n.simulation-dashboard-button:disabled,\n.simulation-dashboard-icon-button:disabled {\n  cursor: not-allowed;\n  opacity: 0.48;\n  transform: none;\n}\n\n.simulation-dashboard-button.is-active {\n  border-color: rgba(105, 215, 124, 0.48);\n  color: var(--dashboard-green);\n  background: rgba(105, 215, 124, 0.12);\n}\n\n.simulation-dashboard-button--primary {\n  border-color: rgba(121, 170, 247, 0.56);\n  background: rgba(121, 170, 247, 0.18);\n}\n\n.simulation-dashboard-button--promote {\n  border-color: rgba(105, 215, 124, 0.48);\n  background: rgba(105, 215, 124, 0.16);\n}\n\n.simulation-dashboard-button--danger {\n  border-color: rgba(255, 120, 110, 0.44);\n  color: #ffc9c4;\n  background: rgba(255, 120, 110, 0.1);\n}\n\n.simulation-dashboard-icon-button {\n  width: 34px;\n  min-width: 34px;\n  padding: 0;\n}\n\n.simulation-dashboard-summary {\n  display: grid;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  background: var(--dashboard-panel);\n  overflow: hidden;\n}\n\n.simulation-dashboard-summary__item {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 2px 8px;\n  align-items: baseline;\n  min-width: 0;\n  border-right: 1px solid var(--dashboard-line);\n  padding: 8px 11px;\n}\n\n.simulation-dashboard-summary__item:last-child {\n  border-right: 0;\n}\n\n.simulation-dashboard-summary__item strong {\n  grid-column: 1;\n  grid-row: 1 / span 2;\n  color: var(--dashboard-text);\n  font-size: 1rem;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.simulation-dashboard-summary__item p {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.simulation-dashboard-inline-notice svg.is-spinning,\n.simulation-dashboard-header__status svg.is-spinning {\n  animation: simulation-dashboard-spin 900ms linear infinite;\n}\n\n@keyframes simulation-dashboard-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.simulation-dashboard-toolbar {\n  display: grid;\n  grid-template-columns: minmax(18rem, 0.34fr) minmax(0, 1fr);\n  gap: 10px;\n  align-items: start;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  padding: 10px;\n  background: var(--dashboard-panel);\n}\n\n.simulation-dashboard-search {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 36px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 0 10px;\n  background: #0c0d0e;\n}\n\n.simulation-dashboard-search svg {\n  color: var(--dashboard-faint);\n}\n\n.simulation-dashboard-search label {\n  flex: 1;\n  min-width: 0;\n}\n\n.simulation-dashboard-search input {\n  width: 100%;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-search input::placeholder {\n  color: var(--dashboard-faint);\n}\n\n.simulation-dashboard-filter-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.simulation-dashboard-filter-list button {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 34px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 7px 9px;\n  background: transparent;\n  color: var(--dashboard-muted);\n  font-size: 0.78rem;\n  font-weight: 700;\n}\n\n.simulation-dashboard-filter-list button.is-active {\n  border-color: var(--dashboard-line-strong);\n  background: var(--dashboard-panel-strong);\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-filter-list button:hover {\n  border-color: var(--dashboard-line-strong);\n  background: rgba(0, 0, 0, 0.1);\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-filter-list button strong {\n  color: var(--dashboard-faint);\n  font-size: 0.74rem;\n}\n\n.simulation-dashboard-list-panel {\n  min-width: 0;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  background: var(--dashboard-panel);\n}\n\n.simulation-dashboard-list-panel__bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  min-height: 46px;\n  border-bottom: 1px solid var(--dashboard-line);\n  padding: 0 14px;\n}\n\n.simulation-dashboard-list-panel__bar strong {\n  display: block;\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-inline-notice {\n  display: grid;\n  grid-template-columns: 16px minmax(0, 1fr);\n  gap: 8px;\n  align-items: start;\n  min-width: 0;\n  max-width: min(36rem, 54vw);\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 7px 9px;\n  background: rgba(244, 241, 234, 0.035);\n}\n\n.simulation-dashboard-inline-notice svg {\n  margin-top: 1px;\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-inline-notice strong,\n.simulation-dashboard-inline-notice span {\n  display: block;\n  overflow-wrap: anywhere;\n}\n\n.simulation-dashboard-inline-notice strong {\n  color: var(--dashboard-text);\n  font-size: 0.76rem;\n  line-height: 1.2;\n}\n\n.simulation-dashboard-inline-notice span {\n  color: var(--dashboard-muted);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.68rem;\n  line-height: 1.25;\n  white-space: pre-wrap;\n}\n\n.simulation-dashboard-list {\n  display: grid;\n}\n\n.simulation-dashboard-list-item {\n  border-bottom: 1px solid var(--dashboard-line);\n  background: transparent;\n  transition:\n    background-color 120ms ease,\n    box-shadow 120ms ease;\n}\n\n.simulation-dashboard-list-item:last-child {\n  border-bottom: 0;\n}\n\n.simulation-dashboard-list-item.is-expanded {\n  background: rgba(244, 241, 234, 0.028);\n  box-shadow: inset 3px 0 0 rgba(244, 241, 234, 0.32);\n}\n\n.simulation-dashboard-list-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  align-items: center;\n  padding: 11px 12px;\n}\n\n.simulation-dashboard-list-row__main {\n  display: grid;