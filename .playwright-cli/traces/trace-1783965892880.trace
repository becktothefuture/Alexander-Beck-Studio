shboard-list-row__status {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  min-width: 0;\n}\n\n.simulation-dashboard-list-row__meta {\n  display: grid;\n  gap: 3px;\n}\n\n.simulation-dashboard-row-actions {\n  display: inline-flex;\n  gap: 6px;\n}\n\n.simulation-dashboard-thumb {\n  position: relative;\n  display: block;\n  width: 74px;\n  aspect-ratio: 16 / 9;\n  overflow: hidden;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  background: #0b0c0c;\n}\n\n.simulation-dashboard-thumb--large {\n  width: 100%;\n}\n\n.simulation-dashboard-thumb img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.simulation-dashboard-thumb > span {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background:\n    radial-gradient(circle at 32% 42%, rgba(66, 200, 188, 0.7) 0 9%, transparent 9.4%),\n    radial-gradient(circle at 58% 52%, rgba(240, 186, 86, 0.8) 0 7%, transparent 7.4%),\n    #101112;\n}\n\n.simulation-dashboard-thumb em {\n  position: absolute;\n  left: 5px;\n  bottom: 5px;\n  border-radius: 3px;\n  padding: 2px 4px;\n  background: rgba(0, 0, 0, 0.7);\n  color: var(--dashboard-text);\n  font-size: 0.62rem;\n  font-style: normal;\n  line-height: 1;\n}\n\n.simulation-dashboard-pill {\n  display: inline-flex;\n  align-items: center;\n  min-height: 22px;\n  max-width: 100%;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius-sm);\n  padding: 3px 7px;\n  color: var(--dashboard-muted);\n  background: transparent;\n  font-size: 0.7rem;\n  line-height: 1.1;\n  text-transform: capitalize;\n}\n\n.simulation-dashboard-pill--hidden,\n.simulation-dashboard-pill--disabled,\n.simulation-dashboard-pill--internal,\n.simulation-dashboard-pill--unknown {\n  color: var(--dashboard-faint);\n}\n\n.simulation-dashboard-expanded {\n  display: grid;\n  grid-template-columns: minmax(14rem, 0.82fr) minmax(20rem, 1.3fr) minmax(16rem, 0.78fr);\n  gap: 16px;\n  border-top: 1px solid var(--dashboard-line);\n  padding: 16px;\n}\n\n.simulation-dashboard-expanded__preview,\n.simulation-dashboard-expanded__main,\n.simulation-dashboard-expanded__controls {\n  min-width: 0;\n}\n\n.simulation-dashboard-expanded__links {\n  flex-wrap: wrap;\n  margin-top: 10px;\n}\n\n.simulation-dashboard-section {\n  display: grid;\n  gap: 10px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  padding: 12px;\n  background: rgba(12, 13, 14, 0.36);\n}\n\n.simulation-dashboard-section + .simulation-dashboard-section {\n  margin-top: 12px;\n}\n\n.simulation-dashboard-section h3 {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  color: var(--dashboard-muted);\n  text-transform: uppercase;\n}\n\n.simulation-dashboard-section h3 span {\n  color: var(--dashboard-faint);\n  font-size: 0.68rem;\n  font-weight: 700;\n}\n\n.simulation-dashboard-section p {\n  margin: 0;\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-detail-list {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px 12px;\n  margin: 0;\n}\n\n.simulation-dashboard-detail-row {\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n}\n\n.simulation-dashboard-detail-row dd {\n  min-width: 0;\n  margin: 0;\n  overflow-wrap: anywhere;\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-blockers ul,\n.simulation-dashboard-delete-modal__block ul,\n.simulation-dashboard-delete-modal__plan ul {\n  display: grid;\n  gap: 7px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.simulation-dashboard-blockers li,\n.simulation-dashboard-delete-modal__block li {\n  color: var(--dashboard-amber);\n}\n\n.simulation-dashboard-issues ul,\n.simulation-dashboard-activity ol {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.simulation-dashboard-issues li {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  align-items: center;\n 