lete-modal__plan {\n  display: grid;\n  gap: 8px;\n  border: 1px solid var(--dashboard-line);\n  border-radius: var(--dashboard-radius);\n  padding: 12px;\n  background: rgba(12, 13, 14, 0.36);\n}\n\n.simulation-dashboard-delete-modal__plan h3 {\n  margin: 0;\n  color: var(--dashboard-muted);\n  font-family: var(--dashboard-font-mono);\n  font-size: 0.72rem;\n  text-transform: uppercase;\n}\n\n.simulation-dashboard-delete-modal__plan li {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n\n.simulation-dashboard-delete-modal__plan strong {\n  overflow-wrap: anywhere;\n  font-size: 0.82rem;\n}\n\n.simulation-dashboard-delete-modal__plan p {\n  margin: 0;\n  color: var(--dashboard-muted);\n}\n\n.simulation-dashboard-delete-modal__confirm strong {\n  color: var(--dashboard-text);\n}\n\n.simulation-dashboard-sr {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n@media (max-width: 92rem) {\n  .simulation-dashboard {\n    padding: 14px;\n  }\n\n  .simulation-dashboard-header,\n  .simulation-dashboard-toolbar {\n    grid-template-columns: 1fr;\n  }\n\n  .simulation-dashboard-header__actions {\n    flex-wrap: wrap;\n  }\n\n  .simulation-dashboard-expanded {\n    grid-template-columns: minmax(14rem, 0.75fr) minmax(0, 1fr);\n  }\n\n  .simulation-dashboard-expanded__controls {\n    display: grid;\n    grid-column: 1 / -1;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .simulation-dashboard-expanded__controls .simulation-dashboard-section {\n    margin-top: 0;\n  }\n}\n\n@media (max-width: 76rem) {\n  .simulation-dashboard-summary {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .simulation-dashboard-summary__item:nth-child(3n) {\n    border-right: 0;\n  }\n\n  .simulation-dashboard-list-row__main {\n    grid-template-columns: 86px minmax(0, 1fr) minmax(9rem, 0.6fr) minmax(5.25rem, auto);\n  }\n\n  .simulation-dashboard-list-row__meta {\n    display: none;\n  }\n\n  .simulation-dashboard-expanded,\n  .simulation-dashboard-expanded__controls {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 52rem) {\n  .simulation-dashboard {\n    padding: 10px;\n  }\n\n  .simulation-dashboard-header {\n    position: static;\n  }\n\n  .simulation-dashboard-header__title {\n    flex-wrap: wrap;\n  }\n\n  .simulation-dashboard-header__actions {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    width: 100%;\n  }\n\n  .simulation-dashboard-summary {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .simulation-dashboard-summary__item,\n  .simulation-dashboard-summary__item:nth-child(3n) {\n    border-right: 1px solid var(--dashboard-line);\n  }\n\n  .simulation-dashboard-summary__item:nth-child(2n) {\n    border-right: 0;\n  }\n\n  .simulation-dashboard-list-row {\n    grid-template-columns: 1fr;\n  }\n\n  .simulation-dashboard-list-row__main {\n    grid-template-columns: 74px minmax(0, 1fr) minmax(5.25rem, auto);\n    gap: 10px;\n  }\n\n  .simulation-dashboard-list-row__status {\n    grid-column: 2 / -1;\n  }\n\n  .simulation-dashboard-list-row__toggle {\n    padding-inline: 7px;\n  }\n\n  .simulation-dashboard-row-actions {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .simulation-dashboard-row-actions .simulation-dashboard-icon-button {\n    width: 100%;\n  }\n\n  .simulation-dashboard-detail-list,\n  .simulation-dashboard-review-actions > div {\n    grid-template-columns: 1fr;\n  }\n\n  .simulation-dashboard-modal {\n    padding: 10px;\n  }\n\n  .simulation-dashboard-modal__actions,\n  .simulation-dashboard-modal__actions > div {\n    flex-wrap: wrap;\n  }\n}\n\n@media (max-width: 36rem) {\n  .simulation-dashboard-list-panel__bar {\n    display: grid;\n    align-items: start;\n  }\n\n  .simulation-dashboard-inline-notice {\n    max-width: 100%;\n  }\n\n  .simulation-dashboard-list-row__main {\n    grid-template-columns: 68px minmax(0, 1fr);\n  }\n\n  .simulation-dashboard-list-row__status,\n  .simulation-dashboard-list-row__toggle {\n    grid-column: 2;\n    justify-self: start;\n  }\n\n  .simulation-dashboard-list-row__title strong {\n    white-space: normal;\n  }\n\n  .simulation-dashboard-activity li {\n    grid-template-columns: 1fr;\n  }\n}\n"],["STYLE",{},"html.loader-playground-document,\nbody.loader-playground-page,\nbody.loader-playground-page #root {\n  width: 100%;\n  height: 100%;\n  min-height: 100dvh;\n  margin: 0;\n  overflow: hidden;\n  background: #141517;\n  color: var(--text-primary, #eceff3);\n}\n\nbody.loader-playground-page {\n  font-family: var(--abs-font-sans);\n}\n\n.loader-playground {\n  --loader-playground-bg: #141517;\n  --loader-playground-cell: #191a1d;\n  --loader-playground-cell-active: #202328;\n  --loader-playground-border: #2d3036;\n  --loader-playground-text: #eceff3;\n  --loader-playground-muted: #8d939c;\n  --loader-playground-accent: #5db7ff;\n\n  display: grid;\n  grid-template-columns: minmax(0, 7fr) minmax(280px, 3fr);\n  width: 100%;\n  height: 100dvh;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--loader-playground-bg);\n  color: var(--loader-playground-text);\n}\n\n.loader-playground__grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  grid-template-rows: repeat(3, minmax(0, 1fr));\n  min-width: 0;\n  min-height: 0;\n  gap: 1px;\n  padding: 1px;\n  background: var(--loader-playground-border);\n}\n\n.loader-playground-card {\n  position: relative;\n  display: grid;\n  place-items: center;\n  min-width: 0;\n  min-height: 0;\n  border: 0;\n  border-radius: 0;\n  background: var(--loader-playground-cell);\n  color: inherit;\n  cursor: pointer;\n  font: inherit;\n  overflow: hidden;\n}\n\n.loader-playground-card:hover,\n.loader-playground-card:focus-visible,\n.loader-playground-card.is-selected {\n  background: var(--loader-playground-cell-active);\n}\n\n.loader-playground-card:focus-visible {\n  outline: 1px solid var(--loader-playground-accent);\n  outline-offset: -1px;\n}\n\n.loader-playground-card.is-selected::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border: 1px solid var(--loader-playground-accent);\n  pointer-events: none;\n}\n\n.loader-playground-card__meta {\n  position: absolute;\n  top: clamp(8px, 1.5vh, 14px);\n  left: clamp(8px, 1.5vw, 14px);\n  right: clamp(8px, 1.5vw, 14px);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  color: var(--loader-playground-muted);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0;\n  line-height: 1;\n  pointer-events: none;\n}\n\n.loader-playground-card__index {\n  flex: 0 0 auto;\n  color: var(--loader-playground-text);\n  font-family: var(--abs-font-mono);\n  font-size: 10px;\n}\n\n.loader-playground-card__label {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.loader-sample {\n  --loader-dot-size: 4.25px;\n\n  position: relative;\n  width: clamp(56px, 7vw, 92px);\n  height: clamp(56px, 7vw, 92px);\n  display: grid;\n  place-items: center;\n  pointer-events: none;\n}\n\n.loader-orbit,\n.loader-ring-plane,\n.loader-radius-plane,\n.loader-ring {\n  position: absolute;\n  inset: 0;\n  transform-origin: 50% 50%;\n}\n\n.loader-radius-plane {\n  transform: scale(1);\n}\n\n.loader-ring {\n  animation: loaderSpinFluidSweep var(--loader-duration) linear infinite;\n}\n\n.loader-dot {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  display: block;\n  width: var(--loader-dot-size);\n  height: var(--loader-dot-size);\n  transform:\n    translate(-50%, -50%)\n    rotate(var(--dot-angle))\n    translateY(var(--dot-radius-negative))\n    rotate(var(--dot-counter-angle));\n  transform-origin: 50% 50%;\n}\n\n.loader-dot-core {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  background: var(--dot-color);\n  opacity: 0.92;\n  animation: loaderColorCycle var(--loader-color-cycle) steps(1, end) infinite;\n  animation-delay: var(--dot-color-delay);\n  transform-origin: 50% 50%;\n}\n\n.loader-sample--color-fixed .loader-dot-core {\n  animation: none;\n  background: var(--dot-color);\n}\n\n.loader-sample--long-ease .loader-ring {\n  animation-name: loaderSpinLongEase;\n}\n\n.loader-sample--rubber-pull .loader-ring {\n  animation-name: loaderSpinRubberPull;\n}\n\n.loader-sample--spring-arc .loader-ring {\n  animation-name: loaderSpinSpringArc;\n}\n\n.loader-sample--rolling-wave .loader-ring {\n  animation-name: loaderSpinRollingWave;\n}\n\n.loader-sample--slipstream .loader-ring {\n  animation-name: loaderSpinSlipstream;\n}\n\n.loader-sample--elastic-loop .loader-ring {\n  animation-name: loaderSpinElasticLoop;\n}\n\n.loader-sample--buoyant-arc .loader-ring {\n  animation-name: loaderSpinBuoyantArc;\n}\n\n.loader-sample--braided-sweep .loader-ring {\n  animation-name: loaderSpinBraidedSweep;\n}\n\n.loader-sample--fixed-flow .loader-ring {\n  animation-name: loaderSpinFixedFlow;\n}\n\n.loader-sample--fixed-rubber .loader-ring {\n  animation-name: loaderSpinFixedRubber;\n}\n\n.loader-sample--fixed-drift .loader-ring {\n  animation-name: loaderSpinFixedDrift;\n}\n\n@keyframes loaderSpinFluidSweep {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.42, 0, 0.28, 1); }\n  18% { transform: rotate(56deg); animation-timing-function: cubic-bezier(0.25, 0, 0.22, 1); }\n  36% { transform: rotate(132deg); animation-timing-function: cubic-bezier(0.42, 0, 0.32, 1); }\n  58% { transform: rotate(210deg); animation-timing-function: cubic-bezier(0.2, 0, 0.2, 1); }\n  78% { transform: rotate(300deg); animation-timing-function: cubic-bezier(0.46, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinLongEase {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.5, 0, 0.32, 1); }\n  16% { transform: rotate(44deg); animation-timing-function: cubic-bezier(0.22, 0, 0.18, 1); }\n  34% { transform: rotate(116deg); animation-timing-function: cubic-bezier(0.45, 0, 0.3, 1); }\n  56% { transform: rotate(190deg); animation-timing-function: cubic-bezier(0.2, 0, 0.22, 1); }\n  76% { transform: rotate(286deg); animation-timing-function: cubic-bezier(0.48, 0, 0.38, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinRubberPull {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.12, 0, 0.18, 1); }\n  12% { transform: rotate(54deg); animation-timing-function: cubic-bezier(0.58, 0, 0.42, 1); }\n  24% { transform: rotate(88deg); animation-timing-function: cubic-bezier(0.16, 0, 0.16, 1); }\n  39% { transform: rotate(162deg); animation-timing-function: cubic-bezier(0.55, 0, 0.38, 1); }\n  55% { transform: rotate(208deg); animation-timing-function: cubic-bezier(0.16, 0, 0.18, 1); }\n  73% { transform: rotate(302deg); animation-timing-function: cubic-bezier(0.5, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinSpringArc {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.14, 0, 0.2, 1); }\n  14% { transform: rotate(66deg); animation-timing-function: cubic-bezier(0.5, 0, 0.42, 1); }\n  28% { transform: rotate(108deg); animation-timing-function: cubic-bezier(0.15, 0, 0.18, 1); }\n  44% { transform: rotate(190deg); animation-timing-function: cubic-bezier(0.52, 0, 0.38, 1); }\n  62% { transform: rotate(246deg); animation-timing-function: cubic-bezier(0.18, 0, 0.2, 1); }\n  81% { transform: rotate(326deg); animation-timing-function: cubic-bezier(0.46, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinRollingWave {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.44, 0, 0.28, 1); }\n  20% { transform: rotate(62deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  38% { transform: rotate(146deg); animation-timing-function: cubic-bezier(0.46, 0, 0.34, 1); }\n  55% { transform: rotate(202deg); animation-timing-function: cubic-bezier(0.18, 0, 0.2, 1); }\n  75% { transform: rotate(294deg); animation-timing-function: cubic-bezier(0.48, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinSlipstream {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.16, 0, 0.16, 1); }\n  10% { transform: rotate(46deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  26% { transform: rotate(122deg); animation-timing-function: cubic-bezier(0.56, 0, 0.38, 1); }\n  48% { transform: rotate(180deg); animation-timing-function: cubic-bezier(0.18, 0, 0.18, 1); }\n  68% { transform: rotate(272deg); animation-timing-function: cubic-bezier(0.48, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinElasticLoop {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.12, 0, 0.18, 1); }\n  11% { transform: rotate(58deg); animation-timing-function: cubic-bezier(0.58, 0, 0.44, 1); }\n  23% { transform: rotate(92deg); animation-timing-function: cubic-bezier(0.14, 0, 0.18, 1); }\n  36% { transform: rotate(160deg); animation-timing-function: cubic-bezier(0.52, 0, 0.38, 1); }\n  52% { transform: rotate(214deg); animation-timing-function: cubic-bezier(0.15, 0, 0.17, 1); }\n  69% { transform: rotate(300deg); animation-timing-function: cubic-bezier(0.52, 0, 0.38, 1); }\n  84% { transform: rotate(334deg); animation-timing-function: cubic-bezier(0.42, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinBuoyantArc {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.5, 0, 0.36, 1); }\n  17% { transform: rotate(48deg); animation-timing-function: cubic-bezier(0.18, 0, 0.18, 1); }\n  35% { transform: rotate(136deg); animation-timing-function: cubic-bezier(0.48, 0, 0.34, 1); }\n  53% { transform: rotate(196deg); animation-timing-function: cubic-bezier(0.22, 0, 0.2, 1); }\n  72% { transform: rotate(276deg); animation-timing-function: cubic-bezier(0.45, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinBraidedSweep {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.36, 0, 0.24, 1); }\n  15% { transform: rotate(52deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  31% { transform: rotate(124deg); animation-timing-function: cubic-bezier(0.44, 0, 0.32, 1); }\n  47% { transform: rotate(174deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  64% { transform: rotate(250deg); animation-timing-function: cubic-bezier(0.46, 0, 0.34, 1); }\n  82% { transform: rotate(314deg); animation-timing-function: cubic-bezier(0.44, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinFixedFlow {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.42, 0, 0.28, 1); }\n  18% { transform: rotate(60deg); animation-timing-function: cubic-bezier(0.24, 0, 0.2, 1); }\n  40% { transform: rotate(142deg); animation-timing-function: cubic-bezier(0.34, 0, 0.28, 1); }\n  60% { transform: rotate(230deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  82% { transform: rotate(310deg); animation-timing-function: cubic-bezier(0.46, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinFixedRubber {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.13, 0, 0.18, 1); }\n  13% { transform: rotate(62deg); animation-timing-function: cubic-bezier(0.56, 0, 0.42, 1); }\n  25% { transform: rotate(100deg); animation-timing-function: cubic-bezier(0.15, 0, 0.17, 1); }\n  42% { transform: rotate(188deg); animation-timing-function: cubic-bezier(0.52, 0, 0.38, 1); }\n  57% { transform: rotate(236deg); animation-timing-function: cubic-bezier(0.16, 0, 0.18, 1); }\n  74% { transform: rotate(322deg); animation-timing-function: cubic-bezier(0.48, 0, 0.36, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderSpinFixedDrift {\n  0% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.48, 0, 0.34, 1); }\n  22% { transform: rotate(64deg); animation-timing-function: cubic-bezier(0.22, 0, 0.2, 1); }\n  41% { transform: rotate(138deg); animation-timing-function: cubic-bezier(0.42, 0, 0.3, 1); }\n  61% { transform: rotate(224deg); animation-timing-function: cubic-bezier(0.2, 0, 0.18, 1); }\n  80% { transform: rotate(298deg); animation-timing-function: cubic-bezier(0.45, 0, 0.34, 1); }\n  100% { transform: rotate(360deg); }\n}\n\n@keyframes loaderColorCycle {\n  0%,\n  15.99%,\n  100% {\n    background: var(--ball-1, #b5b7b6);\n  }\n\n  16.66%,\n  32.99% {\n    background: var(--ball-4, #00695c);\n  }\n\n  33.33%,\n  49.99% {\n    background: var(--ball-2, #bbbdbd);\n  }\n\n  50%,\n  66.65% {\n    background: var(--ball-7, #0d5cb6);\n  }\n\n  66.66%,\n  83.32% {\n    background: var(--ball-8, #ffa000);\n  }\n\n  83.33%,\n  99.99% {\n    background: var(--ball-6, #d7ff2f);\n  }\n}\n\n.parameterizer-panel.loader-playground-panel {\n  --parameterizer-header-height: 28px;\n  --parameterizer-folder-height: 24px;\n  --parameterizer-row-height: 26px;\n  --parameterizer-panel-bg: #191a1d;\n  --parameterizer-header-bg: #111215;\n  --parameterizer-folder-bg: #222429;\n  --parameterizer-row-bg: #191a1d;\n  --parameterizer-row-hover: #202228;\n  --parameterizer-separator: #2d3036;\n  --parameterizer-text: #eceff3;\n  --parameterizer-muted: #8d939c;\n  --parameterizer-widget-bg: #2a2d33;\n  --parameterizer-accent: var(--loader-playground-accent);\n\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  height: 100dvh;\n  overflow: hidden;\n  border: 0;\n  border-left: 1px solid var(--parameterizer-separator);\n  border-radius: 0;\n  background: var(--parameterizer-panel-bg);\n  color: var(--parameterizer-text);\n  font-family: var(--abs-font-sans);\n  font-size: 11px;\n  line-height: 1.25;\n}\n\n.loader-playground-panel .parameterizer-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  min-height: var(--parameterizer-header-height);\n  padding-inline: 8px;\n  border-bottom: 1px solid var(--parameterizer-separator);\n  background: var(--parameterizer-header-bg);\n  font-weight: 600;\n}\n\n.loader-playground-panel__status {\n  color: var(--parameterizer-muted);\n  font-family: var(--abs-font-mono);\n  font-size: 10px;\n  font-weight: 500;\n}\n\n.loader-playground-panel__title {\n  display: inline-flex;\n  gap: 3px;\n  min-width: 0;\n  overflow: hidden;\n  white-space: nowrap;\n}\n\n.loader-playground-panel__active {\n  display: grid;\n  gap: 4px;\n  padding: 8px;\n  border-bottom: 1px solid var(--parameterizer-separator);\n  color: var(--parameterizer-text);\n}\n\n.loader-playground-panel__active span:first-child {\n  overflow: hidden;\n  font-weight: 600;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.loader-playground-panel__active span:last-child {\n  color: var(--parameterizer-muted);\n  font-size: 10px;\n  line-height: 1.35;\n}\n\n.loader-playground-panel .parameterizer-scroll {\n  overflow: auto;\n  min-height: 0;\n}\n\n.loader-playground-panel .parameterizer-folder {\n  border-bottom: 1px solid var(--parameterizer-separator);\n}\n\n.loader-playground-panel .parameterizer-folder-title {\n  display: flex;\n  align-items: center;\n  min-height: var(--parameterizer-folder-height);\n  padding-inline: 8px;\n  background: var(--parameterizer-folder-bg);\n  color: var(--parameterizer-text);\n  cursor: default;\n  font-weight: 600;\n  list-style: none;\n}\n\n.loader-playground-panel .parameterizer-folder-title::-webkit-details-marker {\n  display: none;\n}\n\n.loader-playground-panel .parameterizer-folder-title::before {\n  width: 12px;\n  color: var(--parameterizer-muted);\n  content: \"v\";\n  font-family: var(--abs-font-mono);\n  font-size: 9px;\n}\n\n.loader-playground-panel .parameterizer-folder:not([open]) .parameterizer-folder-title::before {\n  content: \">\";\n}\n\n.loader-playground-panel__rows {\n  padding-block: 2px;\n}\n\n.loader-playground-panel .parameterizer-row {\n  display: grid;\n  grid-template-columns: minmax(0, 34%) minmax(0, 1fr) 56px;\n  align-items: center;\n  min-height: var(--parameterizer-row-height);\n  padding-inline: 8px 6px;\n  gap: 6px;\n  background: var(--parameterizer-row-bg);\n}\n\n.loader-playground-panel .parameterizer-row:hover {\n  background: var(--parameterizer-row-hover);\n}\n\n.loader-playground-panel .parameterizer-label {\n  overflow: hidden;\n  color: var(--parameterizer-text);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.loader-playground-panel .parameterizer-control {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n}\n\n.loader-playground-panel .parameterizer-value {\n  overflow: hidden;\n  color: var(--parameterizer-muted);\n  font-family: var(--abs-font-mono);\n  font-size: 10px;\n  font-variant-numeric: tabular-nums;\n  text-align: right;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.loader-playground-panel input,\n.loader-playground-panel select,\n.loader-playground-panel button {\n  font: inherit;\n}\n\n.loader-playground-panel input[type='range'] {\n  width: 100%;\n  accent-color: var(--parameterizer-accent);\n}\n\n.loader-playground-panel select {\n  width: 100%;\n  min-width: 0;\n  height: 18px;\n  border: 1px solid var(--parameterizer-separator);\n  border-radius: 2px;\n  background: var(--parameterizer-widget-bg);\n  color: var(--parameterizer-text);\n}\n\n.loader-playground-panel .parameterizer-actions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 4px;\n  padding: 4px;\n  border-top: 1px solid var(--parameterizer-separator);\n  background: var(--parameterizer-header-bg);\n}\n\n.loader-playground-panel button {\n  min-height: 22px;\n  border: 1px solid var(--parameterizer-separator);\n  border-radius: 2px;\n  background: var(--parameterizer-widget-bg);\n  color: var(--parameterizer-text);\n  cursor: pointer;\n}\n\n.loader-playground-panel button:hover {\n  background: color-m