    {
      "id": "disciplines",
      "label": "Six connected disciplines",
      "type": "editorial",
      "layout": "disciplines",
      "extentWU": 3.5,
      "mobileExtentWU": 4.2,
      "text": {
        "blocks": [
          {
            "id": "disciplines-title",
            "kind": "highlight",
            "text": "Product and Experience Design give me the shape of the problem.",
            "emphasis": [
              {
                "text": "shape of the problem",
                "tone": "green"
              }
            ]
          },
          {
            "id": "disciplines-practice",
            "kind": "prose",
            "text": "Users, needs, behaviour and structure. Art Direction gives it a point of view. Motion & 3D add timing, space and feel. Creative Engineering and Parametric Systems turn the idea into something that can be tested, changed and made real."
          },
          {
            "id": "disciplines-ai",
            "kind": "prose",
            "text": "AI belongs here as a working material. It helps me explore options, build tools around the task and push a direction further without handing over judgement."
          },
          {
            "id": "disciplines-synthesis",
            "kind": "prose",
            "text": "The point is not breadth for its own sake. It is creating enough contact between strategy, design and implementation that the idea does not flatten as it moves through the project.",
            "worldInfluence": true
          }
        ]
      },
      "camera": {
        "keys": [
          {
